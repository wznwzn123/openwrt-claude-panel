// 能不能卸：不能的话说原因
function app_protect(n, x) {
	if (match(n, APP_CORE)) return '系统组件';
	if (n == 'cloudflared' && !stat(ETC + '/local') && (stat(ETC + '/tunnel_token') || stat(ETC + '/hub.conf'))) return '面板远程访问要用';
	if (x?.rom) return '固件自带';
