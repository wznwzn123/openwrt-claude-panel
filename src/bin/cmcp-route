#!/usr/bin/ucode
// 面板走直连还是走代理：自动选能打开、更快的那条（计划任务每 3 分钟一次）
// 起因：手机连着家里 Wi-Fi 打开面板时，流量会被 OpenClash 送进代理节点绕一圈；节点卡了或断了，面板就打不开。
// 做法：分别测「直连」和「代理」打开面板要多久——
//   · 代理打不开、直连能打开 → 马上改走直连（反过来也一样），记进断线记录
//   · 两条都能通 → 最近 3 次都明显更快、而且离上次换路线超过 1 小时，才换；只因为快慢换的不记进断线记录（免得刷屏）
// 切换只是刷新「拉黑名单」那个规则集，不重启 OpenClash、不断网。
// 用法：cmcp-route          检查一次，需要就切换
//       cmcp-route --init   只按现在的设置重新生成规则集（安装、换网址后用）
//       cmcp-route --status 看现在走哪条
// 测试用：CMCP_ROUTE_FAKE="直连毫秒,代理毫秒"（0 = 打不开）跳过真的测速；CMCP_ROUTE_ST 换状态文件；CMCP_ROUTE_DRY=1 只算不改、打印结果
'use strict';
import * as L from 'cmcp.lib';
import { readfile } from 'fs';

const ENV = (k) => getenv(k) ?? '';
const ST = ENV('CMCP_ROUTE_ST') || L.D + '/panel_route.json';
const DRY = ENV('CMCP_ROUTE_DRY') == '1', FAKE = ENV('CMCP_ROUTE_FAKE');
const NOW = +(ENV('CMCP_ROUTE_NOW') || 0) || time();
const KEEP = 3;          // 看最近几次
const GAP = 3600;        // 因为快慢换路线，两次之间至少隔多久（秒）
const PROVIDER = 'cmcp_blacklist';
const arg = ARGV[0];
const host = trim(readfile(L.D + '/hostname') ?? '');
let st = L.readj(ST, {});

if (arg == '--status') { print(sprintf('%J\n', st)); exit(0); }
if (!FAKE && (arg == '--init' || !host || match(host, /trycloudflare\.com$/))) {
	L.bl_ruleset_write();
	try { L.api('PUT', '/providers/rules/' + PROVIDER, null, 10); } catch (e) {}   // 规则集没启用时这一步什么也不做
	exit(0);
}
// 自动处理里关掉了「面板线路自动选择」：保持现在的走法，不再测、不再换
if (!FAKE && readfile(L.D + '/off.route') != null) exit(0);
// 还没启用「拉黑名单」规则集的路由器：只更新文件，等用户在面板里启用（启用要重启一次 OpenClash）
const ready = FAKE || index(readfile('/etc/openclash/custom/openclash_custom_rules.list') ?? '', '# [cmcp-blacklist]') >= 0;
if (!ready) { L.bl_ruleset_write(); exit(0); }

const url = 'https://' + host + '/panel/manifest.json';
function delay(px) {
	let best = 0;
	for (let i = 0; i < 2; i++) {
		let r = null;
		try { r = L.api('GET', '/proxies/' + L.enc(px) + '/delay?timeout=5000&url=' + L.enc(url), null, 8); } catch (e) {}
		let d = +(r?.json?.delay ?? 0);
		if (d > 0 && (!best || d < best)) best = d;
	}
	return best;
}
// 不走直连时，面板命中的是最后那条 MATCH 规则对应的策略组
function match_group() {
	let r = null;
	try { r = L.api('GET', '/rules', null, 6); } catch (e) {}
	let rs = r?.json?.rules ?? [];
	for (let i = length(rs) - 1; i >= 0; i--) if (lc(rs[i]?.type ?? '') == 'match') return rs[i].proxy;
	return null;
}
function apply_rules() { if (DRY) return; L.bl_ruleset_write(); try { L.api('PUT', '/providers/rules/' + PROVIDER, null, 10); } catch (e) {} }
const g = FAKE ? 'Proxy' : match_group();
if (!g || g == 'DIRECT') { if (st.direct) { st = { direct: false, at: NOW, why: '最后的规则本来就是直连' }; if (!DRY) L.writej(ST, st); apply_rules(); } exit(0); }
let d, p;
if (FAKE) { let f = split(FAKE, ','); d = +f[0]; p = +f[1]; }
else { d = delay('DIRECT'); p = delay(g); }
const prev = !!st.direct;
let hist = [ ...(type(st.hist) == 'array' ? st.hist : []), [d, p] ];
hist = slice(hist, -KEEP);
let want = prev, why = st.why ?? '', loud = false;
if (!p && d) { if (!prev) { want = true; why = '代理节点打不开面板'; loud = true; } }
else if (!d && p) { if (prev) { want = false; why = '直连打不开面板'; loud = true; } }
else if (d && p) {
	// 只因为快慢：最近 3 次都明显更快，而且离上次换路线超过 1 小时
	const steady = (f) => length(hist) == KEEP && length(filter(hist, (x) => x[0] > 0 && x[1] > 0 && f(x[0], x[1]))) == KEEP;
	const gap_ok = NOW - (st.switched ?? 0) >= GAP;
	if (!prev && gap_ok && steady((a, b) => a < b * 0.7)) { want = true; why = sprintf('直连一直更快（%dms，代理 %dms）', d, p); }
	else if (prev && gap_ok && steady((a, b) => b < a * 0.6)) { want = false; why = sprintf('代理一直更快（%dms，直连 %dms）', p, d); }
}
st = { direct: want, at: NOW, why, d, p, group: g, hist, switched: want != prev ? NOW : (st.switched ?? 0) };
if (DRY) { print(sprintf('%J\n', { direct: want, changed: want != prev, loud, why })); L.writej(ST, st); exit(0); }
L.writej(ST, st);
if (want != prev) {
	apply_rules();
	// 打不开才换的：记进断线记录（有用）；只因为快慢换的：不记，免得刷屏（现在走哪条、为什么：cmcp-route --status）
	if (loud) L.notify('info', 'route', want ? '面板改走直连' : '面板改回走代理', why, 'route');
}
