#!/usr/bin/ucode
// Claude 路由器连接器 (MCP over HTTP, CGI)
// 运行在 OpenWrt 自带的 ucode + uhttpd 上，无需安装额外运行环境。
'use strict';

import { readfile, writefile, popen, stat, stdin, rename, mkdir, open as fs_open } from 'fs';
import * as CL from 'cmcp.lib';

const VERSION = '2.2.0';
const CONF_PATH = getenv('CLAUDE_MCP_CONF') || '/etc/claude-mcp/config.json';
const ETC = replace(CONF_PATH, /\/[^\/]*$/, ''); // 一般是 /etc/claude-mcp（测试时可以换目录）
// 面板自带的小工具放在哪（测试时换成假的；CGI 环境变量只能由路由器自己设，网页请求改不了）
const SBIN = getenv('CMCP_SBIN') || '/usr/sbin', REBOOT = getenv('CMCP_REBOOT') || 'reboot';
const PROTOCOLS = ['2025-11-25', '2025-06-18', '2025-03-26', '2024-11-05'];
// 改设置前留的备份（/etc/claude-mcp/bak）：最多 40 份；加起来超过 4 MB（闪存剩不到 16 MB 时 1 MB）就从最旧的删，最新 5 份一定留着
const BAK_PRUNE = 'cd /etc/claude-mcp/bak 2>/dev/null && { ls -1t | sed -n "41,\\$p" | while read f; do rm -f "$f"; done; fr=$(df -k . 2>/dev/null | tail -n 1 | awk \'{print $(NF-2)}\'); cap=4096; [ "${fr:-99999}" -lt 16384 ] 2>/dev/null && cap=1024; n=0; t=0; ls -1t | while read f; do [ -f "$f" ] || continue; n=$((n+1)); t=$((t+($(wc -c < "$f")+1023)/1024)); [ $n -gt 5 ] && [ $t -gt $cap ] && rm -f "$f"; done; }';

/* ---------------- 基础工具 ---------------- */

function shq(s) {
	return "'" + replace('' + s, "'", "'\\''") + "'";
}

// 这次请求是谁（托管版按手机钥匙认）：在最前面声明，后面所有模块都能用；在 26-backup.uc 里赋值
let DEV_ID = null, DEV = null, ROLE = 'owner', PERMS = [];

function sh(cmd) {
	let p = popen('export PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH; ' + cmd + ' 2>&1', 'r');
	if (!p)
		return { code: -1, out: '' };
	let out = p.read('all') ?? '';
	let code = p.close();
	return { code, out };
}

function trim_nl(s) {
	return rtrim(s ?? '', '\r\n');
}

function urlenc(s) {
	let o = '';
	s = '' + s;
	for (let i = 0; i < length(s); i++) {
		let c = ord(s, i);
		if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
		    c == 45 || c == 46 || c == 95 || c == 126)
			o += chr(c);
		else
			o += sprintf('%%%02X', c);
	}
	return o;
}

function fmt_bytes(n) {
	n = +n || 0;
	if (n < 1024) return sprintf('%dB', n);
	if (n < 1048576) return sprintf('%.1fKB', n / 1024);
	if (n < 1073741824) return sprintf('%.1fMB', n / 1048576);
	return sprintf('%.2fGB', n / 1073741824);
}

function now_str() {
	let t = localtime();
	return sprintf('%04d%02d%02d-%02d%02d%02d', t.year, t.mon, t.mday, t.hour, t.min, t.sec);
}

let CONF = null;
let MODE = 'token', NEED_DEV = false; // MODE：token（登录密钥地址）或 ai（Claude 连接器地址）
function conf() {
	if (CONF)
		return CONF;
	let raw = readfile(CONF_PATH);
	CONF = (raw ? json(raw) : null) ?? {};
	CONF.uci = CONF.uci || 'uci';
	CONF.init_dir = CONF.init_dir || '/etc/init.d';
	CONF.custom_dir = CONF.custom_dir || '/etc/openclash/custom';
	CONF.openclash_log = CONF.openclash_log || '/tmp/openclash.log';
	return CONF;
}

function uci_get(key) {
	let r = sh(conf().uci + ' -q get ' + shq(key));
	return r.code == 0 ? trim_nl(r.out) : null;
}

/* ---------------- Clash / mihomo 控制接口 ---------------- */

let _ctlc = null;
function controller() {
	if (_ctlc) return _ctlc;
	let c = conf();
	let base = c.api_base, secret = c.api_secret;
	// OpenClash 或 Nikki（都是 mihomo 内核，接口一样）
	let k = (!base || secret == null) ? CL.clash_ctl() : null;
	if (!base) base = 'http://127.0.0.1:' + (k?.port ?? '9090');
	if (secret == null) secret = k?.secret ?? '';
	return (_ctlc = { base, secret });
}

function api(method, path, body, timeout) {
	let ctl = controller();
	let cmd = sprintf("curl -sS --noproxy '*' -m %d -X %s", timeout || 10, method);
	if (length(ctl.secret))
		cmd += ' -H ' + shq('Authorization: Bearer ' + ctl.secret);
	if (body != null)
		cmd += " -H 'Content-Type: application/json' --data-binary " + shq(sprintf('%J', body));
	cmd += " -w '\\n%{http_code}' " + shq(ctl.base + path);

	let r = sh(cmd);
	let out = r.out, pos = -1;
	for (let i = length(out) - 1; i >= 0; i--)
		if (ord(out, i) == 10) { pos = i; break; }

	let status = +(pos >= 0 ? substr(out, pos + 1) : out) || 0;
	let text = pos >= 0 ? substr(out, 0, pos) : '';

	if (r.code != 0 || status == 0)
		die(sprintf('无法连接 Clash 控制接口 %s（OpenClash 是否在运行？）%s', ctl.base, trim_nl(out)));

	let data = null;
	if (length(text))
		try { data = json(text); } catch (e) { data = text; }

	if (status >= 400)
		die(sprintf('Clash 接口返回 %d：%s', status,
			type(data) == 'object' ? (data.message ?? sprintf('%J', data)) : text));

	return data;
}

const GROUP_TYPES = { Selector: 1, URLTest: 1, Fallback: 1, LoadBalance: 1, Relay: 1, Smart: 1 };

function last_delay(p) {
	let h = p?.history;
	if (type(h) == 'array' && length(h))
		return h[length(h) - 1].delay;
	return null;
}

/* ---------------- 工具实现 ---------------- */

const T = {};

T.router_status = function() {
	let lines = [];
	let ver = null, cfg = null, conns = null;
	try { ver = api('GET', '/version'); } catch (e) { push(lines, 'Clash 内核：未运行或无法连接（' + e + '）'); }
	if (ver) {
		push(lines, sprintf('Clash 内核：运行中，版本 %s%s', ver.version ?? '?', ver.meta ? '（Meta）' : ''));
		try { cfg = api('GET', '/configs'); } catch (e) {}
		try { conns = api('GET', '/connections'); } catch (e) {}
	}
	if (cfg)
		push(lines, sprintf('代理模式：%s，混合端口：%s', cfg.mode ?? '?', cfg['mixed-port'] ?? '?'));
	if (conns)
		push(lines, sprintf('当前连接数：%d，累计下载 %s，上传 %s',
			length(conns.connections ?? []), fmt_bytes(conns.downloadTotal), fmt_bytes(conns.uploadTotal)));

	const keys = {
		'enable': 'OpenClash 开关',
		'config_path': '当前配置文件',
		'en_mode': '运行模式',
		'enable_custom_clash_rules': '自定义规则开关',
		'cn_port': '控制面板端口',
		'china_ip_route': '区域绕过(大陆)',
	};
	for (let k, label in keys) {
		let v = uci_get('openclash.config.' + k);
		if (v != null)
			push(lines, label + '：' + v);
	}

	let oaf = sh('pgrep -f oafd >/dev/null 2>&1 && echo yes || echo no');
	push(lines, 'OAF 应用过滤进程：' + (trim_nl(oaf.out) == 'yes' ? '运行中' : '未检测到'));
	return join('\n', lines);
};

T.list_proxy_groups = function(a) {
	let data = api('GET', '/proxies');
	let px = data?.proxies ?? {};

	if (a.group) {
		let g = px[a.group];
		if (!g) die('找不到策略组：' + a.group);
		let out = [sprintf('策略组 %s（%s），当前选择：%s', a.group, g.type, g.now ?? '-')];
		let kw = a.filter ? lc(a.filter) : null;
		for (let name in (g.all ?? [])) {
			if (kw && index(lc(name), kw) < 0) continue;
			let p = px[name] ?? {};
			let d = last_delay(p);
			push(out, sprintf('%s %s | %s | %s', name == g.now ? '▶' : '·', name, p.type ?? '?',
				d == null ? '未测' : (d == 0 ? '超时' : d + 'ms')));
		}
		return join('\n', out);
	}

	let out = ['策略组列表（名称 | 类型 | 当前选择 | 节点数）：'];
	for (let name, p in px) {
		if (!GROUP_TYPES[p.type] || name == 'GLOBAL') continue;
		push(out, sprintf('%s | %s | %s | %d', name, p.type, p.now ?? '-', length(p.all ?? [])));
	}
	return join('\n', out);
};

T.test_delay = function(a) {
	if (!a.name) die('缺少 name');
	let url = a.url || 'https://www.gstatic.com/generate_204';
	let tmo = +a.timeout || 5000;
	let q = sprintf('?url=%s&timeout=%d', urlenc(url), tmo);

	let px = api('GET', '/proxies')?.proxies ?? {};
	let p = px[a.name];
	if (!p) die('找不到节点或策略组：' + a.name);

	if (GROUP_TYPES[p.type]) {
		let res = api('GET', '/group/' + urlenc(a.name) + '/delay' + q, null, tmo / 1000 + 20);
		let rows = [];
		for (let n in (p.all ?? []))
			push(rows, { n, d: res?.[n] });
		rows = sort(rows, (x, y) => (x.d ?? 1e9) - (y.d ?? 1e9));
		let out = [sprintf('策略组 %s 测速结果（%s）：', a.name, url)];
		for (let r in rows)
			push(out, sprintf('%s：%s', r.n, r.d == null ? '超时/不可用' : r.d + 'ms'));
		return join('\n', out);
	}

	let res = null;
	try {
		res = api('GET', '/proxies/' + urlenc(a.name) + '/delay' + q, null, tmo / 1000 + 5);
	} catch (e) {
		return sprintf('%s：超时或不可用（%s）', a.name, e);
	}
	return sprintf('%s：%sms', a.name, res?.delay ?? '?');
};

/* 面板的域名（比如 router.example.com → example.com）：切节点时不断开访问面板的连接 */
function panel_domain() {
	let h = trim(readfile('/etc/claude-mcp/hostname') ?? '');
	let p = split(h, '.');
	return length(p) > 2 ? join('.', slice(p, 1)) : h;
}
T.switch_proxy = function(a) {
	if (!a.group || !a.node) die('需要 group 和 node');
	let px = api('GET', '/proxies')?.proxies ?? {};
	let g = px[a.group];
	if (!g) die('找不到策略组：' + a.group);
	if (g.type != 'Selector') die(sprintf('策略组 %s 是 %s 类型，只有 Selector 类型可以手动切换', a.group, g.type));
	if (index(g.all ?? [], a.node) < 0) die(sprintf('节点「%s」不在策略组 %s 中，请先用 list_proxy_groups 查看准确名称', a.node, a.group));

	let before = g.now;
	api('PUT', '/proxies/' + urlenc(a.group), { name: a.node });
	// 记下「刚手动换过」：节点自动切换 10 分钟内不把它换走（不然你刚选的节点一测不通就被换掉）
	writefile('/tmp/cmcp_autosw_manual', '' + time());
	let after = api('GET', '/proxies/' + urlenc(a.group))?.now;
	let msg = sprintf('已切换策略组 %s：%s → %s', a.group, before, after);
	if (a.close_connections) {
		// 只断开走这个策略组的连接；面板自己的连接保留，并且等回复送出去以后再断，
		// 否则手机收不到「切换成功」，还会以为连不上路由器
		let d = panel_domain(), ids = [];
		for (let c in (api('GET', '/connections')?.connections ?? [])) {
			let m = c.metadata ?? {}, h = lc(m.host || m.sniffHost || '');
			if (length(d) && (h == d || substr(h, -length(d) - 1) == '.' + d)) continue;
			if (index(c.chains ?? [], a.group) < 0) continue;
			push(ids, c.id);
		}
		if (length(ids)) {
			let ctl = controller();
			writefile('/tmp/cmcp_close_ids', join('\n', ids) + '\n');
			sh(sprintf("nohup sh -c 'sleep 1; while read id; do curl -s --noproxy \"*\" -m 3 -X DELETE -H %s %s/connections/$id >/dev/null 2>&1; done < /tmp/cmcp_close_ids; rm -f /tmp/cmcp_close_ids' >/dev/null 2>&1 </dev/null &",
				replace(shq('Authorization: Bearer ' + ctl.secret), "'", "'\\''"), ctl.base));
		}
		msg += sprintf('，并断开了走这个策略组的 %d 条旧连接（面板自己的连接保留）', length(ids));
	}
	return msg;
};

T.set_mode = function(a) {
	if (index(['rule', 'global', 'direct'], a.mode) < 0) die('mode 只能是 rule / global / direct');
	api('PATCH', '/configs', { mode: a.mode });
	return '代理模式已改为：' + a.mode + '（临时生效，OpenClash 重启后恢复配置中的模式）';
};

T.list_connections = function(a) {
	let data = api('GET', '/connections');
	let list = data?.connections ?? [];
	let kw = a.filter ? lc(a.filter) : null;
	let limit = +a.limit || 50;
	let rows = [];

	for (let c in list) {
		let m = c.metadata ?? {};
		let host = (m.host || m.sniffHost || m.destinationIP || '?') + ':' + (m.destinationPort ?? '');
		let chain = join(' ← ', c.chains ?? []);
		let rule = (c.rule ?? '') + (length(c.rulePayload ?? '') ? ':' + c.rulePayload : '');
		let line = sprintf('%s | %s | %s | %s | ↓%s ↑%s | 来自 %s | id=%s',
			host, m.network ?? '', rule, chain, fmt_bytes(c.download), fmt_bytes(c.upload),
			m.sourceIP ?? '?', c.id);
		if (kw && index(lc(line), kw) < 0) continue;
		push(rows, { dl: +c.download || 0, line });
	}

	rows = sort(rows, (x, y) => y.dl - x.dl);
	let out = [sprintf('活跃连接 %d 条%s，显示 %d 条（主机 | 协议 | 命中规则 | 代理链 | 流量 | 来源 | id）：',
		length(list), kw ? '（过滤后 ' + length(rows) + ' 条）' : '', length(rows) < limit ? length(rows) : limit)];
	for (let i = 0; i < length(rows) && i < limit; i++)
		push(out, rows[i].line);
	return join('\n', out);
};

T.close_connections = function(a) {
	if (a.id) {
		api('DELETE', '/connections/' + urlenc(a.id));
		return '已断开连接 ' + a.id;
	}
	api('DELETE', '/connections');
	return '已断开全部连接（相当于 OpenClash 的「关闭链接」）';
};

T.list_rules = function(a) {
	let rules = api('GET', '/rules')?.rules ?? [];
	let kw = a.filter ? lc(a.filter) : null;
	let limit = +a.limit || 60, offset = +a.offset || 0;
	let rows = [];
	for (let i = 0; i < length(rules); i++) {
		let r = rules[i];
		let line = sprintf('%d. %s,%s → %s', i + 1, r.type, r.payload, r.proxy);
		if (kw && index(lc(line), kw) < 0) continue;
		push(rows, line);
	}
	let out = [sprintf('生效规则共 %d 条%s：', length(rules), kw ? '，匹配 ' + length(rows) + ' 条' : '')];
	for (let i = offset; i < length(rows) && i < offset + limit; i++)
		push(out, rows[i]);
	if (length(rows) > offset + limit)
		push(out, sprintf('……还有 %d 条，可用 offset=%d 继续查看', length(rows) - offset - limit, offset + limit));
	return join('\n', out);
};

T.get_logs = function(a) {
	let lvl = a.level || 'info';
	if (index(['debug', 'info', 'warning', 'error'], lvl) < 0) lvl = 'info';
	let secs = +a.seconds || 3;
	if (secs < 1) secs = 1;
	if (secs > 15) secs = 15;

	let ctl = controller();
	let cmd = sprintf("curl -sS -N --noproxy '*' -m %d", secs);
	if (length(ctl.secret))
		cmd += ' -H ' + shq('Authorization: Bearer ' + ctl.secret);
	cmd += ' ' + shq(ctl.base + '/logs?level=' + lvl);
	let r = sh(cmd);

	let kw = a.filter ? lc(a.filter) : null;
	let out = [];
	for (let l in split(r.out, '\n')) {
		l = trim(l);
		if (!length(l) || substr(l, 0, 1) != '{') continue;
		let o = null;
		try { o = json(l); } catch (e) { continue; }
		let s = sprintf('[%s] %s', o.type, o.payload);
		if (kw && index(lc(s), kw) < 0) continue;
		push(out, s);
	}
	if (!length(out))
		return sprintf('采集了 %d 秒的实时日志（级别 %s），期间没有新日志。可以让用户先去操作对应 App，再调用一次。', secs, lvl);
	return sprintf('最近 %d 秒实时日志（%d 条）：\n', secs, length(out)) + join('\n', out);
};

function rules_path(n) {
	return conf().custom_dir + (+n == 2 ? '/openclash_custom_rules_2.list' : '/openclash_custom_rules.list');
}

T.get_custom_rules = function(a) {
	let p = rules_path(a.file);
	let txt = readfile(p);
	if (txt == null) die('读取失败：' + p);
	let en = uci_get('openclash.config.enable_custom_clash_rules');
	let lines = split(txt, '\n');
	let out = [];
	for (let i = 0; i < length(lines); i++) {
		if (a.hide_comments && match(lines[i], /^\s*#/)) continue;
		push(out, sprintf('%3d| %s', i + 1, lines[i]));
	}
	return sprintf('文件：%s（%s）\n自定义规则开关：%s\n', p,
		+a.file == 2 ? '候补匹配，排在原有规则之后' : '优先匹配，排在原有规则之前',
		en == '1' ? '已开启' : '未开启') + join('\n', out);
};

function restart_openclash_bg() {
	sh(sprintf("nohup sh -c 'sleep 2; %s/openclash restart' >/dev/null 2>&1 </dev/null &", conf().init_dir));
}

T.set_custom_rules = function(a) {
	if (type(a.content) != 'string') die('content 必须是完整的文件内容（字符串）');
	let content = a.content;
	if (!match(content, /(^|\n)rules:[ \t]*(\n|$)/))
		die('内容里缺少顶格的「rules:」行。请保留文件原有的「rules:」行，规则写在它下面，每行以「- 」开头。');

	// 检查规则行：rules: 之后、非注释、非空行必须以 "- " 开头
	let lines = split(content, '\n'), in_rules = false, bad = [];
	for (let i = 0; i < length(lines); i++) {
		let l = lines[i];
		if (match(l, /^rules:[ \t]*$/)) { in_rules = true; continue; }
		if (match(l, /^[A-Za-z-]+:/)) { in_rules = false; continue; }
		if (!in_rules || match(l, /^\s*(#|$)/)) continue;
		if (!match(l, /^- [A-Z-]+,/))
			push(bad, sprintf('第 %d 行：%s', i + 1, l));
		else if (match(l, /，/))
			push(bad, sprintf('第 %d 行含全角逗号：%s', i + 1, l));
	}
	if (length(bad) && !a.force)
		die('以下规则行格式可疑（应顶格以「- 类型,」开头、使用半角逗号）。确认无误可传 force=true：\n' + join('\n', bad));

	// 检查节点/策略组名是否存在（Clash 在运行时才检查）
	let missing = [];
	try {
		let px = api('GET', '/proxies')?.proxies ?? {};
		const builtin = { DIRECT: 1, REJECT: 1, 'REJECT-DROP': 1, PASS: 1, COMPATIBLE: 1 };
		in_rules = false;
		for (let l in lines) {
			if (match(l, /^rules:[ \t]*$/)) { in_rules = true; continue; }
			if (match(l, /^[A-Za-z-]+:/)) { in_rules = false; continue; }
			if (!in_rules || !match(l, /^- /)) continue;
			let parts = split(replace(substr(l, 2), /\s+#.*$/, ''), ',');
			let target = null;
			for (let j = length(parts) - 1; j >= 1; j--) {
				let t = trim(parts[j]);
				if (t == 'no-resolve' || t == 'src') continue;
				target = t; break;
			}
			if (target && !builtin[target] && !px[target] && index(missing, target) < 0)
				push(missing, target);
		}
	} catch (e) {}
	if (length(missing) && !a.force)
		die('这些目标在当前配置里不存在（OpenClash 会跳过对应规则）：\n' + join('\n', missing) +
			'\n请用 list_proxy_groups 查看准确的节点名后修改；确认无误可传 force=true。');

	let p = rules_path(a.file);
	let old = readfile(p);
	if (old != null)
		writefile(p + '.bak', old);
	if (!writefile(p + '.tmp', content) || !rename(p + '.tmp', p))
		die('写入失败：' + p);

	let msg = '已保存 ' + p + (old != null ? '（旧版本备份为 .bak，可用 restore_custom_rules 还原）' : '');
	if (a.enable !== false && uci_get('openclash.config.enable_custom_clash_rules') != '1') {
		sh(conf().uci + ' set openclash.config.enable_custom_clash_rules=1 && ' + conf().uci + ' commit openclash');
		msg += '，并已打开「自定义规则」开关';
	}
	if (a.apply !== false) {
		restart_openclash_bg();
		msg += '。OpenClash 正在后台重启（约 10–30 秒，期间网络会短暂中断），之后用 list_rules 确认规则已生效';
	} else
		msg += '。尚未生效，需调用 restart_openclash';
	return msg;
};

T.restore_custom_rules = function(a) {
	let p = rules_path(a.file);
	let bak = readfile(p + '.bak');
	if (bak == null) die('没有找到备份：' + p + '.bak');
	let cur = readfile(p);
	writefile(p, bak);
	if (cur != null) writefile(p + '.bak', cur);
	if (a.apply !== false) restart_openclash_bg();
	return '已从备份还原 ' + p + (a.apply !== false ? '，OpenClash 正在后台重启' : '');
};

T.restart_openclash = function() {
	restart_openclash_bg();
	return 'OpenClash 正在后台重启（约 10–30 秒，期间网络会短暂中断）。稍后用 router_status 或 openclash_log 查看结果。';
};

T.openclash_log = function(a) {
	let n = +a.lines || 60;
	if (n > 400) n = 400;
	let r = sh(sprintf('tail -n %d %s', n, shq(conf().openclash_log)));
	let out = r.out;
	if (a.filter) {
		let kw = lc(a.filter), keep = [];
		for (let l in split(out, '\n'))
			if (index(lc(l), kw) >= 0) push(keep, l);
		out = join('\n', keep);
	}
	return length(trim(out)) ? out : '（日志为空）';
};

/* ---------------- OAF 应用过滤 ---------------- */

T.oaf_show = function(a) {
	let out = [];
	let r = sh(conf().uci + ' show appfilter');
	push(out, '== uci show appfilter ==');
	push(out, r.code == 0 ? trim_nl(r.out) : '（读取失败，OAF 可能未安装）');
	for (let f in ['/proc/net/af_client', '/tmp/af_client.list']) {
		let t = readfile(f);
		if (t != null) {
			push(out, '== ' + f + ' ==');
			push(out, trim_nl(t));
		}
	}
	return join('\n', out);
};

T.oaf_find_app = function(a) {
	if (!a.keyword) die('缺少 keyword');
	let kw = lc(a.keyword), out = [], cls = '';
	for (let f in (conf().feature_file ? [conf().feature_file] : ['/tmp/feature.cfg', '/etc/appfilter/feature.cfg', '/usr/share/appfilter/feature.cfg'])) {
		let t = readfile(f);
		if (t == null) continue;
		for (let l in split(t, '\n')) {
			let m = match(l, /^#class\s+(\S+)\s+(.*)$/);
			if (m) { cls = m[1] + ' ' + m[2]; continue; }
			let m2 = match(l, /^(\d+)\s+([^:]+):/);
			if (m2 && index(lc(m2[2]), kw) >= 0)
				push(out, sprintf('应用ID %s | %s | 分类 %s', m2[1], m2[2], cls));
		}
		return length(out) ? '特征库 ' + f + '：\n' + join('\n', out) : '特征库里没有找到包含「' + a.keyword + '」的应用';
	}
	die('没有找到 OAF 特征库文件');
};

T.oaf_uci = function(a) {
	let ops = a.operations;
	if (type(ops) != 'array' || !length(ops)) die('operations 必须是非空数组');
	let U = conf().uci, log = [];
	for (let op in ops) {
		let k = op.key ?? '';
		if (op.op != 'add' && !match(k, /^appfilter(\.(@[A-Za-z0-9_]+\[-?[0-9]+\]|[A-Za-z0-9_-]+)){1,2}$/))
			die('只允许修改 appfilter 配置，非法 key：' + k);
		let cmd;
		switch (op.op) {
		case 'set':      cmd = sprintf('%s set %s', U, shq(k + '=' + (op.value ?? ''))); break;
		case 'add_list': cmd = sprintf('%s add_list %s', U, shq(k + '=' + (op.value ?? ''))); break;
		case 'del_list': cmd = sprintf('%s del_list %s', U, shq(k + '=' + (op.value ?? ''))); break;
		case 'delete':   cmd = sprintf('%s delete %s', U, shq(k)); break;
		case 'add':
			if (!match(op.value ?? '', /^[A-Za-z0-9_]+$/)) die('add 需要 value=节类型');
			cmd = sprintf('%s add appfilter %s', U, op.value); break;
		default: die('不支持的操作：' + op.op);
		}
		let r = sh(cmd);
		push(log, sprintf('%s %s %s → %s', op.op, k, op.value ?? '', r.code == 0 ? ('成功' + (length(trim(r.out)) ? '：' + trim(r.out) : '')) : '失败：' + trim(r.out)));
		if (r.code != 0) {
			sh(U + ' revert appfilter');
			die('操作失败，已撤销本次所有未提交的修改：\n' + join('\n', log));
		}
	}
	if (a.commit !== false) {
		sh(U + ' commit appfilter');
		push(log, '已提交');
		if (a.restart !== false) {
			sh(sprintf("nohup sh -c '%s/appfilter restart' >/dev/null 2>&1 </dev/null &", conf().init_dir));
			push(log, 'OAF 正在后台重启');
		}
	}
	return join('\n', log);
};

/* ---------------- 系统 / 设备 / 网络 ---------------- */

T.system_info = function() {
	let out = [];
	let model = trim(readfile('/tmp/sysinfo/model') ?? readfile('/proc/device-tree/model') ?? '');
	if (length(model)) push(out, '型号：' + model);

	let osr = readfile('/etc/openwrt_release') ?? '';
	let m = match(osr, /DISTRIB_DESCRIPTION='([^']*)'/);
	if (m) push(out, '系统：' + m[1]);

	let up = readfile('/proc/uptime');
	if (up) {
		let s = +split(up, ' ')[0];
		push(out, sprintf('运行时间：%d天%d时%d分', s / 86400, (s % 86400) / 3600, (s % 3600) / 60));
	}

	let la = readfile('/proc/loadavg');
	if (la) {
		let p = split(trim(la), ' ');
		push(out, sprintf('CPU 负载：%s / %s / %s（1/5/15 分钟）', p[0], p[1], p[2]));
	}

	let mem = readfile('/proc/meminfo') ?? '';
	let tot = +(match(mem, /MemTotal:\s+(\d+)/)?.[1] ?? 0);
	let av = +(match(mem, /MemAvailable:\s+(\d+)/)?.[1] ?? 0);
	if (tot)
		push(out, sprintf('内存：已用 %s / 共 %s（%d%%）', fmt_bytes((tot - av) * 1024), fmt_bytes(tot * 1024), (tot - av) * 100 / tot));

	let temps = [];
	let tz = sh("for z in /sys/class/thermal/thermal_zone*/temp; do [ -f \"$z\" ] && cat \"$z\"; done");
	for (let l in split(trim(tz.out), '\n')) {
		let v = +l;
		if (v > 1000) v = v / 1000;
		if (v > 0) push(temps, sprintf('%.1f°C', v));
	}
	if (length(temps)) push(out, '温度：' + join(' / ', temps));

	let df = sh("df -h / /overlay /tmp 2>/dev/null | grep -v '^Filesystem'");
	if (length(trim(df.out))) {
		push(out, '存储（文件系统 大小 已用 可用 使用率 挂载点）：');
		for (let l in split(trim(df.out), '\n')) push(out, '  ' + l);
	}
	return join('\n', out);
};

T.net_speed = function(a) {
	let secs = +a.seconds || 2;
	if (secs < 1) secs = 1;
	if (secs > 10) secs = 10;
	let r = sh(sprintf('cat /proc/net/dev; echo @@@; sleep %d; cat /proc/net/dev', secs));
	let halves = split(r.out, '@@@');
	if (length(halves) < 2) die('采样失败');
	function parse(txt) {
		let o = {};
		for (let l in split(txt, '\n')) {
			let mm = match(l, /^\s*([A-Za-z0-9._@-]+):\s*(\d+)\s+\d+\s+\d+\s+\d+\s+\d+\s+\d+\s+\d+\s+\d+\s+(\d+)/);
			if (mm) o[mm[1]] = { rx: +mm[2], tx: +mm[3] };
		}
		return o;
	}
	let s1 = parse(halves[0]), s2 = parse(halves[1]);
	let rows = [];
	for (let k, d in s2) {
		if (k == 'lo' || (a.interface && k != a.interface)) continue;
		let o = s1[k] ?? d;
		push(rows, { k, rx: (d.rx - o.rx) / secs, tx: (d.tx - o.tx) / secs, total_rx: d.rx, total_tx: d.tx });
	}
	rows = sort(rows, (x, y) => (y.rx + y.tx) - (x.rx + x.tx));
	let out = [sprintf('各接口实时速率（%d 秒平均，↓接收 ↑发送 | 开机以来累计）：', secs)];
	for (let x in rows)
		push(out, sprintf('%s  ↓%s/s ↑%s/s | 累计 ↓%s ↑%s', x.k, fmt_bytes(x.rx), fmt_bytes(x.tx), fmt_bytes(x.total_rx), fmt_bytes(x.total_tx)));
	return join('\n', out);
};

T.device_list = function() {
	let arp = {};
	for (let l in split(readfile('/proc/net/arp') ?? '', '\n')) {
		let mm = match(l, /^(\d+\.\d+\.\d+\.\d+)\s+\S+\s+(0x\S+)\s+([0-9a-fA-F:]{17})\s+\S+\s+(\S+)/);
		if (mm && mm[3] != '00:00:00:00:00:00' && mm[2] != '0x0')
			arp[lc(mm[3])] = { ip: mm[1], dev: mm[4] };
	}
	let names = {};
	for (let l in split(readfile('/etc/ethers') ?? '', '\n')) {
		let mm = match(l, /^([0-9a-fA-F:]{17})\s+(\S+)/);
		if (mm) names[lc(mm[1])] = mm[2];
	}
	let out = ['设备列表（● 在线 ○ 离线 | IP | MAC | 名称 | 接口）：'], seen = {};
	for (let l in split(trim(readfile('/tmp/dhcp.leases') ?? ''), '\n')) {
		let p = split(l, ' ');
		if (length(p) < 4) continue;
		let mac = lc(p[1]);
		seen[mac] = 1;
		push(out, sprintf('%s %s | %s | %s | %s', arp[mac] ? '●' : '○', p[2], mac,
			CL.dev_label(mac, p[3] != '*' ? p[3] : names[mac]) ?? '(未知)', arp[mac]?.dev ?? '-'));
	}
	for (let mac, e in arp) {
		if (seen[mac]) continue;
		push(out, sprintf('● %s | %s | %s | %s', e.ip, mac, CL.dev_label(mac, names[mac]) ?? '(静态 IP / 无 DHCP 记录)', e.dev));
	}
	return join('\n', out);
};

T.network_info = function() {
	let out = [];
	for (let ifc in ['wan', 'wan6']) {
		let r = sh(sprintf('ubus call network.interface.%s status', ifc));
		let d = null;
		try { d = json(r.out); } catch (e) {}
		if (type(d) != 'object') continue;
		push(out, sprintf('%s：%s，协议 %s，设备 %s', ifc, d.up ? '已连接' : '未连接', d.proto ?? '?', d.l3_device ?? d.device ?? '?'));
		for (let x in (d['ipv4-address'] ?? [])) push(out, '  IPv4：' + x.address + '/' + x.mask);
		for (let x in (d['ipv6-address'] ?? [])) push(out, '  IPv6：' + x.address + '/' + x.mask);
		for (let x in (d.route ?? [])) if (x.target == '0.0.0.0' || x.target == '::') push(out, '  网关：' + x.nexthop);
		if (length(d['dns-server'] ?? [])) push(out, '  DNS：' + join(' ', d['dns-server']));
		if (d.uptime) push(out, sprintf('  已连接 %d 小时 %d 分', d.uptime / 3600, (d.uptime % 3600) / 60));
	}
	if (!length(out)) push(out, '（无法通过 ubus 读取 WAN 状态）');
	push(out, '== 接口地址 ==');
	push(out, trim_nl(sh("ip -o -4 addr show | awk '{print $2, $4}'; ip -o -6 addr show scope global | awk '{print $2, $4}'").out));
	push(out, '== 默认路由 ==');
	push(out, trim_nl(sh('ip route show default; ip -6 route show default').out));
	return join('\n', out);
};

/* ---------------- 服务 / 重启 ---------------- */

function valid_service(name) {
	if (!match(name ?? '', /^[A-Za-z0-9_.-]+$/)) die('非法服务名：' + name);
	if (!stat(conf().init_dir + '/' + name)) die('服务不存在：' + name + '（用 list_services 查看）');
}

T.list_services = function() {
	let dir = conf().init_dir;
	let r = sh(sprintf("cd %s && for s in *; do [ -x \"$s\" ] || continue; if ./\"$s\" enabled >/dev/null 2>&1; then e=是; else e=否; fi; if ./\"$s\" running >/dev/null 2>&1; then u=运行中; else u=-; fi; echo \"$s | $e | $u\"; done", shq(dir)));
	return '服务（名称 | 开机自启 | 运行状态，部分服务不支持状态查询显示 -）：\n' + trim_nl(r.out);
};

T.service_control = function(a) {
	valid_service(a.name);
	if (index(['restart', 'start', 'stop', 'reload', 'enable', 'disable'], a.action) < 0)
		die('action 只能是 restart / start / stop / reload / enable / disable');
	if (a.name == 'claude-mcp' && index(['stop', 'disable'], a.action) >= 0)
		die('停止或禁用 claude-mcp 会让我立刻失去连接，且无法远程恢复。如确实需要，请在路由器终端手动执行。');

	let cmd = sprintf('%s/%s %s', conf().init_dir, a.name, a.action);
	const slow = { network: 1, firewall: 1, openclash: 1, 'claude-mcp': 1, dnsmasq: 1, uhttpd: 1, odhcpd: 1 };
	if (slow[a.name] && index(['restart', 'stop', 'reload', 'start'], a.action) >= 0) {
		sh(sprintf("nohup sh -c 'sleep 1; %s' >/dev/null 2>&1 </dev/null &", cmd));
		return sprintf('已在后台执行：%s。这类服务会短暂影响网络或本次连接，等 10–30 秒后再查看状态。', cmd);
	}
	let r = sh(cmd);
	return sprintf('%s → %s%s', cmd, r.code == 0 ? '完成' : '失败（退出码 ' + r.code + '）', length(trim(r.out)) ? '\n' + trim(r.out) : '');
};

T.reboot_router = function(a) {
	if (a.confirm !== true)
		die('重启会让整个网络中断约 1–3 分钟。请先征得用户同意，再以 confirm=true 调用。');
	sh("nohup sh -c 'sleep 3; reboot' >/dev/null 2>&1 </dev/null &");
	return '路由器将在 3 秒后重启，约 1–3 分钟后恢复。重启后连接器会自动重连，地址不变。';
};

/* ---------------- 防火墙 / 端口转发 ---------------- */

T.firewall_overview = function() {
	let U = conf().uci;
	let r = sh(U + ' -q show firewall');
	let secs = {}, order = [];
	for (let l in split(r.out, '\n')) {
		let mm = match(l, /^firewall\.([^.=]+)=(\S+)$/);
		if (mm) { secs[mm[1]] = { _type: mm[2] }; push(order, mm[1]); continue; }
		mm = match(l, /^firewall\.([^.=]+)\.([^=]+)=(.*)$/);
		if (mm && secs[mm[1]]) secs[mm[1]][mm[2]] = replace(mm[3], /'/g, '');
	}
	let out = { zone: [], forwarding: [], redirect: [], rule: [] };
	for (let i = 0; i < length(order); i++) {
		let id = order[i], s = secs[id], ref = sprintf('firewall.%s', id);
		switch (s._type) {
		case 'zone':
			push(out.zone, sprintf('%s：入站 %s / 出站 %s / 转发 %s，网络 %s%s  [%s]', s.name ?? '?', s.input ?? '-', s.output ?? '-', s.forward ?? '-', s.network ?? '-', s.masq == '1' ? '，NAT' : '', ref));
			break;
		case 'forwarding':
			push(out.forwarding, sprintf('%s → %s  [%s]', s.src ?? '?', s.dest ?? '?', ref));
			break;
		case 'redirect':
			push(out.redirect, sprintf('%s%s：%s %s 端口 %s → %s:%s  [%s]', s.enabled == '0' ? '（已停用）' : '', s.name ?? '(未命名)', s.src ?? 'wan', s.proto ?? 'tcp udp', s.src_dport ?? '?', s.dest_ip ?? '?', s.dest_port ?? s.src_dport ?? '', ref));
			break;
		case 'rule':
			push(out.rule, sprintf('%s%s：%s→%s %s %s → %s  [%s]', s.enabled == '0' ? '（已停用）' : '', s.name ?? '(未命名)', s.src ?? '*', s.dest ?? '本机', s.proto ?? '', s.dest_port ? '端口 ' + s.dest_port : '', s.target ?? '?', ref));
			break;
		}
	}
	return join('\n', [
		'== 区域 ==', ...out.zone,
		'== 区域转发 ==', ...out.forwarding,
		'== 端口转发 ==', ...(length(out.redirect) ? out.redirect : ['（无）']),
		'== 通信规则 ==', ...out.rule,
		'',
		'添加端口转发可用 uci_set：op=add config=firewall value=redirect，再 set firewall.@redirect[-1].name/src/src_dport/dest/dest_ip/dest_port/proto，reload=firewall。'
	]);
};

/* ---------------- 通用 uci ---------------- */

const KEY_RE = /^[a-z0-9_-]+(\.(@[A-Za-z0-9_-]+\[-?[0-9]+\]|[A-Za-z0-9_-]+)){0,2}$/;
const SECRET_RE = /(key|pass|secret|token|psk)/i;
const BACKUP_DIR = '/etc/claude-mcp/uci-backup';

T.uci_show = function(a) {
	if (a.config == null)
		return '配置文件列表：\n' + trim_nl(sh('ls ' + (conf().uci_dir || '/etc/config')).out) +
			'\n\n用 config=<名称> 查看，常用：network（网络/接口）、wireless（Wi-Fi）、dhcp（DHCP/DNS）、firewall（防火墙）、system（系统）';
	let k = a.config + (a.key ? '.' + a.key : '');
	if (index(a.key ?? '', a.config + '.') == 0) k = a.key;
	if (!match(k, KEY_RE)) die('非法配置名或 key：' + k);
	let r = sh(sprintf('%s show %s', conf().uci, shq(k)));
	if (r.code != 0) die('读取失败：' + trim(r.out));
	return length(trim(r.out)) ? r.out : '（空）';
};

T.uci_set = function(a) {
	let ops = a.operations;
	if (type(ops) != 'array' || !length(ops)) die('operations 必须是非空数组');
	let U = conf().uci, cfgs = {}, log = [];

	for (let op in ops) {
		let k = op.op == 'add' ? (op.config ?? '') : (op.key ?? '');
		if (!match(k, KEY_RE)) die('非法 key：' + k);
		if (op.op != 'add' && !match(k, /\./)) die('key 需要包含配置名和节名，如 wireless.@wifi-iface[0].ssid：' + k);
		cfgs[split(k, '.')[0]] = 1;
	}
	if (cfgs['claude-mcp']) die('不允许通过本工具修改 claude-mcp 自身配置');

	mkdir('/etc/claude-mcp');
	mkdir(BACKUP_DIR);
	let stamp = now_str();
	for (let c in cfgs) {
		let e = sh(sprintf('%s export %s', U, shq(c)));
		if (e.code == 0) writefile(sprintf('%s/%s.%s', BACKUP_DIR, c, stamp), e.out);
	}

	for (let op in ops) {
		let k = op.key, v = op.value ?? '', cmd;
		switch (op.op) {
		case 'set':      cmd = sprintf('%s set %s', U, shq(k + '=' + v)); break;
		case 'add_list': cmd = sprintf('%s add_list %s', U, shq(k + '=' + v)); break;
		case 'del_list': cmd = sprintf('%s del_list %s', U, shq(k + '=' + v)); break;
		case 'delete':   cmd = sprintf('%s delete %s', U, shq(k)); break;
		case 'rename':   cmd = sprintf('%s rename %s', U, shq(k + '=' + v)); break;
		case 'add':
			if (!match(v, /^[A-Za-z0-9_-]+$/)) die('add 需要 value=节类型，如 redirect、rule、host');
			k = op.config;
			cmd = sprintf('%s add %s %s', U, shq(k), shq(v));
			break;
		default:
			die('不支持的操作：' + op.op);
		}
		let r = sh(cmd);
		let shown = (match(k, SECRET_RE) && op.op != 'add') ? '******' : v;
		push(log, sprintf('%s %s %s → %s', op.op, k, shown, r.code == 0 ? ('成功' + (length(trim(r.out)) ? '：' + trim(r.out) : '')) : '失败：' + trim(r.out)));
		if (r.code != 0) {
			for (let c in cfgs) sh(U + ' revert ' + shq(c));
			die('操作失败，已撤销本次全部修改：\n' + join('\n', log));
		}
	}

	if (a.commit === false) {
		push(log, '已暂存未提交（可用 uci_show 检查；再次调用 commit=true 提交，或 uci_revert 放弃）');
		return join('\n', log);
	}
	for (let c in cfgs) sh(U + ' commit ' + shq(c));
	push(log, sprintf('已提交 %s，修改前的备份在 %s/<配置>.%s', join('、', keys(cfgs)), BACKUP_DIR, stamp));

	const RELOAD = {
		network: '/etc/init.d/network reload',
		firewall: '/etc/init.d/firewall reload',
		dhcp: '/etc/init.d/dnsmasq restart; /etc/init.d/odhcpd restart',
		wireless: 'wifi reload',
		system: '/etc/init.d/system reload',
	};
	if (a.reload) {
		let cmd = RELOAD[a.reload];
		if (!cmd) die('reload 只能是：' + join(' / ', keys(RELOAD)));
		sh(sprintf("nohup sh -c 'sleep 1; %s' >/dev/null 2>&1 </dev/null &", cmd));
		push(log, '已在后台执行：' + cmd + (a.reload == 'network' || a.reload == 'wireless' ? '（网络 / Wi-Fi 会短暂中断）' : ''));
	} else
		push(log, '注意：修改已保存但尚未生效，需要 reload（network / firewall / dhcp / wireless / system）或 service_control 重启相关服务。');
	return join('\n', log);
};

T.uci_revert = function(a) {
	if (!match(a.config ?? '', /^[a-z0-9_-]+$/)) die('需要 config');
	sh(conf().uci + ' revert ' + shq(a.config));
	return '已放弃 ' + a.config + ' 未提交的修改';
};

T.uci_backups = function(a) {
	if (a.restore) {
		if (!match(a.restore, /^[a-z0-9_-]+\.[0-9]{8}-[0-9]{6}$/)) die('restore 格式应为 <配置>.<时间>，如 network.20261027-235000');
		let f = BACKUP_DIR + '/' + a.restore;
		if (!stat(f)) die('备份不存在：' + f);
		let c = split(a.restore, '.')[0];
		let r = sh(sprintf('%s import %s < %s && %s commit %s', conf().uci, shq(c), shq(f), conf().uci, shq(c)));
		if (r.code != 0) die('还原失败：' + trim(r.out));
		return sprintf('已把 %s 还原为 %s 的备份。还需 reload 对应服务才生效。', c, a.restore);
	}
	let r = sh(sprintf('ls -1t %s 2>/dev/null | head -n 40', shq(BACKUP_DIR)));
	return length(trim(r.out)) ? '配置备份（新→旧，用 restore=<名称> 还原）：\n' + trim_nl(r.out) : '还没有配置备份';
};

/* ---------------- 日志 / 软件包 ---------------- */

T.system_log = function(a) {
	let n = +a.lines || 80;
	if (n > 500) n = 500;
	let cmd = 'logread';
	if (a.filter) cmd += ' | grep -i -- ' + shq(a.filter);
	cmd += ' | tail -n ' + n;
	let r = sh(cmd);
	if (!length(trim(r.out))) r = sh('dmesg | tail -n ' + n);
	return length(trim(r.out)) ? r.out : '（没有日志）';
};

function pkgmgr() {
	if (length(trim(sh('command -v apk').out))) return 'apk';
	if (length(trim(sh('command -v opkg').out))) return 'opkg';
	die('没有找到 opkg 或 apk');
}

T.packages = function(a) {
	let pm = pkgmgr(), act = a.action ?? 'list', name = a.name ?? '';
	if (length(name) && !match(name, /^[A-Za-z0-9_.+-]+$/)) die('非法包名');
	let cmd;
	switch (act) {
	case 'list':
		cmd = pm == 'apk' ? 'apk info -v' : 'opkg list-installed';
		if (length(name)) cmd += ' | grep -i -- ' + shq(name);
		break;
	case 'search':
		if (!length(name)) die('search 需要 name');
		cmd = pm == 'apk' ? 'apk update >/dev/null 2>&1; apk search -d ' + shq(name) : 'opkg update >/dev/null 2>&1; opkg find ' + shq('*' + name + '*');
		break;
	case 'upgradable':
		cmd = pm == 'apk' ? 'apk update >/dev/null 2>&1; apk version -l "<"' : 'opkg update >/dev/null 2>&1; opkg list-upgradable';
		break;
	case 'install':
	case 'remove':
		if (!length(name)) die(act + ' 需要 name');
		if (act == 'remove' && match(name, /^(base-files|busybox|kernel|libc|procd|ubus|uci|ucode|uhttpd|curl|cloudflared|dropbear|firewall4?|netifd|opkg|apk-tools)$/))
			die('为避免系统损坏或失去连接，不允许通过本工具卸载 ' + name);
		cmd = pm == 'apk'
			? (act == 'install' ? 'apk update >/dev/null 2>&1; apk add ' : 'apk del ') + shq(name)
			: (act == 'install' ? 'opkg update >/dev/null 2>&1; opkg install ' : 'opkg remove ') + shq(name);
		break;
	default:
		die('action 只能是 list / search / upgradable / install / remove');
	}
	let r = sh(cmd);
	let out = r.out;
	if (length(out) > 30000) out = substr(out, 0, 30000) + '\n……（输出过长已截断）';
	return sprintf('[%s] %s（退出码 %d）\n%s', pm, act, r.code, out);
};

/* ---------------- 高级：命令行 ---------------- */

T.run_command = function(a) {
	if (conf().allow_shell === false) die('命令行功能已在路由器上关闭（claude-mcp shell on 可开启）');
	if (type(a.command) != 'string' || !length(trim(a.command))) die('缺少 command');
	let t = +a.timeout || 30;
	if (t < 1) t = 1;
	if (t > 110) t = 110;
	let has_to = length(trim(sh('command -v timeout').out)) > 0;
	let r = sh(has_to ? sprintf('timeout %d sh -c %s', t, shq(a.command)) : 'sh -c ' + shq(a.command));
	let out = r.out;
	if (length(out) > 40000) out = substr(out, 0, 40000) + '\n……（输出过长已截断）';
	return sprintf('退出码 %d%s\n%s', r.code, r.code == 124 || r.code == 143 ? '（超时被终止）' : '', out);
};

/* ---------------- 手机面板用的结构化接口 ---------------- */

function read_ifbytes(dev) {
	for (let l in split(readfile('/proc/net/dev') ?? '', '\n')) {
		let m = match(l, /^\s*([A-Za-z0-9._@-]+):\s*(\d+)\s+\d+\s+\d+\s+\d+\s+\d+\s+\d+\s+\d+\s+\d+\s+(\d+)/);
		if (m && m[1] == dev) return { rx: +m[2], tx: +m[3] };
	}
	return null;
}

const P = {};

/* CPU 使用率：读 /proc/stat，两次之间的空闲比例 */
function cpu_stat() {
	let m = match(readfile('/proc/stat') ?? '', /^cpu\s+(\d+) (\d+) (\d+) (\d+) (\d+) (\d+) (\d+) ?(\d*)/);
	if (!m) return null;
	let tot = 0;
	for (let i = 1; i <= 8; i++) tot += +(m[i] || 0);
	return { tot, idle: +m[4] + +m[5] };
}

/* OpenClash 正在做什么：启动日志最后一行（中文），日志没变就用缓存，不重复翻译 */
function oc_line() {
	// 启动/停止过程中看启动日志；平时（启动日志被 OpenClash 网页清空后）看插件日志最后一行
	let raw = trim(sh("{ grep . /tmp/openclash_start.log 2>/dev/null || tail -n 400 /tmp/openclash.log 2>/dev/null | grep -v '^time='; } | tail -n 1").out);
	if (!length(raw)) return null;
	let cf = '/tmp/cmcp_ocline.json', c = null;
	try { c = json(readfile(cf) ?? 'null'); } catch (e) {}
	if (c?.raw == raw) return c.line;
	let line = null;
	try { line = json(trim(sh('printf "%s\\n" ' + shq(raw) + ' | lua /etc/claude-mcp/oc_line.lua').out)); } catch (e) {}
	if (line) writefile(cf, sprintf('%J', { raw, line }));
	return line;
}

P.overview = function() {
	let o = { clash: { running: false }, system: {}, wan: null, speed: null };

	try {
		let v = api('GET', '/version', null, 4);
		o.clash.running = true;
		o.clash.version = v?.version;
		let c = api('GET', '/configs', null, 4);
		o.clash.mode = c?.mode;
		let cn = api('GET', '/connections', null, 4);
		o.clash.connections = length(cn?.connections ?? []);
		o.clash.download_total = cn?.downloadTotal ?? 0;
		o.clash.upload_total = cn?.uploadTotal ?? 0;
	} catch (e) {
		o.clash.error = '' + e;
	}
	// 装了哪些代理插件、正在用哪个（OpenClash 以外的插件也认）
	try { o.px = P.px(); } catch (e) {}
	o.clash.config = uci_get('openclash.config.config_path');
	o.clash.line = oc_line();
	// OpenClash 是否正在启动/停止（只查这一个进程，比查全部后台任务快）
	o.clash.busy = +trim(sh("ps w | grep '/etc/init.d/openclash' | grep -v grep | grep -c .").out) > 0;
	// 启动早就完成了：不再显示启动日志最后一句（「请等待服务器上线」之类），改成「运行正常 · 已运行多久」
	if (!o.clash.busy && o.clash.running) {
		let pid = trim(split(trim(sh('pidof clash').out), ' ')[0] ?? ''), st = length(pid) ? readfile('/proc/' + pid + '/stat') : null;
		let f = st ? split(trim(substr(st, index(st, ')') + 1)), ' ') : [];
		let age = length(f) > 19 ? +split(readfile('/proc/uptime') ?? '0', ' ')[0] - +f[19] / 100.0 : 0;
		if (age > 60) {
			let d = age / 86400 | 0, h = (age % 86400) / 3600 | 0, m = (age % 3600) / 60 | 0;
			o.clash.line = { t: null, lv: null, msg: '运行正常 · 内核已运行 ' + (d ? d + ' 天 ' + h + ' 小时' : h ? h + ' 小时 ' + m + ' 分' : m + ' 分钟') };
		}
	}
	o.clash.custom_rules = uci_get('openclash.config.enable_custom_clash_rules') == '1';

	let s = o.system;
	let cs0 = cpu_stat(), CF = '/tmp/cmcp_cpu.json', pc = null;
	try { pc = json(readfile(CF) ?? 'null'); } catch (e) {}
	s.model = trim(readfile('/tmp/sysinfo/model') ?? readfile('/proc/device-tree/model') ?? '');
	s.firmware = match(readfile('/etc/openwrt_release') ?? '', /DISTRIB_DESCRIPTION='([^']*)'/)?.[1];
	s.uptime = +split(readfile('/proc/uptime') ?? '0', ' ')[0];
	s.load = split(trim(readfile('/proc/loadavg') ?? ''), ' ')[0];
	let cpus = length(filter(split(readfile('/proc/cpuinfo') ?? '', '\n'), (l) => match(l, /^processor\s*:/)));
	s.cpus = cpus || 1;
	let mem = readfile('/proc/meminfo') ?? '';
	s.mem_total = +(match(mem, /MemTotal:\s+(\d+)/)?.[1] ?? 0) * 1024;
	s.mem_avail = +(match(mem, /MemAvailable:\s+(\d+)/)?.[1] ?? 0) * 1024;
	let t = trim(sh("cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null").out);
	if (match(t, /^[0-9]+$/)) s.temp = +t > 1000 ? +t / 1000 : +t;

	let w = null;
	try { w = json(sh('ubus call network.interface.wan status').out); } catch (e) {}
	let dev = null;
	if (type(w) == 'object') {
		o.wan = { up: !!w.up, proto: w.proto, ip: w['ipv4-address']?.[0]?.address, uptime: w.uptime ?? 0 };
		dev = w.l3_device ?? w.device;
	}
	if (!dev) dev = trim(sh("ip route show default | awk '{for(i=1;i<=NF;i++) if($i==\"dev\"){print $(i+1); exit}}'").out);
	if (length(dev ?? '')) {
		/* 用上一次的采样算网速，不用每次都等 1 秒；没有近期采样时只等 0.4 秒 */
		let up = () => +split(readfile('/proc/uptime') ?? '0', ' ')[0];
		let SF = '/tmp/cmcp_speed.json', prev = null;
		try { prev = json(readfile(SF) ?? 'null'); } catch (e) {}
		let b = read_ifbytes(dev), tb = up(), a = null, dt = 0;
		if (b && prev?.dev == dev && tb - prev.t >= 0.8 && tb - prev.t <= 20 && b.rx >= prev.rx && b.tx >= prev.tx) { a = prev; dt = tb - prev.t; }
		else if (b) {
			a = b; let ta = tb;
			sh('F=/tmp/cmcp_sp.$$; mkfifo $F && { read -t 0.4 x <> $F; rm -f $F; }');
			b = read_ifbytes(dev); tb = up(); dt = tb - ta;
		}
		if (a && b) {
			if (dt < 0.1) dt = 0.1;
			o.speed = { dev, rx: int((b.rx - a.rx) / dt + 0.5), tx: int((b.tx - a.tx) / dt + 0.5), rx_total: b.rx, tx_total: b.tx };
			writefile(SF, sprintf('%J', { dev, t: tb, rx: b.rx, tx: b.tx }));
		}
	}
	/* 有近期采样就跟它比（准），没有就跟这次请求开头比（中间等过 0.4 秒） */
	let cs1 = cpu_stat(), ut = +split(readfile('/proc/uptime') ?? '0', ' ')[0];
	if (cs1) {
		let a = (pc && ut - pc.t >= 0.5 && ut - pc.t <= 20 && cs1.tot > pc.tot) ? pc : cs0;
		if (a && cs1.tot - a.tot >= 10) s.cpu = int(1000 * (1 - (cs1.idle - a.idle) * 1.0 / (cs1.tot - a.tot)) + 0.5) / 10;
		writefile(CF, sprintf('%J', { t: ut, tot: cs1.tot, idle: cs1.idle }));
	}
	return o;
};

P.groups = function() {
	let px = api('GET', '/proxies')?.proxies ?? {};
	let names = px.GLOBAL?.all ?? keys(px);
	let out = [];
	for (let n in names) {
		let g = px[n];
		if (!g || !GROUP_TYPES[g.type] || n == 'GLOBAL') continue;
		let nodes = [];
		for (let m in (g.all ?? [])) {
			let p = px[m] ?? {};
			push(nodes, { name: m, type: p.type ?? '', delay: last_delay(p), group: !!GROUP_TYPES[p.type] });
		}
		push(out, { name: n, type: g.type, now: g.now, nodes });
	}
	return { groups: out };
};

// 静态分配里起的名字：MAC → 名字
function static_names() {
	let cur = {}, out = {};
	for (let l in split(sh("uci -q show dhcp | grep -E '\\.(mac|name)='").out, '\n')) {
		let m = match(l, /^dhcp\.([^.]+)\.(mac|name)='?([^']*)'?$/);
		if (!m) continue;
		cur[m[1]] ??= {}; cur[m[1]][m[2]] = m[3];
	}
	for (let s in cur) if (cur[s].mac && cur[s].name) for (let mm in split(lc(cur[s].mac), ' ')) out[mm] = cur[s].name;
	return out;
}
function lease_map() {
	let names = {}, st = static_names();
	for (let l in split(trim(readfile('/tmp/dhcp.leases') ?? ''), '\n')) {
		let p = split(l, ' ');
		if (length(p) >= 4) names[p[2]] = { mac: lc(p[1]), name: CL.dev_label(p[1], st[lc(p[1])] ?? p[3]), orig: CL.name_clean(st[lc(p[1])] ?? p[3]) };
	}
	// 有的新固件（odhcpd 分配 IPv4）没有 /tmp/dhcp.leases：从 ubus 读
	if (!length(names)) try {
		let j = json(sh('ubus call dhcp ipv4leases 2>/dev/null').out || '{}');
		for (let dv, x in j?.device ?? {}) for (let e in x?.leases ?? []) {
			let mac = lc(replace(e.mac ?? '', /^([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i, '$1:$2:$3:$4:$5:$6'));
			if (e.address && match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/)) names[e.address] = { mac, name: CL.dev_label(mac, st[mac] ?? e.hostname), orig: CL.name_clean(st[mac] ?? e.hostname) };
		}
	} catch (e) {}
	return names;
}

/* ---------- 首页：实时网速（每 2 秒一次，只读 /proc/net/dev，很轻）、今日流量、在线设备 ---------- */
P.live = function() {
	let SF = '/tmp/cmcp_speed.json', prev = null;
	try { prev = json(readfile(SF) ?? 'null'); } catch (e) {}
	let dev = prev?.dev;
	if (!dev) {
		let w = null;
		try { w = json(sh('ubus call network.interface.wan status').out); } catch (e) {}
		dev = w?.l3_device ?? w?.device ?? trim(sh("ip route show default | awk '{for(i=1;i<=NF;i++) if($i==\"dev\"){print $(i+1); exit}}'").out);
	}
	if (!length(dev ?? '')) return { dev: null, rx: null, tx: null };
	let b = read_ifbytes(dev), t = +split(readfile('/proc/uptime') ?? '0', ' ')[0];
	if (!b) { sh('rm -f ' + SF); return { dev, rx: null, tx: null }; }
	let dt = prev?.dev == dev ? t - prev.t : -1;
	// 两次请求挨得太近：直接给上一次算好的，不重新算（不准）
	if (dt >= 0 && dt < 0.5 && prev.rr != null) return { dev, rx: prev.rr, tx: prev.tr };
	let o = { dev, rx: null, tx: null };
	if (dt >= 0.5 && dt <= 20 && b.rx >= prev.rx && b.tx >= prev.tx) { o.rx = int((b.rx - prev.rx) / dt + 0.5); o.tx = int((b.tx - prev.tx) / dt + 0.5); }
	writefile(SF, sprintf('%J', { dev, t, rx: b.rx, tx: b.tx, rr: o.rx, tr: o.tx }));
	return o;
};
// 连在 Wi-Fi 上的设备（MAC 地址）
function wifi_macs() {
	let out = sh("for i in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do iw dev $i station dump 2>/dev/null | awk '/^Station/{print $2}'; done").out;
	if (!length(trim(out)))
		out = sh("for i in $(iwinfo 2>/dev/null | awk '/ESSID/{print $1}'); do iwinfo $i assoclist 2>/dev/null | awk '/^[0-9A-Fa-f][0-9A-Fa-f]:/{print $1}'; done").out;
	let m = {};
	for (let l in split(out, '\n')) { l = lc(trim(l)); if (match(l, /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/)) m[l] = 1; }
	return m;
}
P.home_stats = function() {
	// 今日流量（cmcp-traffic 每分钟统计一次，按设备分开；要 OpenClash 在运行才统计得到）
	let tr = null;
	try { tr = P.traffic(); } catch (e) {}
	let day = tr?.today, td = (day && tr.days?.[day]) ?? {}, dl = 0, ul = 0, list = [];
	for (let k in td) {
		let a = td[k];
		if (type(a) != 'array') continue;
		let u = (+a[0] || 0) + (+a[2] || 0), d = (+a[1] || 0) + (+a[3] || 0);
		ul += u; dl += d;
		push(list, { id: k, name: k == 'other' ? '其他' : k == 'router' ? '路由器自己' : (tr.names?.[k] ?? null), dl: d, ul: u });
	}
	list = sort(list, (x, y) => (y.dl + y.ul) - (x.dl + x.ul));
	let top = slice(filter(list, (x) => x.id != 'other' && x.dl + x.ul > 0), 0, 3);
	// 在线设备：局域网里有 ARP 记录的（去掉外网口），按 Wi-Fi 连接列表分出无线、有线
	let wdev = {};
	for (let w in ['wan', 'wan6']) try { let st = json(sh('ifstatus ' + w).out); if (st?.l3_device) wdev[st.l3_device] = 1; if (st?.device) wdev[st.device] = 1; } catch (e) {}
	let on = {};
	for (let l in split(readfile('/proc/net/arp') ?? '', '\n')) {
		let m = match(l, /^(\d+\.\d+\.\d+\.\d+)\s+\S+\s+(0x\S+)\s+([0-9a-fA-F:]{17})\s+\S+\s+(\S+)/);
		if (m && m[2] != '0x0' && m[3] != '00:00:00:00:00:00' && !wdev[m[4]]) on[lc(m[3])] = 1;
	}
	let wm = wifi_macs(), wifi = 0, all = {};
	for (let mac in on) if (wm[mac]) wifi++;
	// Wi-Fi 上连着但还没有 ARP 记录的（刚连上、或者没要 IP），也算在线
	for (let mac in wm) if (!on[mac]) { on[mac] = 1; wifi++; }
	for (let mac in on) all[mac] = 1;
	let lm = lease_map();
	for (let ip in lm) if (lm[ip]?.mac) all[lm[ip].mac] = 1;
	let n = length(keys(on));
	return { today: { day, dl, ul, top, counting: !!tr?.at && time() - tr.at < 600 }, devices: { online: n, wifi, wired: n - wifi, total: length(keys(all)) } };
};

P.devices = function() {
	let leases = lease_map();
	let arp = {}, wdev = {};
	for (let w in ['wan', 'wan6']) try { let st = json(sh('ifstatus ' + w).out); if (st?.l3_device) wdev[st.l3_device] = 1; if (st?.device) wdev[st.device] = 1; } catch (e) {}
	for (let l in split(readfile('/proc/net/arp') ?? '', '\n')) {
		let m = match(l, /^(\d+\.\d+\.\d+\.\d+)\s+\S+\s+(0x\S+)\s+([0-9a-fA-F:]{17})\s+\S+\s+(\S+)/);
		if (m && m[2] != '0x0' && m[3] != '00:00:00:00:00:00' && !wdev[m[4]]) arp[m[1]] = { mac: lc(m[3]), dev: m[4] };
	}
	let stats = {};
	try {
		for (let c in (api('GET', '/connections', null, 5)?.connections ?? [])) {
			let ip = c.metadata?.sourceIP;
			if (!ip) continue;
			if (!stats[ip]) stats[ip] = { conns: 0, dl: 0, ul: 0, proxied: 0 };
			stats[ip].conns++;
			stats[ip].dl += +c.download || 0;
			stats[ip].ul += +c.upload || 0;
			if ((c.chains ?? [])[0] && c.chains[0] != 'DIRECT') stats[ip].proxied++;
		}
	} catch (e) {}

	// 在线多久：cmcp-traffic 每分钟记一次（Wi-Fi 设备用无线驱动报的连上时长，更准）
	let on = CL.readj('/tmp/cmcp_online.json', {}), now = time();
	let seen = {}, list = [];
	function add(ip) {
		if (seen[ip]) return;
		seen[ip] = 1;
		let l = leases[ip] ?? {}, a = arp[ip] ?? {}, mac = l.mac ?? a.mac, online = !!arp[ip] || !!stats[ip];
		let since = online && mac && +on[mac] > 0 && +on[mac] <= now ? +on[mac] : null;
		push(list, { ip, mac, name: l.name ?? (mac ? CL.dev_label(mac, null) : null), orig: l.orig ?? null, renamed: !!(mac && CL.dev_aliases()[mac]), online, since, iface: a.dev, stats: stats[ip] });
	}
	for (let ip in keys(leases)) add(ip);
	for (let ip in keys(arp)) add(ip);
	for (let ip in keys(stats)) if (match(ip, /^(10|192\.168|172\.(1[6-9]|2\d|3[01]))\./)) add(ip);
	list = sort(list, (x, y) => ((y.online ? 1 : 0) - (x.online ? 1 : 0)) || ((y.stats?.dl ?? 0) - (x.stats?.dl ?? 0)));
	return { devices: list };
};

// 给设备改名字（按 MAC 记，路由器重启、换 IP 都还在）；名字留空就是改回原来的
P.dev_rename = function(a) {
	let mac = lc(trim('' + (a.mac ?? '')));
	if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/)) die('设备地址不对');
	let name = trim(replace('' + (a.name ?? ''), /[\x01-\x1f\x7f]/g, ''));
	if (length(name) > 60) die('名字太长了，短一点（20 个字以内）');
	let f = CL.DN_PATH, d = CL.readj(f, {});
	if (type(d) != 'object') d = {};
	if (length(name)) d[mac] = { name, at: time() };
	else delete d[mac];
	// 最多记 500 台（够用了），多了把最早改的去掉
	let ks = keys(d);
	if (length(ks) > 500) for (let k in slice(sort(ks, (x, y) => (d[x].at ?? 0) - (d[y].at ?? 0)), 0, length(ks) - 500)) delete d[k];
	writefile(f + '.tmp', sprintf('%J', d));
	rename(f + '.tmp', f);
	return { ok: true, mac, name: length(name) ? name : null };
};

P.connections = function(a) {
	let data = api('GET', '/connections');
	let leases = lease_map();
	let kw = a?.filter ? lc(a.filter) : null, list = [];
	for (let c in (data?.connections ?? [])) {
		let m = c.metadata ?? {};
		let e = {
			id: c.id,
			host: (m.host || m.sniffHost || m.destinationIP || '?'),
			port: m.destinationPort,
			net: m.network,
			src: m.sourceIP,
			src_name: leases[m.sourceIP]?.name,
			rule: (c.rule ?? '') + (length(c.rulePayload ?? '') ? ':' + c.rulePayload : ''),
			chain: c.chains ?? [],
			dl: +c.download || 0,
			ul: +c.upload || 0,
			start: c.start,
		};
		if (kw && index(lc(sprintf('%J', e)), kw) < 0) continue;
		push(list, e);
	}
	list = sort(list, (x, y) => (y.dl + y.ul) - (x.dl + x.ul));
	if (length(list) > 300) list = slice(list, 0, 300);
	return { total: length(data?.connections ?? []), download_total: data?.downloadTotal, upload_total: data?.uploadTotal, connections: list };
};

/* ---------------- 面板：OpenClash 全功能接口 ---------------- */

const OC_SH = '/usr/share/openclash';
const OC_FILE_DIRS = {
	config: '/etc/openclash/config',
	custom: '/etc/openclash/custom',
	overwrite: '/etc/openclash/overwrite',
	proxy_provider: '/etc/openclash/proxy_provider',
	rule_provider: '/etc/openclash/rule_provider',
};
const OC_SEC_TYPES = { config_subscribe: 1, dns_servers: 1, config_overwrite: 1, authentication: 1, lan_ac_traffic: 1 };
const UNLOCK_LABELS = {
	prime_video: 'Amazon Prime Video', bahamut: 'Bahamut Anime', bilibili: 'Bilibili', claude: 'Claude',
	dazn: 'DAZN', discovery: 'Discovery Plus', disney: 'Disney Plus', gemini: 'Gemini', google: 'Google',
	hbo_max: 'HBO Max', netflix: 'Netflix', openai: 'OpenAI', paramount: 'Paramount Plus', spotify: 'Spotify',
	steam: 'Steam', tvb: 'TVB Anywhere+', ytb: 'YouTube Premium',
};
const OC_JOBS = {
	sub: 'openclash\\.sh', geo: 'openclash_geo\\.sh', chnroute: 'openclash_chnroute\\.sh',
	core: 'openclash_core\\.sh', plugin: 'openclash_update\\.sh', debug: 'openclash_debug\\.sh',
	service: '/etc/init\\.d/openclash',
};

function ucur() { let c = require('uci').cursor(); c.load('openclash'); return c; }
function bg(cmd) { sh(sprintf('nohup sh -c %s >/dev/null 2>&1 </dev/null &', shq(cmd))); }
function opt_key(k) { if (type(k) != 'string' || !match(k, /^[a-z0-9_]+$/)) die('非法选项：' + k); return k; }
function opt_val(v) {
	if (type(v) == 'array') return map(v, (x) => '' + x);
	if (type(v) == 'bool') return v ? '1' : '0';
	return '' + v;
}

function oc_all() {
	let all = ucur().get_all('openclash') ?? {};
	let secs = sort(values(all), (a, b) => a['.index'] - b['.index']);
	let out = { config: {}, subs: [], dns: [], overwrite: [], auth: [] };
	let map_t = { config_subscribe: 'subs', dns_servers: 'dns', config_overwrite: 'overwrite', authentication: 'auth' };
	for (let s in secs) {
		let o = { sid: s['.name'] };
		for (let k, v in s)
			if (substr(k, 0, 1) != '.') o[k] = v;
		if (s['.type'] == 'openclash') { if (s['.name'] == 'config') out.config = o; continue; }
		let t = map_t[s['.type']] ?? s['.type'];
		if (!out[t]) out[t] = [];
		push(out[t], o);
	}
	return out;
}

function oc_file_path(kind, name) {
	let d = OC_FILE_DIRS[kind];
	if (!d) die('未知目录：' + kind);
	if (type(name) != 'string' || !length(name) || index(name, '/') >= 0 || substr(name, 0, 1) == '.' || length(name) > 120)
		die('文件名不合法');
	return d + '/' + name;
}

function oc_backup_file(kind, p) {
	if (!stat(p)) return null;
	mkdir('/etc/claude-mcp/bak');
	let b = sprintf('/etc/claude-mcp/bak/%s.%s.%s', kind, replace(p, /.*\//, ''), now_str());
	sh(sprintf('cp -f %s %s; ' + BAK_PRUNE, shq(p), shq(b)));
	return b;
}

function oc_jobs() {
	let ps = sh('ps w').out, o = {};
	for (let k, re in OC_JOBS) {
		o[k] = false;
		for (let l in split(ps, '\n'))
			if (match(l, regexp(re)) && index(l, 'grep') < 0 && index(l, 'ucode') < 0 && (k != 'sub' || index(l, 'openclash.sh') >= 0)) { o[k] = true; break; }
	}
	return o;
}

P.oc_state = function() {
	let a = oc_all(), cfg = a.config, FS = require('fs');
	let ver = null, live = null;
	try { ver = api('GET', '/version', null, 3); live = api('GET', '/configs', null, 3); } catch (e) {}
	let files = [];
	for (let n in (FS.lsdir('/etc/openclash/config') ?? [])) {
		if (!match(n, /\.ya?ml$/)) continue;
		let p = '/etc/openclash/config/' + n, st = stat(p);
		let sub = null;
		for (let s in a.subs) if (s.name + '.yaml' == n || s.name + '.yml' == n) sub = s.name;
		push(files, { name: n, path: p, size: st?.size, mtime: st?.mtime, active: cfg.config_path == p, sub });
	}
	files = sort(files, (x, y) => (y.active ? 1 : 0) - (x.active ? 1 : 0) || (x.name < y.name ? -1 : 1));
	let core = ver?.version;
	if (!core) {
		let m = match(sh('/etc/openclash/clash -v 2>/dev/null | head -1').out, /(alpha-[0-9a-z]+|v[0-9.]+[0-9a-z.-]*)/);
		core = m ? m[1] : null;
	}
	let pm = match(sh('(opkg list-installed luci-app-openclash 2>/dev/null; apk list -I luci-app-openclash 2>/dev/null) | head -1').out, /([0-9]+\.[0-9]+\.[0-9]+(-r[0-9]+)?)/);
	return {
		running: !!ver, core, plugin: pm ? pm[1] : null,
		mode: live?.mode ?? cfg.proxy_mode, log_level: live?.['log-level'] ?? cfg.log_level,
		tun: live?.tun?.enable ?? null, mixed_port: live?.['mixed-port'],
		lan_ip: replace(uci_get('network.lan.ipaddr') ?? '', /\/.*/, ''),
		cfg, files, subs: a.subs, dns: a.dns, overwrite: a.overwrite, auth: a.auth,
		jobs: oc_jobs(),
	};
};

P.oc_set = function(a) {
	let c = ucur(), n = 0;
	for (let k, v in (a.set ?? {})) {
		opt_key(k);
		if (v == null || v === '') c.delete('openclash', 'config', k);
		else c.set('openclash', 'config', k, opt_val(v));
		n++;
	}
	if (!n) die('没有要修改的选项');
	c.commit('openclash');
	if (a.restart) restart_openclash_bg();
	return { ok: true, changed: n, restarting: !!a.restart };
};

P.oc_sec = function(a) {
	let c = ucur(), sid = a.sid;
	if (a.op == 'add') {
		if (!OC_SEC_TYPES[a.type]) die('不支持的类型：' + a.type);
		sid = c.add('openclash', a.type);
		if (!sid) die('添加失败');
	} else {
		let t = sid ? c.get('openclash', sid) : null;
		if (!t || !OC_SEC_TYPES[t]) die('找不到这个条目（可能已被删除）');
	}
	let old_name = a.op == 'delete' ? c.get('openclash', sid, 'name') : null;
	if (a.op == 'delete') c.delete('openclash', sid);
	else
		for (let k, v in (a.values ?? {})) {
			opt_key(k);
			if (v == null || v === '') c.delete('openclash', sid, k);
			else c.set('openclash', sid, k, opt_val(v));
		}
	c.commit('openclash');
	let removed = null;
	if (old_name && a.delete_file) {
		let p = '/etc/openclash/config/' + old_name + '.yaml';
		if (stat(p) && uci_get('openclash.config.config_path') != p) { oc_backup_file('config', p); sh('rm -f ' + shq(p)); removed = p; }
	}
	if (a.restart) restart_openclash_bg();
	return { ok: true, sid, removed };
};

P.sub_update = function(a) {
	if (oc_jobs().sub) die('已有订阅正在更新，请稍等');
	bg(sprintf('%s/openclash.sh %s', OC_SH, a.name ? shq(a.name) : ''));
	return { ok: true };
};

P.sub_info = function(a) {
	let s = a.sid ? ucur().get_all('openclash', a.sid) : null;
	if (!s?.address) die('这个订阅没有填写地址');
	let url = trim(split(s.address, '\n')[0]);
	let r = sh(sprintf('curl -sS -L -m 12 -o /dev/null -D - -A %s %s', shq(s.sub_ua || 'clash.meta'), shq(url)));
	let m = match(lc(r.out), /subscription-userinfo:[ \t]*([^\r\n]+)/);
	if (!m) return { ok: false, msg: r.code != 0 ? '订阅地址连接失败' : '这个机场没有提供流量信息' };
	let o = { ok: true };
	for (let kv in split(m[1], ';')) {
		let p = match(trim(kv), /^([a-z]+)=([0-9.e+]+)/);
		if (p) o[p[1]] = +p[2];
	}
	return o;
};

P.files = function(a) {
	let d = OC_FILE_DIRS[a.kind];
	if (!d) die('未知目录：' + a.kind);
	let out = [];
	for (let n in (require('fs').lsdir(d) ?? [])) {
		let st = stat(d + '/' + n);
		if (st?.type == 'file') push(out, { name: n, size: st.size, mtime: st.mtime });
	}
	return { dir: d, files: sort(out, (x, y) => x.name < y.name ? -1 : 1) };
};

P.file_read = function(a) {
	let p = oc_file_path(a.kind, a.name), st = stat(p);
	if (!st) die('文件不存在：' + a.name);
	if (st.size > 3 * 1024 * 1024) die('文件超过 3MB，手机上不方便查看');
	let s = readfile(p) ?? '';
	let bin = false;
	for (let c = 0; c < 9 && !bin; c++) if (index(s, chr(c)) >= 0) bin = true;
	if (bin) return { name: a.name, size: st.size, mtime: st.mtime, binary: true };
	return { name: a.name, size: st.size, mtime: st.mtime, content: s, sum: oc_file_sum(p) };
};
// 文件内容的指纹：面板打开时记下，保存时对一下，防止把别处（原版页面、Claude、别的手机）刚改的内容盖掉
function oc_file_sum(p) { return stat(p) ? trim(split(sh('md5sum ' + shq(p) + ' 2>/dev/null').out, ' ')[0] ?? '') : ''; }

P.file_save = function(a) {
	if (type(a.content) != 'string') die('缺少文件内容');
	// 打开以后文件被别处改过：先不保存，让用户决定（a.overwrite = 确认覆盖）
	if (a.base != null && !a.overwrite && oc_file_sum(oc_file_path(a.kind, a.name)) != a.base)
		die('这个文件在你打开以后被别处改过（原版页面、Claude 或别的手机），为了不把那边的改动盖掉，这次没有保存。');
	if (a.kind == 'custom' && (a.name == 'openclash_custom_rules.list' || a.name == 'openclash_custom_rules_2.list'))
		return { ok: true, msg: T.set_custom_rules({ content: a.content, file: a.name == 'openclash_custom_rules.list' ? 1 : 2, apply: !!a.restart, enable: true, force: !!a.force }) };
	let p = oc_file_path(a.kind, a.name);
	if (a.kind == 'config' && !match(a.name, /\.ya?ml$/)) die('配置文件名必须以 .yaml 结尾');
	if (a.kind == 'config' && !a.force) {
		let tmp = '/tmp/cmcp_cfgtest.yaml';
		writefile(tmp, a.content);
		let r = sh('/etc/openclash/clash -t -d /etc/openclash -f ' + tmp + ' 2>&1 | tail -n 6');
		sh('rm -f ' + tmp);
		if (index(r.out, 'test failed') >= 0 || index(lc(r.out), 'error') >= 0 && index(r.out, 'successful') < 0)
			die('配置文件校验没通过，没有保存：\n' + trim(r.out));
	}
	let b = oc_backup_file(a.kind, p);
	if (writefile(p + '.cmcp_tmp', a.content) == null) die('写入失败');
	rename(p + '.cmcp_tmp', p);
	if (a.kind == 'custom' && match(a.name, /\.sh$/)) sh('chmod 755 ' + shq(p));
	let restarting = false;
	if (a.restart) { restart_openclash_bg(); restarting = true; }
	return { ok: true, backup: b, restarting };
};

P.file_delete = function(a) {
	let p = oc_file_path(a.kind, a.name);
	if (!stat(p)) die('文件不存在');
	if (a.kind == 'custom') die('自定义文件不能删除，可以清空内容');
	if (a.kind == 'config' && uci_get('openclash.config.config_path') == p) die('这是正在使用的配置文件，先切换到其他配置再删除');
	let b = oc_backup_file(a.kind, p);
	sh('rm -f ' + shq(p));
	return { ok: true, backup: b };
};

P.file_rename = function(a) {
	let p = oc_file_path(a.kind, a.name), q = oc_file_path(a.kind, a.to);
	if (a.kind != 'config') die('只能重命名配置文件');
	if (!match(a.to, /\.ya?ml$/)) die('新名字必须以 .yaml 结尾');
	if (!stat(p)) die('文件不存在');
	if (stat(q)) die('已有同名文件');
	rename(p, q);
	let c = ucur(), changed = false;
	if (uci_get('openclash.config.config_path') == p) { c.set('openclash', 'config', 'config_path', q); changed = true; }
	if (changed) c.commit('openclash');
	return { ok: true, active_changed: changed };
};

P.cfg_switch = function(a) {
	let p = oc_file_path('config', a.name);
	if (!stat(p)) die('配置文件不存在');
	let c = ucur();
	c.set('openclash', 'config', 'config_path', p);
	c.set('openclash', 'config', 'enable', '1');
	c.commit('openclash');
	restart_openclash_bg();
	return { ok: true };
};

P.quick = function(a) {
	let act = a.action;
	switch (act) {
	case 'start':
	case 'stop':
	case 'restart': {
		let c = ucur();
		c.set('openclash', 'config', 'enable', act == 'stop' ? '0' : '1');
		c.commit('openclash');
		bg(sprintf('sleep 2; /etc/init.d/openclash %s', act));
		return { ok: true, msg: { start: 'OpenClash 正在启动', stop: 'OpenClash 正在停止', restart: 'OpenClash 正在重启' }[act] };
	}
	case 'flush_dns': {
		let r1 = api('POST', '/cache/fakeip/flush', null, 5), r2 = null;
		try { r2 = api('POST', '/cache/dns/flush', null, 5); } catch (e) {}
		return { ok: true, msg: 'DNS 缓存和 Fake-IP 缓存已清空' };
	}
	case 'update_geo':
		bg(sprintf('for t in ipdb geoip geosite geoasn; do %s/openclash_geo.sh $t; done', OC_SH));
		return { ok: true, msg: 'GEO 数据库开始在后台更新（ipdb、GeoIP、GeoSite、ASN）' };
	case 'update_chnroute':
		bg(OC_SH + '/openclash_chnroute.sh');
		return { ok: true, msg: '大陆白名单开始在后台更新' };
	case 'update_core':
		bg('bash ' + OC_SH + "/openclash_core.sh 'Meta'");
		return { ok: true, msg: '内核开始在后台更新，完成后 OpenClash 会自动重启' };
	case 'update_plugin':
		bg('bash ' + OC_SH + "/openclash_update.sh 'plugin_update'");
		return { ok: true, msg: '插件开始在后台更新，完成后会自动重启' };
	case 'reload_firewall':
		bg('/etc/init.d/openclash reload firewall');
		return { ok: true, msg: '正在重新加载 OpenClash 防火墙规则' };
	case 'clear_log':
		sh(': > /tmp/openclash.log');
		return { ok: true, msg: '插件日志已清空' };
	case 'log_level':
		if (index(['debug', 'info', 'warning', 'error', 'silent'], a.arg) < 0) die('日志级别不对');
		api('PATCH', '/configs', { 'log-level': a.arg });
		return { ok: true, msg: '内核日志级别已改为 ' + a.arg + '（重启后恢复插件设置）' };
	case 'debug': {
		sh(sprintf('timeout 90 %s/openclash_debug.sh >/dev/null 2>&1', OC_SH));
		let t = readfile('/tmp/openclash_debug.log') ?? '';
		return { ok: true, text: length(t) > 200000 ? substr(t, 0, 200000) + '\n…（已截断）' : t };
	}
	case 'restart_dashboard':
		return { ok: true };
	}
	die('未知操作：' + act);
};

P.jobs = function() {
	let t = sh('tail -n 12 /tmp/openclash.log').out;
	return { jobs: oc_jobs(), log: t };
};

P.versions = function(a) {
	let br = uci_get('openclash.config.release_branch') || 'master';
	let r = sh(sprintf("timeout 40 lua -e 'local ov=dofile(\"%s/openclash_version.lua\"); local c=ov.fetch_version_history(\"%s\", %s); print(require(\"luci.jsonc\").stringify(c and c.latest or {}))'",
		OC_SH, replace(br, /[^a-z]/g, ''), a.force ? 'true' : 'false'));
	let latest = {};
	try { latest = json(trim(r.out)); } catch (e) {}
	let st = P.oc_state();
	return { core: st.core, plugin: st.plugin, latest, branch: br };
};

P.myip = function() {
	let d = '/tmp/cmcp_ip';
	const Q = {
		ipip: 'http://myip.ipip.net',
		cn3322: 'http://ip.3322.net',
		ipsb: 'https://api.ip.sb/geoip',
		ipinfo: 'https://ipinfo.io/json',
		cf: 'https://www.cloudflare.com/cdn-cgi/trace',
		// 中文的归属地和运营商，还能看出是不是机房 IP
		ipapi: 'http://ip-api.com/json/?lang=zh-CN&fields=status,query,country,regionName,city,isp,as,hosting,proxy,mobile',
	};
	let cmd = ['rm -rf ' + d, 'mkdir -p ' + d];
	for (let k, u in Q) push(cmd, sprintf("curl -sS -m 8 -A 'Mozilla/5.0 (Linux; Android 14)' %s > %s/%s 2>/dev/null &", shq(u), d, k));
	// IPv6：只走 IPv6 去问，问得到就是有 IPv6
	push(cmd, sprintf("curl -6 -sS -m 6 %s > %s/v6 2>/dev/null &", shq('https://api6.ipify.org'), d));
	sh(join('\n', cmd) + '\nwait');
	let rd = (k) => trim(readfile(d + '/' + k) ?? '');
	let out = { domestic: null, overseas: [], v6: null };
	let t = rd('ipip'), m = match(t, /([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)/), gp = index(t, '来自于');
	if (m) out.domestic = { src: 'IPIP.net', ip: m[1], geo: gp >= 0 ? trim(replace(substr(t, gp + length('来自于')), /^(：|:)/, '')) : '' };
	else if (match(rd('cn3322'), /^[0-9.]+$/)) out.domestic = { src: '3322.net', ip: rd('cn3322'), geo: '' };
	try { let j = json(rd('ipsb')); if (j?.ip) push(out.overseas, { src: 'IP.SB', ip: j.ip, geo: join(' ', filter([j.country, j.region != j.country ? j.region : null, j.city, j.organization ?? j.isp], (x) => x)) }); } catch (e) {}
	try { let j = json(rd('ipinfo')); if (j?.ip) push(out.overseas, { src: 'IPinfo', ip: j.ip, geo: join(' ', filter([j.country, j.region, j.city, j.org], (x) => x)) }); } catch (e) {}
	try {
		let j = json(rd('ipapi'));
		if (j?.status == 'success' && j.query) {
			let kind = j.hosting ? '机房 IP' : j.mobile ? '移动网络' : '家庭宽带';
			push(out.overseas, { src: 'ip-api', ip: j.query, geo: join(' ', filter([j.country, j.regionName != j.country ? j.regionName : null, j.city, j.isp], (x) => x)), kind, asn: j.as ?? null });
		}
	} catch (e) {}
	let v6 = rd('v6');
	if (match(v6, /^[0-9a-fA-F:]+$/) && index(v6, ':') >= 0) out.v6 = v6;
	let cf = rd('cf'), ci = match(cf, /ip=([^\n]+)/), cl = match(cf, /loc=([^\n]+)/), cc = match(cf, /colo=([^\n]+)/);
	if (ci) push(out.overseas, { src: 'Cloudflare', ip: ci[1], geo: (cl ? cl[1] : '') + (cc ? ' · 机房 ' + cc[1] : '') });
	sh('rm -rf ' + d);
	return out;
};

P.site_check = function(a) {
	// 子账号只能测内置的这几个网站（自定义地址能让路由器去访问家里内网的地址，只给主账号）
	let sites = (ROLE != 'sub' ? a.sites : null) ?? [
		{ key: 'baidu', url: 'https://www.baidu.com' }, { key: 'taobao', url: 'https://www.taobao.com' },
		{ key: 'google', url: 'https://www.google.com/generate_204' }, { key: 'github', url: 'https://github.com' },
		{ key: 'youtube', url: 'https://www.youtube.com' }, { key: 'claude', url: 'https://claude.ai' },
	];
	let d = '/tmp/cmcp_site', cmd = ['rm -rf ' + d, 'mkdir -p ' + d], i = 0;
	for (let s in sites) {
		if (!match(s.url ?? '', /^https?:\/\/[A-Za-z0-9.:\/_?=&%-]+$/)) die('地址不合法：' + s.url);
		push(cmd, sprintf("curl -sk -o /dev/null -m 8 -A 'Mozilla/5.0' -w '%%{http_code} %%{time_connect} %%{time_starttransfer}' %s > %s/%d 2>/dev/null &", shq(s.url), d, i++));
	}
	sh(join('\n', cmd) + '\nwait');
	let out = [];
	i = 0;
	for (let s in sites) {
		let p = split(trim(readfile(d + '/' + (i++)) ?? ''), ' ');
		let code = +p[0] || 0;
		push(out, { key: s.key, url: s.url, ok: code > 0 && code < 500, code, ms: code ? int((+p[2] || +p[1] || 0) * 1000 + 0.5) : null });
	}
	sh('rm -rf ' + d);
	return { sites: out };
};

P.unlock = function(a) {
	let list = a.services;
	if (type(list) != 'array' || !length(list)) list = split(uci_get('openclash.config.unlock_check_services') || 'netflix,ytb,openai,claude', ',');
	let d = '/tmp/cmcp_unlock', cmd = ["rm -rf " + d, "mkdir -p " + d], ks = [];
	for (let k in list) {
		k = trim(k);
		if (!UNLOCK_LABELS[k] || index(ks, k) >= 0) continue;
		push(ks, k);
		push(cmd, sprintf('timeout 60 lua %s/openclash_streaming_unlock.lua %s check > %s/%s 2>/dev/null &', OC_SH, shq(UNLOCK_LABELS[k]), d, k));
	}
	if (!length(ks)) die('没有可检测的服务');
	sh(join('\n', cmd) + '\nwait');
	// 同时检测时偶尔会有个别服务失败（互相抢资源），失败的再单独测一次
	let rd = (k) => { let r = null; for (let l in split(readfile(d + '/' + k) ?? '', '\n')) if (match(l, /^\{/)) try { r = json(l); } catch (e) {} return r; };
	for (let k in ks) if (!(+(rd(k)?.st) > 0)) sh(sprintf('timeout 30 lua %s/openclash_streaming_unlock.lua %s check > %s/%s 2>/dev/null', OC_SH, shq(UNLOCK_LABELS[k]), d, k));
	let out = [];
	for (let k in ks) {
		let r = rd(k);
		push(out, { key: k, label: UNLOCK_LABELS[k], st: r?.st ?? 0, region: r?.region, node: r?.node });
	}
	sh('rm -rf ' + d);
	return { results: out, all: keys(UNLOCK_LABELS) };
};

P.providers = function() {
	let px = {}, rs = {};
	try { px = api('GET', '/providers/proxies')?.providers ?? {}; } catch (e) {}
	try { rs = api('GET', '/providers/rules')?.providers ?? {}; } catch (e) {}
	let out = { proxies: [], rules: [] };
	for (let n, p in px) {
		if (p.vehicleType == 'Compatible' || n == 'default') continue;
		push(out.proxies, { name: n, vehicle: p.vehicleType, updated: p.updatedAt, count: length(p.proxies ?? []), info: p.subscriptionInfo });
	}
	for (let n, p in rs)
		push(out.rules, { name: n, behavior: p.behavior, format: p.format, vehicle: p.vehicleType, updated: p.updatedAt, count: p.ruleCount });
	return out;
};

P.provider_update = function(a) {
	if (a.kind != 'proxies' && a.kind != 'rules') die('kind 只能是 proxies / rules');
	if (!a.name) die('缺少名称');
	if (a.health) api('GET', '/providers/proxies/' + urlenc(a.name) + '/healthcheck', null, 60);
	else api('PUT', '/providers/' + a.kind + '/' + urlenc(a.name), null, 60);
	return { ok: true };
};

P.rules = function(a) {
	let list = api('GET', '/rules')?.rules ?? [], kw = a.filter ? lc(a.filter) : null, out = [], i = 0;
	for (let r in list) {
		i++;
		if (kw && index(lc((r.type ?? '') + ' ' + (r.payload ?? '') + ' ' + (r.proxy ?? '')), kw) < 0) continue;
		push(out, { i, type: r.type, payload: r.payload, proxy: r.proxy, size: r.size });
	}
	let off = +a.offset || 0, lim = +a.limit || 200;
	return { total: length(list), matched: length(out), rules: slice(out, off, off + lim) };
};

P.backup = function(a) {
	let f = '/tmp/cmcp_backup.tar.gz';
	sh(sprintf('cd / && tar -czf %s etc/config/openclash etc/openclash/config etc/openclash/custom etc/openclash/overwrite 2>/dev/null', f));
