// 读 opkg 的 status / apk 的 installed：每个包一段，空行分开
function app_blocks(f) { return filter(split(readfile(APP_ROOT + f) ?? '', /\n\n+/), (b) => length(trim(b))); }
function app_kv(b, sep) {
