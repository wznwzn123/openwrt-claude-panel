		let ok = false; for (let p in sp_apps()) if (p[0] == x.id) ok = true;
		if (!ok) die('没有这个软件');
		if (t) o.app[x.id] = t; else delete o.app[x.id];
	} else {
		let ok = false; for (let p in SP_GEO) if (p[0] == x.id) ok = true;
