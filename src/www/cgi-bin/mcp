}
function sp_unpin(mac) {
	for (let s in (uci_load('dhcp') ?? [])) if (s['.type'] == 'host' && s.cmcp_split == '1' && lc(s.mac ?? '') == mac) {
		sh(sprintf('%s delete %s && %s commit dhcp', conf().uci, shq('dhcp.' + s['.name']), conf().uci));
