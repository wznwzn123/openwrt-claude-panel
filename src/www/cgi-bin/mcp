P.feedback_diag = function() { return { text: fb_diag(), hosted: !!hub_conf(true)?.HUB }; };
// 「@global[0]」这种匿名节：换成真正的节名
function px_sec(c, cfg, s) {
	let m = match(s, /^@([a-z_]+)\[([0-9]+)\]$/);
	if (!m) return s;
	let i = 0, out = null;
	c.foreach(cfg, m[1], (x) => { if (i++ == +m[2]) { out = x['.name']; return false; } });
