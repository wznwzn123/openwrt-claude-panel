#!/bin/sh
# 把路由器配置备份到 Cloudflare（每天凌晨 4:07 自动，云端只留最近 10 份；面板里也能点「立即备份」）
# 内容 = 系统升级时会保留的全部文件（所有设置、OpenClash 配置和规则、面板），去掉能重新下载的大文件（内核、GEO 数据库）
# 上传前在路由器上加密（AES-256-CBC + HMAC-SHA256，用 openssl），密钥只在路由器上（$D/bk.key），云端只存看不懂的密文；
# 下载、还原时路由器先校验再解密，解出来和 LuCI「备份/升级」导出的格式一样
# 路由器上没有 openssl、也装不上：不上传（不会再把没加密的备份存到云端）
# 用法：cmcp-backup [auto|manual]
#       cmcp-backup decrypt 输入 输出    解密云端下载的备份（校验不过、不是加密格式都会失败）
#       cmcp-backup encrypt 输入 输出    （测试用）
# 测试用环境变量：BK_DIR（代替 /etc/claude-mcp）、BK_NOINSTALL=1（不自动装 openssl）、BK_PATH（放在 PATH 最前面的假命令目录）、
#                 BK_SSL（openssl 命令名，测「没有 openssl」用）、BK_NOTIFY（通知命令）
D=${BK_DIR:-/etc/claude-mcp}
KEY=$D/bk.key   # 两行：加密密钥、校验密钥（各 64 位十六进制），只在这台路由器上
MAGIC=CMCPBK1
export PATH=${BK_PATH:+$BK_PATH:}/usr/sbin:/usr/bin:/sbin:/bin:$PATH
SSL=${BK_SSL:-openssl}
NOTIFY=${BK_NOTIFY:-/usr/sbin/cmcp-notify}

have_ssl() { command -v "$SSL" >/dev/null 2>&1; }
# 没有 openssl：装一下（每次开机最多试一次，装不上就不再试，免得每天都去连软件源）
get_ssl() {
	have_ssl && return 0
	[ "$BK_NOINSTALL" = 1 ] && return 1
	[ -f /tmp/cmcp_bk_sslinst ] && return 1
	touch /tmp/cmcp_bk_sslinst
	# 闪存剩下不到 4MB 就不装（没有 OpenSSL 库的系统要连库一起装，大约 2MB）
	[ "$( { df -k /overlay 2>/dev/null || df -k /; } | awk 'NR==2{print $4}')" -ge 4096 ] 2>/dev/null || return 1
	if command -v opkg >/dev/null 2>&1; then { opkg update && opkg install openssl-util; } >/dev/null 2>&1
	elif command -v apk >/dev/null 2>&1; then { apk update && apk add openssl-util; } >/dev/null 2>&1; fi
	have_ssl
}
hex() { echo "$1" | grep -qxE "[0-9a-f]{$2}"; }
mkkey() {
	[ -s "$KEY" ] && return 0
	local a b
	a=$($SSL rand -hex 32) && b=$($SSL rand -hex 32) && hex "$a" 64 && hex "$b" 64 || return 1
	( umask 077; printf '%s\n%s\n' "$a" "$b" > "$KEY.tmp" ) && mv -f "$KEY.tmp" "$KEY"
}
ek() { sed -n 1p "$KEY"; }
mk() { sed -n 2p "$KEY"; }
mac() { $SSL dgst -sha256 -mac HMAC -macopt hexkey:"$(mk)" | sed 's/.*= *//'; }
keyok() { [ -s "$KEY" ] && hex "$(ek)" 64 && hex "$(mk)" 64; }

# 加密后的文件：第一行「CMCPBK1 IV 校验值」，后面是密文；校验值 = HMAC(第一行前半段 + 密文)
encrypt() {
	local iv m
	keyok || return 1
	iv=$($SSL rand -hex 16) && hex "$iv" 32 || return 1
	$SSL enc -aes-256-cbc -K "$(ek)" -iv "$iv" -in "$1" -out "$2.ct" || { rm -f "$2.ct"; return 1; }
	m=$( { echo "$MAGIC $iv"; cat "$2.ct"; } | mac )
	hex "$m" 64 || { rm -f "$2.ct"; return 1; }
	{ echo "$MAGIC $iv $m"; cat "$2.ct"; } > "$2"
	rm -f "$2.ct"
}
# 返回：0 成功；2 不是加密格式（旧备份）；3 校验没通过（被改过，或者不是这台路由器的密钥）；1 其他错误
decrypt() {
	local m iv want got hl
	[ -f "$1" ] || return 1
	read -r m iv want < "$1"
	[ "$m" = "$MAGIC" ] || return 2
	hex "$iv" 32 && hex "$want" 64 || return 3
	keyok || return 3
	hl=$(head -n1 "$1" | wc -c)
	tail -c +$((hl + 1)) "$1" > "$2.ct"
	got=$( { echo "$MAGIC $iv"; cat "$2.ct"; } | mac )
	[ "$got" = "$want" ] || { rm -f "$2.ct"; return 3; }
	$SSL enc -d -aes-256-cbc -K "$(ek)" -iv "$iv" -in "$2.ct" -out "$2" || { rm -f "$2.ct" "$2"; return 1; }
	rm -f "$2.ct"
}

case "$1" in
	decrypt) have_ssl || exit 1; decrypt "$2" "$3"; exit $? ;;
	encrypt) have_ssl || exit 1; mkkey && encrypt "$2" "$3"; exit $? ;;
esac

[ -f "$D/cloud.conf" ] || { echo "没有配置云端"; exit 1; }
# 自动处理里关掉了「云端自动备份」：每天 4:07 不再备份；面板里点「立即备份」照样能用
[ "$1" = auto ] && [ -f "$D/off.cloudbackup" ] && { echo "自动备份已关掉"; exit 0; }
. "$D/cloud.conf"
mkdir /tmp/cmcp_bk.lock 2>/dev/null || { echo "已经在备份了"; exit 1; }
trap 'rm -rf /tmp/cmcp_bk.lock /tmp/cmcp_bk.tgz /tmp/cmcp_bk.enc /tmp/cmcp_bk.list' EXIT
kind=${1:-manual}
fail() { echo "$1"; [ "$kind" = auto ] && $NOTIFY warn backup "云端自动备份失败" "$1"; exit 1; }
get_ssl || fail "这台路由器没有 openssl 加密工具，自动安装也没成功，为了不把没加密的设置存到云端，这次没有备份。可以在路由器后台「系统 → 软件包」里装 openssl-util，装好后就能备份了"
mkkey || fail "生成备份密钥失败"
{ sysupgrade -l 2>/dev/null; find /www-claude-mcp -type f 2>/dev/null; } | \
	grep -v -E '^/etc/openclash/(core|history|cache\.db|.*\.(dat|mmdb|metadb|db))' | \
	grep -v -E '/etc/claude-mcp/(bak/|.*\.bak$|panel-index\.before-|traffic/)' | \
	grep -v -E '\.(dat|mmdb|metadb)$' | sort -u > /tmp/cmcp_bk.list
tar czf /tmp/cmcp_bk.tgz -T /tmp/cmcp_bk.list 2>/dev/null
sz=$(wc -c < /tmp/cmcp_bk.tgz)
[ "$sz" -gt 1000 ] || { echo "打包失败"; exit 1; }
[ "$sz" -lt 20000000 ] || { echo "备份太大（$sz 字节）"; exit 1; }
encrypt /tmp/cmcp_bk.tgz /tmp/cmcp_bk.enc || fail "加密备份失败"
name="$(uci -q get system.@system[0].hostname || echo router)-$(date +%Y%m%d-%H%M)"
r=$(curl -s -m 120 -X POST -H 'Content-Type: application/octet-stream' --data-binary @/tmp/cmcp_bk.enc "$URL/bk/$RKEY?name=$name&kind=$kind&enc=1&files=$(wc -l < /tmp/cmcp_bk.list)")
case "$r" in
	*'"ok":true'*)
		date +%s > "$D/backup_last"
		# 云端认得「加密」标记（新版 Worker 会在回复里带 "enc":true）：把以前没加密的旧备份删掉
		case "$r" in *'"enc":true'*)
			l=$(curl -s -m 20 "$URL/bk/$RKEY")
			case "$l" in *'"ok":true'*)
				for id in $(echo "$l" | sed 's/},{/}\
{/g' | grep -v '"enc":true' | sed -n 's/.*"id":"\([a-z0-9]\{4,16\}\)".*/\1/p'); do
					curl -s -m 20 -X DELETE "$URL/bk/$RKEY/$id" >/dev/null
				done ;;
			esac ;;
		esac
		echo "$r" ;;
	*) fail "上传失败：$r" ;;
esac
