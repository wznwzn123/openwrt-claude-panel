}
/* 通知（4.0）：路由器上的断线/故障记录、公告、反馈进度一次给面板；云端的（断电、托管服务）面板自己去云端拿。
   看到哪儿了记在 notices.seen（t：这个时间以前的都看过了；pop：弹过的重要公告），换手机打开也一样。
   6.0 第 85 项：since：从什么时候开始记（新装的路由器只弹 since 前 7 天以内发的重要公告）；upd：弹过的新版本（每个版本只弹一次） */
const NT_SEEN = ETC + '/notices.seen'; // 路由器上就是 /etc/claude-mcp/notices.seen（ETC 在测试时可以换目录）
function nt_seen() {
	let s = null; try { s = json(readfile(NT_SEEN) ?? 'null'); } catch (e) {}
