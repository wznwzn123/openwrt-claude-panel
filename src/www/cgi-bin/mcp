/* ---------------- 6.0 第 20 项：每台设备限速 ----------------
 * 设置存 /etc/claude-mcp/ratelimit.json（按 MAC），规则由 cmcp-ratelimit 生成（fw4 / fw3 都行，见那个脚本）；看门狗每 30 秒跟着设备的 IP 更新。
 * 子账号只能限自己名下的设备（own_check）。 */
const RL_F = ETC + '/ratelimit.json';
function rl_caps() {
	let c = null;
	try { c = json(trim(sh(SBIN + '/cmcp-ratelimit caps').out)); } catch (e) {}
	return type(c) == 'object' ? c : { ok: false, why: '路由器上的限速程序没装好，先一键更新' };
}
function rl_read() { let o = cmcp_readj(RL_F, {}); return type(o) == 'object' ? o : {}; }
P.rl_get = function() {
	let o = rl_read();
	if (own_only()) { let mine = own_mine(); for (let k in keys(o)) if (!mine[k]) delete o[k]; }
	return { devs: o, caps: rl_caps() };
};
// a: { mac, down, up（kbit/s，0 = 不限）, name }
P.rl_set = function(a) {
	let mac = lc(trim('' + (a?.mac ?? '')));
	if (!match(mac, /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/)) die('这台设备读不到 MAC 地址，没法限速');
	own_check(mac);
	let n = (v, what) => {
		v = +(v ?? 0);
		if (v != v || v < 0) die(what + '不对');
		if (v > 0 && v < 100) die(what + '最小 0.1 Mbps');
		if (v > 10000000) die(what + '最大 10000 Mbps');
		return +sprintf('%.0f', v);
	};
	let down = n(a?.down, '下载上限'), up = n(a?.up, '上传上限'), o = rl_read();
	if (down || up) {
		let c = rl_caps();
		if (!c.ok) compat_die('ratelimit', c.why);
		o[mac] = { down, up, name: substr(replace('' + (a?.name ?? ''), /[[:cntrl:]<>"]/g, ''), 0, 40) || null };
	} else delete o[mac];
	cmcp_writej(RL_F, o);
	sh(SBIN + '/cmcp-ratelimit apply >/dev/null 2>&1');
	return P.rl_get();
};
/* ---------------- 6.0 第 26 项：局域网深度扫描（找出没走 DHCP、手动设了 IP 的设备） ----------------
 * 用户 11/26 定：设备页点「扫描」才扫，不定时扫。只扫家里网段（太大的网段只扫路由器所在的那个 /24）：
 * 对每个地址 ping 一下（设备不回 ping 也会回 ARP），然后看 ARP 表；DHCP 里没有的记进 scan.json，设备列表里一直留着（30 天没再见到就删）。
 * 一次最多同时 64 个 ping，小内存路由器也扛得住。 */
P.lan_scan = function() {
	if (own_only()) die('只有能看所有设备的家人能扫描');
	let lan = pf_lan();
	if (!lan) die('没有家里网络（lan）的设置');
	let pl = lan.pl, base, size, part = null;
	if (pl < 22) { pl = 24; part = true; }
	size = pow2(32 - pl); base = v4int(lan.ip) - v4int(lan.ip) % size;
	let ips = [];
	for (let i = 1; i < size - 1; i++) { let ip = ls_int2ip(base + i); if (ip != lan.ip) push(ips, ip); }
	let pb = getenv('CMCP_PING') || 'ping';
	for (let i = 0; i < length(ips); i += 64) {
		let c = [];
		for (let ip in slice(ips, i, i + 64)) push(c, sprintf('%s -c 1 -W 1 %s >/dev/null 2>&1 &', pb, ip));
		sh(join(' ', c) + ' wait');
	}
	let leases = lease_map(), known = {}, sc = cmcp_readj(SCAN_F, {}), now = time(), found = 0, fresh = [];
	if (type(sc) != 'object') sc = {};
	for (let ip, l in leases) if (l.mac) known[l.mac] = 1;
	for (let l in split(readfile(ARP_F) ?? '', '\n')) {
		let m = match(l, /^(\d+\.\d+\.\d+\.\d+)\s+\S+\s+(0x\S+)\s+([0-9a-fA-F:]{17})\s+\S+\s+(\S+)/);
		if (!m || m[2] == '0x0' || m[3] == '00:00:00:00:00:00' || !cidr_has(lan.ip, lan.pl, m[1]) || m[1] == lan.ip) continue;
		found++;
		let mac = lc(m[3]);
		if (known[mac]) continue;
		if (!sc[mac]) push(fresh, { ip: m[1], mac, name: CL.dev_label(mac, null) });
		sc[mac] = { ip: m[1], at: now };
	}
	for (let mac in keys(sc)) if (type(sc[mac]) != 'object' || now - (+sc[mac].at || 0) > 30 * 86400 || known[mac]) delete sc[mac];
	cmcp_writej(SCAN_F, sc);
	return { found, fresh, range: ls_int2ip(base) + '/' + pl, part };
};
/* ---------------- 6.0 第 31、35 项：定时重启、定时关 Wi-Fi、手动关机 ----------------
 * 用户 11/26 定：定时开关机改成「定时重启 + 定时关 Wi-Fi」，关机只做手动按钮（写清「关了要拔插电源才能开」）。
 * 设置存 /etc/claude-mcp/sched.json，写进计划任务（/etc/crontabs/root，行尾带 # cmcp-sched，只动自己的行），时间按路由器的时区。
 * 只有主账号能设（sched_set、poweroff 不在任何权限组里）；大家都能看（sched_get 在 view 组）。 */
const SC_F = ETC + '/sched.json', SC_CRON = getenv('CMCP_CRONTAB') || '/etc/crontabs/root', SC_TAG = '# cmcp-sched';
function sc_read() { let o = cmcp_readj(SC_F, {}); return type(o) == 'object' ? o : {}; }
function sc_hm(s, what) { let m = match('' + (s ?? ''), /^([01][0-9]|2[0-3]):([0-5][0-9])$/); if (!m) die(what + '不对，比如 04:00'); return [+m[2], +m[1]]; }
function sc_days(d) {
	let o = [];
	for (let x in (type(d) == 'array' ? d : [])) if (+x >= 0 && +x <= 6 && index(o, +x) < 0) push(o, +x);
	if (!length(o)) die('至少选一天');
	return sort(o, (a, b) => a - b);
}
function sc_cron(o) {
	let old = split(readfile(SC_CRON) ?? '', '\n'), out = filter(old, (l) => length(l) && index(l, SC_TAG) < 0);
	let dw = (d) => length(d) == 7 ? '*' : join(',', d);
	if (o.reboot?.on) { let t = sc_hm(o.reboot.at, '时间'); push(out, sprintf('%d %d * * %s %s/cmcp-sched reboot %s', t[0], t[1], dw(o.reboot.days), SBIN, SC_TAG)); }
	if (o.wifi?.on) {
		let a = sc_hm(o.wifi.off, '关的时间'), b = sc_hm(o.wifi.on_at, '开的时间');
		push(out, sprintf('%d %d * * %s %s/cmcp-sched wifioff %s', a[0], a[1], dw(o.wifi.days), SBIN, SC_TAG));
		push(out, sprintf('%d %d * * * %s/cmcp-sched wifion %s', b[0], b[1], SBIN, SC_TAG));
	}
	writefile(SC_CRON + '.tmp', join('\n', out) + '\n');
	rename(SC_CRON + '.tmp', SC_CRON);
	let f = getenv('CMCP_NG_RUN');
	bg(f ? 'echo /etc/init.d/cron restart >> ' + shq(f) : '/etc/init.d/cron restart');
}
P.sched_get = function() {
	let o = sc_read();
	return { reboot: o.reboot ?? { on: false, days: [0, 1, 2, 3, 4, 5, 6], at: '04:00' }, wifi: o.wifi ?? { on: false, days: [0, 1, 2, 3, 4, 5, 6], off: '23:30', on_at: '07:00' }, sta: !!match(readfile(ucdir() + '/wireless') ?? '', /option mode '?sta'?/), owner: ROLE == 'owner' };
};
// a: { reboot: { on, days, at } } 或 { wifi: { on, days, off, on_at } }
P.sched_set = function(a) {
	let o = sc_read();
	if (a?.reboot) { let r = a.reboot; o.reboot = { on: !!r.on, days: sc_days(r.days ?? [0, 1, 2, 3, 4, 5, 6]), at: r.at ?? '04:00' }; sc_hm(o.reboot.at, '时间'); }
	if (a?.wifi) {
		let w = a.wifi;
		if (w.on && !stat(ucdir() + '/wireless')) die('这台路由器没有无线');
		o.wifi = { on: !!w.on, days: sc_days(w.days ?? [0, 1, 2, 3, 4, 5, 6]), off: w.off ?? '23:30', on_at: w.on_at ?? '07:00' };
		sc_hm(o.wifi.off, '关的时间'); sc_hm(o.wifi.on_at, '开的时间');
		if (o.wifi.off == o.wifi.on_at) die('关和开不能是同一个时间');
	}
	cmcp_writej(SC_F, o);
	sc_cron(o);
	return P.sched_get();
};
// 手动关机：关了要拔插电源才能开
P.poweroff = function(a) {
	if (a?.confirm != 'OFF') die('需要确认');
	try { sh(sprintf('%s/cmcp-notify warn sched %s %s sched >/dev/null 2>&1', SBIN, shq('路由器关机了'), shq('要拔插电源才能开。'))); } catch (e) {}
	let f = getenv('CMCP_NG_RUN');
	bg(f ? 'echo poweroff >> ' + shq(f) : 'sleep 2; poweroff');
	return { ok: true };
};
/* ---------------- 6.0 第 32 项：常用服务——文件共享（Samba / ksmbd）、FTP、SSH、指示灯 ----------------
 * 手机上开关这些服务。开 FTP、改 SSH 时说清楚风险；SSH 默认只对家里局域网开放；外网能连（防火墙放行了端口）的标出来。
 * 共享：Samba 4（samba4）、Samba 3.6（samba）、ksmbd 都认；只能共享 /mnt、/media、/data、/srv 下面的文件夹。
 * 指示灯：/sys/class/leds 下所有的灯；关的时候记下原来的状态，并写进 system 配置（cmcp_led_N），重启后也是关的；开的时候删掉、还原。
 * 只有主账号能用（这几个方法不在任何权限组里）。
 * 测试用：CMCP_SS_ROOT（假的根目录，放 etc/init.d、sys/class/leds、etc/vsftpd.conf、proc/mounts…） */
const SS_ROOT = getenv('CMCP_SS_ROOT') || '', SS_LED_F = ETC + '/led.json';
const SS_SHARE_DIR = /^\/(mnt|media|data|srv)\/[^\n]+$/;
function ss_init(n) { let f = SS_ROOT + '/etc/init.d/' + n; return stat(f) ? f : null; }
function ss_on(n) { let f = ss_init(n); return !!f && sh(shq(f) + ' enabled >/dev/null 2>&1').code == 0; }
function ss_run(n, procs) {
	let f = ss_init(n);
	if (f && sh(shq(f) + ' running >/dev/null 2>&1').code == 0) return true;
	if (SS_ROOT) return false;
	for (let p in procs) if (length(trim(sh('pidof ' + p + ' 2>/dev/null').out ?? ''))) return true;
	return false;
}
function ss_do(n, act) { let f = ss_init(n); if (f) sh(shq(f) + ' ' + act + ' >/dev/null 2>&1'); }
// 软件源里有没有（null = 还没读过软件列表）
function ss_pkg(names) {
	let pm = app_pm();
	if (!pm) return false;
	let I = st_index(pm);
	if (I.age == null) return null;
	for (let n in names) if (I.idx[n]) return n;
	return false;
}
// 外网能不能连到路由器的这个端口：wan 区域入站全放行，或者有放行这个端口的通信规则
function ss_wan(port) {
	let fw = uci_load('firewall') ?? [];
	for (let s in fw) if (s['.type'] == 'zone' && s.name == 'wan' && uc('' + (s.input ?? '')) == 'ACCEPT') return true;
	for (let s in fw) {
		if (s['.type'] != 'rule' || s.enabled == '0' || s.src != 'wan' || s.dest || uc('' + (s.target ?? '')) != 'ACCEPT') continue;
		let pr = lc(join(' ', as_list(s.proto ?? 'tcp udp')));
		if (!match(pr, /tcp|all/)) continue;
		for (let p in as_list(s.dest_port)) {
			let m = match('' + p, /^([0-9]+)([-:]([0-9]+))?$/);
			if (m && +port >= +m[1] && +port <= +(m[3] ?? m[1])) return true;
		}
	}
	return false;
}
function ss_uci(cfg, cmds) {
	if (!length(cmds)) return;
	let U = conf().uci, r = sh(join(' && ', map(cmds, (c) => U + ' ' + c)) + ' && ' + U + ' commit ' + cfg);
	if (r.code != 0) die('保存失败：' + trim(r.err ?? r.out ?? ''));
}
// ---- 文件共享 ----
function smb_kind() {
	if (ss_init('samba4')) return { k: 'samba4', cfg: 'samba4', st: 'sambashare', gl: 'samba' };
	if (ss_init('ksmbd')) return { k: 'ksmbd', cfg: 'ksmbd', st: 'share', gl: 'globals' };
	if (ss_init('samba')) return { k: 'samba', cfg: 'samba', st: 'sambashare', gl: 'samba' };
	return null;
}
function ss_disks() {
	let out = [];
	for (let l in split(readfile(SS_ROOT + '/proc/mounts') ?? '', '\n')) {
		let w = split(l, ' '), mp = replace(w[1] ?? '', /\\040/g, ' ');
		if (match(mp, SS_SHARE_DIR) && index(out, mp) < 0 && !match(w[2] ?? '', /^(tmpfs|proc|sysfs|overlay|squashfs)$/)) push(out, mp);
	}
	return slice(out, 0, 20);
}
function smb_get() {
	let K = smb_kind();
	if (!K) return { kind: null, pkg: ss_pkg(['luci-app-samba4', 'luci-app-ksmbd', 'samba4-server', 'ksmbd-server']) };
	let c = uci_load(K.cfg) ?? [], shares = [], ifs = [];
	for (let s in c) {
		if (s['.type'] == K.st) push(shares, { id: s['.name'], name: s.name ?? '', path: s.path ?? '', ro: s.read_only == 'yes', guest: s.guest_ok != 'no' });
		if (s['.type'] == K.gl) ifs = as_list(s.interface ?? 'lan');
	}
	return { kind: K.k, name: K.k == 'ksmbd' ? 'ksmbd' : 'Samba', on: ss_on(K.k), run: ss_run(K.k, ['smbd', 'ksmbd.mountd']), lan: !length(ifs) || (length(ifs) == 1 && ifs[0] == 'lan'), wan: ss_wan(445), shares, disks: ss_disks() };
}
// ---- FTP ----
function ftp_kind() { for (let k in ['vsftpd', 'pure-ftpd', 'proftpd']) if (ss_init(k)) return k; return null; }
function ftp_get() {
	let k = ftp_kind();
	if (!k) return { kind: null, pkg: ss_pkg(['luci-app-vsftpd', 'vsftpd']) };
	return { kind: k, on: ss_on(k), run: ss_run(k, [k == 'pure-ftpd' ? 'pure-ftpd' : k]), wan: ss_wan(21) };
}
// ---- SSH ----
function ssh_keys() { let n = 0; for (let l in split(readfile(SS_ROOT + '/etc/dropbear/authorized_keys') ?? '', '\n')) if (match(l, /^(ssh-|ecdsa-|sk-)/)) n++; return n; }
function ssh_db() { for (let s in (uci_load('dropbear') ?? [])) if (s['.type'] == 'dropbear') return s; return null; }
function ssh_get() {
	if (ss_init('dropbear')) {
		let s = ssh_db() ?? {}, port = +(s.Port ?? 22) || 22, pw = !match('' + (s.PasswordAuth ?? 'on'), /^(off|0|no)$/);
		return { kind: 'dropbear', on: ss_on('dropbear') && s.enable != '0', run: ss_run('dropbear', ['dropbear']), port, lan: s.Interface == 'lan', pw, keys: ssh_keys(), wan: ss_wan(port), sec: s['.name'] ?? null };
	}
	if (ss_init('sshd')) {
		let m = match(readfile(SS_ROOT + '/etc/ssh/sshd_config') ?? '', /(^|\n)[ \t]*Port[ \t]+([0-9]+)/), port = m ? +m[2] : 22;
		return { kind: 'openssh', on: ss_on('sshd'), run: ss_run('sshd', ['sshd']), port, wan: ss_wan(port) };
	}
