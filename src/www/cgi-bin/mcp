		push(r.hops, { n: +x[1], ip: ip ? ip[1] : null, ms: ms ? +ms[1] : null });
	}
	if (!length(r.hops)) die('路由追踪没有结果：' + substr(trim(t), 0, 200));
	let last = r.hops[length(r.hops) - 1];
	r.done = !!(r.ip && last.ip == r.ip);
	r.fake = !!(r.ip && match(r.ip, ND_FAKE));
	return r;
}
function nd_dns(addr) {
	if (match(addr, /^[0-9.]+$/) || match(addr, /:/)) die('域名查询只能输入域名');
	if (!nd_has('nslookup')) die('不能查询域名：固件没带 nslookup');
	let o = sh('timeout 15 ' + ND_BIN + 'nslookup ' + shq(addr)), t = o.out ?? '';
	let r = { tool: 'dns', addr, server: null, ips: [], cname: [] };
	let m = match(t, /Server:[ \t]*([^ \t\n]+)/);
	if (m) r.server = m[1];
	let ans = false;
	for (let l in split(t, '\n')) {
		if (match(l, /^Name:/)) { ans = true; continue; }
		let c = match(l, /canonical name = ([^ \t]+)$/);
		if (c) { let cn = replace(c[1], /\.$/, ''); if (index(r.cname, cn) < 0) push(r.cname, cn); continue; }
		let a = match(l, /^Address( [0-9]+)?:[ \t]*([0-9A-Fa-f.:]+)/);
		if (a && ans) { let ip = replace(a[2], /#.*$/, ''); if (index(r.ips, ip) < 0) push(r.ips, ip); }
	}
	if (!length(r.ips)) {
		if (match(t, /NXDOMAIN|can't find|can't resolve|not found/i)) die('找不到「' + addr + '」：这个域名不存在');
		die('查不到「' + addr + '」：' + (length(trim(t)) ? substr(trim(t), -200) : '路由器的 DNS 没有回应'));
	}
	r.fake = length(filter(r.ips, (ip) => match(ip, ND_FAKE))) > 0;
	return r;
}
// 6.0 第 33 项：路由表（只看）。主表里的 IPv4、IPv6（不列 fe80 链路本地、组播）
function nd_route() {
	if (!nd_has('ip')) die('读不了路由表：固件没带 ip 命令');
	let out = { v4: [], v6: [] };
	for (let f in ['4', '6']) {
		let txt = sh(ND_BIN + 'ip -' + f + ' route show 2>/dev/null').out ?? '';
		for (let l in split(txt, '\n')) {
			let w = split(trim(l), /[ \t]+/);
			if (!length(w[0]) || match(w[0], /^(fe80|ff00|multicast|broadcast|local|anycast)/)) continue;
			let typ = null;
			if (index(['unreachable', 'blackhole', 'prohibit', 'throw'], w[0]) >= 0) { typ = w[0]; w = slice(w, 1); }
			let r = { dst: w[0] == 'default' ? 'default' : w[0], type: typ };
			for (let i = 1; i < length(w) - 1; i++) {
				if (w[i] == 'via') r.via = w[i + 1];
				else if (w[i] == 'dev') r.dev = w[i + 1];
				else if (w[i] == 'metric') r.metric = +w[i + 1];
				else if (w[i] == 'proto') r.proto = w[i + 1];
				else if (w[i] == 'src') r.src = w[i + 1];
			}
			if (length(out['v' + f]) < 200) push(out['v' + f], r);
		}
	}
	return { tool: 'route', ...out };
}
P.netdiag = function(a) {
	if (a?.tool == 'route') return nd_route();
	let addr = nd_addr(a?.addr), t = a?.tool;
	if (t == 'ping') return nd_ping(addr);
	if (t == 'trace') return nd_trace(addr);
	if (t == 'dns') return nd_dns(addr);
	die('不支持的诊断');
};
P.netdiag_caps = function() {
	return { ping: nd_has('ping'), trace: nd_has('traceroute'), dns: nd_has('nslookup'), route: nd_has('ip') };
};

/* ---------------- 6.0 第 18 项：端口转发 ----------------
 * 手机上增删改端口转发（防火墙的 redirect，fw3 / fw4 都是同一份 uci 配置）。
 * 安全：不让把路由器自己的管理端口（网页后台、SSH、面板局域网入口）转出去，也不让转到路由器自己；
 * 目标只能是家里局域网里的设备；改完走「90 秒确认」（cmcp-netguard），不点「保留」自动改回去，并推送。
 * 面板新建的规则名字叫 cmcp_pf_xxxxxx；原来就有的规则也列出来，能开关、删除，简单的也能改。 */
const PF_OPTS = { name: 1, src: 1, dest: 1, target: 1, proto: 1, src_dport: 1, dest_ip: 1, dest_port: 1, enabled: 1, family: 1, reflection: 1 };
function pf_lan() {
	let v = uci_get('network.lan.ipaddr') ?? '', ip = trim(split(split(v, ' ')[0], '/')[0]), m = match(v, /\/([0-9]+)/);
	let pl = m ? +m[1] : mask_len(uci_get('network.lan.netmask') ?? '255.255.255.0');
	return v4int(ip) == null ? null : { ip, pl };
}
// 路由器自己在用的端口：网页后台（uhttpd 的 http / https）、SSH（dropbear）、面板局域网入口
function pf_reserved() {
	let r = {};
	for (let k in ['listen_http', 'listen_https']) for (let a in as_list(uci_get('uhttpd.main.' + k))) { let m = match(a, /:([0-9]+)$/); if (m) r[+m[1]] = '路由器网页后台'; }
	if (!length(keys(r))) { r[80] = '路由器网页后台'; r[443] = '路由器网页后台'; }
	let ssh = false;
	for (let s in (uci_load('dropbear') ?? [])) if (s['.type'] == 'dropbear') { r[+(s.Port ?? s.port ?? 22) || 22] = 'SSH'; ssh = true; }
	if (!ssh) r[22] = 'SSH';
	r[+trim(readfile(ETC + '/lan_port') ?? '') || 906] = '面板';
	return r;
}
function pf_range(s) {
	let m = match(trim('' + (s ?? '')), /^([0-9]{1,5})(-([0-9]{1,5}))?$/);
	if (!m) return null;
	let a = +m[1], b = m[3] ? +m[3] : a;
	return a >= 1 && b <= 65535 && a <= b ? [a, b] : null;
}
function pf_protos(p) {
	let l = as_list(p ?? 'tcp udp');
	return length(l) && index(l, 'all') < 0 ? l : ['tcp', 'udp'];
}
function pf_rules() {
	let L = [];
	for (let s in (uci_load('firewall') ?? [])) {
		if (s['.type'] != 'redirect' || (s.target ?? 'DNAT') != 'DNAT' || (s.src ?? '') != 'wan') continue;
		let x = { id: s['.name'], name: s.name ?? '', proto: join(' ', pf_protos(s.proto)), ext: s.src_dport ?? '', ip: s.dest_ip ?? '', port: s.dest_port ?? '', on: (s.enabled ?? '1') != '0', mine: !!match(s['.name'], /^cmcp_pf_/) };
		x.edit = !!pf_range(x.ext) && v4int(x.ip) != null;
		for (let k in keys(s)) if (substr(k, 0, 1) != '.' && !PF_OPTS[k]) x.edit = false;
		push(L, x);
	}
	return L;
}
function pf_wan() {
	let w = null;
	try { w = json(sh('ubus call network.interface.wan status 2>/dev/null').out); } catch (e) {}
	let ip = w?.['ipv4-address']?.[0]?.address ?? null;
	// 运营商给的是内网地址（大内网 / 光猫拨号）：从外面连不进来
	let inner = ip ? !!(match(ip, /^10\./) || match(ip, /^192\.168\./) || match(ip, /^172\.(1[6-9]|2[0-9]|3[01])\./) || match(ip, /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./)) : false;
	return { ip, inner };
}
P.pf_list = function() {
	let res = pf_reserved(), lan = pf_lan();
	return { list: pf_rules(), wan: pf_wan(), lan: lan ? lan.ip + '/' + lan.pl : null, reserved: map(sort(keys(res), (a, b) => +a - +b), (k) => ({ port: +k, what: res[k] })), pending: ng_pending() };
};
// a: { op: add | edit | del | on | off, id, name, proto: tcp|udp|both, ext, ip, port }
P.pf_set = function(a) {
	let op = a?.op;
	if (index(['add', 'edit', 'del', 'on', 'off'], op) < 0) die('不支持的操作');
	ng_busy();
	let L = pf_rules(), cur = null;
	if (op != 'add') { for (let x in L) if (x.id == a?.id) cur = x; if (!cur) die('没有这条端口转发'); }
	let U = conf().uci, cmds = [], set = (sid, k, v) => push(cmds, U + ' set ' + shq('firewall.' + sid + (k ? '.' + k : '') + '=' + v)), sum = '';
	if (op == 'add' || op == 'edit') {
		if (op == 'edit' && !cur.edit) die('这条规则有面板不认识的设置，在原版后台里改');
		let ext = pf_range(a?.ext);
		if (!ext) die('外部端口填 1–65535 的数字，或者一段，比如 8000-8010');
		let port = length(trim('' + (a?.port ?? ''))) ? pf_range(a.port) : ext;
		if (!port) die('内部端口填 1–65535 的数字');
		if (port[1] - port[0] != ext[1] - ext[0]) die('外部和内部端口的个数要一样');
		let res = pf_reserved();
		for (let k in keys(res)) if (+k >= ext[0] && +k <= ext[1]) die('不能转发 ' + k + ' 端口：' + res[k] + (match(res[k], /[A-Za-z]$/) ? ' ' : '') + '要用');
		let ip = trim('' + (a?.ip ?? '')), lan = pf_lan();
		if (v4int(ip) == null) die('设备地址不对，比如 192.168.1.100');
		if (!lan || !cidr_has(lan.ip, lan.pl, ip)) die('只能转到家里局域网的设备' + (lan ? '（' + lan.ip + '/' + lan.pl + '）' : ''));
		if (ip == lan.ip) die('不能转到路由器自己');
		let size = pow2(32 - lan.pl), off = v4int(ip) % size;
		if (lan.pl <= 30 && (off == 0 || off == size - 1)) die('设备地址不对，比如 ' + replace(lan.ip, /[0-9]+$/, '100'));
		let pr = a?.proto == 'tcp' ? 'tcp' : a?.proto == 'udp' ? 'udp' : 'tcp udp';
		// 跟别的开着的规则撞端口（同一个协议）
		for (let x in L) {
			if (!x.on || (cur && x.id == cur.id)) continue;
			let r = pf_range(x.ext);
			if (!r || r[1] < ext[0] || r[0] > ext[1]) continue;
			for (let p in split(pr, ' ')) if (index(split(x.proto, ' '), p) >= 0) die('外部端口 ' + x.ext + ' 已经转给' + (length(x.name) ? '「' + x.name + '」' : ' ' + x.ip) + '了');
		}
		let nm = trim('' + (a?.name ?? ''));
		if (match(nm, /[[:cntrl:]]/) || length(nm) > 60) die('名字太长或有不能用的字符');
		if (!length(nm)) nm = ip + ' ' + (ext[0] == ext[1] ? ext[0] : ext[0] + '-' + ext[1]);
		let sid = cur ? cur.id : null;
		if (!sid) { let r = rand_str(6); if (!r) die('路由器生成不了随机数，稍后再试'); sid = 'cmcp_pf_' + r; set(sid, null, 'redirect'); }
		let es = ext[0] == ext[1] ? '' + ext[0] : ext[0] + '-' + ext[1], ps = port[0] == port[1] ? '' + port[0] : port[0] + '-' + port[1];
		set(sid, 'name', nm); set(sid, 'target', 'DNAT'); set(sid, 'src', 'wan'); set(sid, 'dest', 'lan'); set(sid, 'proto', pr);
		set(sid, 'src_dport', es); set(sid, 'dest_ip', ip); set(sid, 'dest_port', ps);
		if (op == 'add') set(sid, 'enabled', '1');
		sum = '外部端口 ' + es + ' → ' + ip + ':' + ps;
	} else if (op == 'del') {
		push(cmds, U + ' delete ' + shq('firewall.' + cur.id));
		sum = '删掉了「' + (cur.name || cur.ext) + '」';
	} else {
		if (op == 'on') { let r = pf_range(cur.ext); for (let x in L) { let q = pf_range(x.ext); if (x.on && x.id != cur.id && r && q && !(q[1] < r[0] || q[0] > r[1])) die('外部端口 ' + x.ext + ' 已经转给' + (length(x.name) ? '「' + x.name + '」' : ' ' + x.ip) + '了，先关掉它'); } }
		set(cur.id, 'enabled', op == 'on' ? '1' : '0');
		sum = (op == 'on' ? '打开了「' : '关掉了「') + (cur.name || cur.ext) + '」';
	}
	let tok = rand_str(16);
	if (!tok) die('路由器生成不了随机数，稍后再试');
	sh('rm -rf ' + shq(NG) + ' && mkdir -p ' + shq(NG + '/files') + ' && cp -f ' + shq(ucdir() + '/firewall') + ' ' + shq(NG + '/files/firewall'));
	if (!stat(NG + '/files/firewall')) die('备份原来的设置失败，没有改');
	writefile(NG + '/what', '端口转发');
	writefile(NG + '/reload', '/etc/init.d/firewall reload\n');
	writefile(NG + '/until', '' + (time() + NG_WAIT + 15));
	writefile(NG + '/token', tok);
	let r = sh(join(' && ', cmds) + ' && ' + U + ' commit firewall');
	if (r.code != 0) {
		sh(U + ' revert firewall; cp -f ' + shq(NG + '/files/firewall') + ' ' + shq(ucdir() + '/firewall') + '; rm -rf ' + shq(NG));
		die('保存失败，没有改：' + trim_nl(r.out));
	}
	bg(sprintf('CMCP_NG=%s CMCP_UCI_DIR=%s CMCP_SBIN=%s %s/cmcp-netguard run %s', shq(NG), shq(ucdir()), shq(SBIN), SBIN, tok));
	try { sh(sprintf('%s/cmcp-notify info net %s %s net >/dev/null 2>&1', SBIN, shq('端口转发改了：' + sum), shq('90 秒内没点「保留」会自动改回去。'))); } catch (e) {}
	return { changed: true, token: tok, wait: NG_WAIT };
};

/* ---------------- 6.0 第 19 项：软件中心（搜索、安装、更新） ----------------
 * 自动识别路由器上的软件源和应用商店（用户 11/26：所有软件包和应用商店都要适配）：
 *   opkg：/etc/opkg.conf 和 /etc/opkg/*.conf 里所有 src 行（distfeeds = 固件自带，其他 = 第三方，比如 customfeeds）；
 *   apk：/etc/apk/repositories 和 /etc/apk/repositories.d/*.list；
 *   iStore（luci-app-store 的 is-opkg）：它自己的软件源在 /tmp/is-root/etc/opkg、列表在 /tmp/is-root/tmp/opkg-lists，装和更新用 is-opkg。
 * 每个包标出来自哪里（第三方的、iStore 的在面板里标出来，装之前确认框里也写）。卸载在「应用管理」（第 83 项）。
 * 装之前算空间：要装的包和还没装的依赖加起来，闪存不够就不装。
 * 更新软件源、安装、更新都在后台跑（要几十秒），面板每 2 秒问一次进度；同一时间只跑一个。
 * 系统组件（APP_CORE）不在这里更新：一个个升级系统组件可能把路由器弄坏，要升级固件。
 * 测试用环境变量：CMCP_APPS_ROOT / CMCP_APPS_PM（同应用管理）、CMCP_STORE_DIR（状态目录）、CMCP_STORE_RUN（命令只记下来）、
 *   CMCP_STORE_FREE（剩余空间 KB）、CMCP_STORE_APKLIST（apk list 的输出）、CMCP_STORE_ISTORE（1 = 当成装了 iStore） */
const ST_DIR = getenv('CMCP_STORE_DIR') || '/tmp/cmcp_store', IS_ROOT = APP_ROOT + '/tmp/is-root';
function st_src_lines(f, kind, out) {
	for (let l in split(readfile(f) ?? '', '\n')) { let m = match(l, /^src(\/gz)?[ \t]+([^ \t]+)[ \t]+([^ \t]+)/); if (m) push(out, { name: m[2], url: m[3], kind }); }
}
function st_conf_files(dir) { return sort(filter(require('fs').lsdir(dir) ?? [], (x) => match(x, /\.conf$/))); }
function st_istore() {
	let e = getenv('CMCP_STORE_ISTORE');
	if (e != null) return e == '1';
	return length(trim(sh('command -v is-opkg').out)) > 0;
}
function st_feeds(pm) {
	let f = [];
	if (pm == 'opkg') {
		st_src_lines(APP_ROOT + '/etc/opkg.conf', 'custom', f);
		let D = APP_ROOT + '/etc/opkg';
		if (stat(D + '/distfeeds.conf')) st_src_lines(D + '/distfeeds.conf', 'dist', f);
		for (let c in st_conf_files(D)) if (c != 'distfeeds.conf') st_src_lines(D + '/' + c, 'custom', f);
		if (st_istore()) for (let c in st_conf_files(IS_ROOT + '/etc/opkg')) {
			let g = []; st_src_lines(IS_ROOT + '/etc/opkg/' + c, 'istore', g);
			// iStore 把系统的软件源也拷了一份过去，那些不算 iStore 的
			for (let x in g) { let dup = false; for (let y in f) if (y.url == x.url) dup = true; if (!dup) push(f, x); }
		}
	} else {
		let add = (file, kind) => { for (let l in split(readfile(file) ?? '', '\n')) { l = trim(l); if (length(l) && substr(l, 0, 1) != '#') push(f, { name: replace(replace(l, /\/packages\.adb$/, ''), /^.*\/([^\/]+)$/, '$1'), url: l, kind }); } };
		add(APP_ROOT + '/etc/apk/repositories', 'custom');
		for (let c in sort(filter(require('fs').lsdir(APP_ROOT + '/etc/apk/repositories.d') ?? [], (x) => match(x, /\.list$/)))) add(APP_ROOT + '/etc/apk/repositories.d/' + c, c == 'distfeeds.list' ? 'dist' : 'custom');
	}
	return f;
}
function st_read_list(file) {
	let h = readfile(file, 2) ?? '';
	if (length(h) == 2 && ord(h, 0) == 0x1f && ord(h, 1) == 0x8b) return sh('gzip -dc ' + shq(file) + ' 2>/dev/null || zcat ' + shq(file)).out ?? '';
	return readfile(file) ?? '';
}
function st_lists_dir() {
	let m = match(readfile(APP_ROOT + '/etc/opkg.conf') ?? '', /lists_dir[ \t]+[^ \t]+[ \t]+([^ \t\n]+)/);
	return m ? m[1] : '/var/opkg-lists';
}
// 软件源里有哪些包：{ name: { ver, size, isize, desc, deps, feed, kind } }；同一个包在几个源里都有时，固件自带的优先，其次第三方，最后 iStore
// age：软件源多久没更新（秒，null = 还没更新过）
function st_index(pm) {
	let idx = {}, age = null;
	if (pm == 'opkg') {
		let sys = APP_ROOT + st_lists_dir();
		for (let kind in ['dist', 'custom', 'istore']) for (let f in st_feeds(pm)) {
			if (f.kind != kind) continue;
			let file = (kind == 'istore' ? IS_ROOT + '/tmp/opkg-lists' : sys) + '/' + f.name, st = stat(file);
			if (!st) continue;
			let a = time() - st.mtime; if (age == null || a > age) age = a;
			// 软件源列表一般是 gzip 压缩着存的（OpenWrt 的 opkg 都这样，iStore 也是）：先解压（用户 11/27：软件中心一个都不显示）
			for (let b in split(st_read_list(file), /\n\n+/)) {
				let k = app_kv(b, ':'), n = k.Package;
				if (!n || idx[n]) continue;
				idx[n] = { ver: k.Version ?? '', size: +(k.Size ?? 0) || 0, isize: +(k['Installed-Size'] ?? 0) || 0, desc: split(k.Description ?? '', '\n')[0], deps: app_dep_names(k.Depends), feed: f.name, kind };
			}
		}
	} else {
		let o = getenv('CMCP_STORE_APKLIST') ? readfile(getenv('CMCP_STORE_APKLIST')) ?? '' : sh('apk list --available 2>/dev/null').out;
		for (let l in split(o, '\n')) {
			let m = match(l, /^([A-Za-z0-9_.+-]+)-([0-9][^ ]*-r[0-9]+) /);
			if (m && !idx[m[1]]) idx[m[1]] = { ver: m[2], size: 0, isize: 0, desc: '', deps: [], feed: null, kind: 'dist' };
		}
		let t = +trim(readfile(ST_DIR + '/apk_at') ?? '');
		age = t ? time() - t : (length(keys(idx)) ? 0 : null);
	}
	return { idx, age };
}
function st_free() { let f = getenv('CMCP_STORE_FREE'); if (f) return +f; let m = match(sh('df -k /overlay 2>/dev/null | awk \'NR==2 { print $4 }\'').out, /([0-9]+)/); return m ? +m[1] : null; }
function st_state() {
	let s = cmcp_readj(ST_DIR + '/state', null);
	if (type(s) != 'object') return null;
	// 后台任务没了（路由器重启、被杀）但状态还是「进行中」：当成失败
	let rc = trim(readfile(ST_DIR + '/rc') ?? '');
	if (s.st == 'run' && length(rc)) s.st = rc == '0' ? 'ok' : 'fail';
	else if (s.st == 'run' && !getenv('CMCP_STORE_RUN') && time() - (s.at ?? 0) > 10 && (!stat(ST_DIR + '/pid') || !stat('/proc/' + trim(readfile(ST_DIR + '/pid') ?? 'x')))) { s.st = 'fail'; s.msg = '没做完就停了'; }
	s.log = substr(trim(readfile(ST_DIR + '/log') ?? ''), -1500);
	return s;
}
function st_busy() { let s = st_state(); if (s && s.st == 'run') die('正在' + (s.what ?? '处理') + '，等它做完'); }
// 后台跑：先写状态，跑完写结果；测试时只把命令记下来
function st_run(what, cmd, name, after) {
	st_busy();
	sh('mkdir -p ' + shq(ST_DIR) + ' && rm -f ' + shq(ST_DIR + '/rc') + ' ' + shq(ST_DIR + '/log'));
	cmcp_writej(ST_DIR + '/state', { st: 'run', what, name, at: time() });
