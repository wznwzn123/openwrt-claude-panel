		wg_uci([U + ' set ' + shq('network.cmcp_wg.listen_port=' + p), U + ' set ' + shq('firewall.cmcp_wg_in.dest_port=' + p)], ['network', 'firewall']);
		if (wg_on()) wg_apply();
		res.msg = '端口改成 ' + p + '，手机要重新扫码';
	} else if (a?.host != null) {
		let h = lc(trim('' + a.host));
