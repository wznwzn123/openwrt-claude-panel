#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance web
	# 面板压缩着存（index.zh）：uhttpd 交给 cmcp-gz 发出去；没有压缩版时照常发 index.html
	procd_set_param command /usr/sbin/uhttpd -f -D -p 127.0.0.1:18765 -h /www-claude-mcp -x /cgi-bin -t 120 -T 120 -n 4 -I index.zh -I index.html -i .zh=/usr/sbin/cmcp-gz
	procd_set_param respawn
	procd_close_instance

	rm -f /tmp/claude-mcp-tunnel.log
	# 闪存里有 cloudflared 就直接用；小闪存模式（没装进闪存）由 cmcp-cfd 下载到内存后再启动，参数完全一样
	local CFD=/usr/bin/cloudflared
	[ -x $CFD ] || CFD=/usr/sbin/cmcp-cfd
	procd_open_instance tunnel
	if [ -s /etc/claude-mcp/tunnel_token ]; then
		procd_set_param command $CFD tunnel --no-autoupdate --protocol http2 --logfile /tmp/claude-mcp-tunnel.log run --token "$(cat /etc/claude-mcp/tunnel_token)"
	else
		procd_set_param command $CFD tunnel --no-autoupdate --protocol http2 --logfile /tmp/claude-mcp-tunnel.log --url http://127.0.0.1:18765
	fi
	# 小内存路由器（总内存 256 MB 及以下）：让 cloudflared 早点回收用完的内存（GOGC=50，默认是 100），常驻少占一些；连接和功能都不变
	local mt=$(sed -n 's/^MemTotal: *\([0-9]*\).*/\1/p' /proc/meminfo 2>/dev/null)
	[ -n "$mt" ] && [ "$mt" -le 262144 ] && procd_set_param env GOGC=50
	procd_set_param respawn 3600 10 0
	procd_close_instance
}
