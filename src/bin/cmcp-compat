#!/usr/bin/ucode
// 5.3.0：尝鲜申请（6.0 的 cmcp-compat 只留尝鲜这一块；兼容情况上报 6.0 才有）
// 用法：cmcp-compat send [now]   申请了尝鲜的才报：定时任务每天一次，先随机等 0–30 分钟；now 马上报
//       cmcp-compat who          问官网申请用哪个邮箱（官网账号的，打码）；自建版还没关联账号时告诉面板去官网登录
//       cmcp-compat show         看上一次报了什么、官网怎么回的（打印 JSON）
// 报的只有：随机编号（这台路由器自己生成的，不跟账号挂钩）、面板版本、型号、系统版本、内存和闪存大小、申请时间和留言。
// 托管版另外带专属网址编号和路由器钥匙，官网凭它认出是哪个账号的（只用来认人和通知结果，管理后台看不到）；
// 自建版带关联码（这台路由器自己生成的随机串，用户在官网登录后把它关联到自己的账号）。邮箱一律用官网账号的，不能自己填（用户 11/26 定）。
// 没申请（没有 /etc/claude-mcp/beta_want）就什么都不报。文件名和格式跟 6.0 一样，升到 6.0 以后接着用
'use strict';
import * as L from 'cmcp.lib';
import { readfile, writefile, stat, unlink } from 'fs';

const D = getenv('CMCP_COMPAT_D') || L.D;
const RES = D + '/compat_res.json', ID = D + '/compat_id', BW = D + '/beta_want', LK = D + '/beta_lk';

function hub() {
	let h = getenv('CMCP_COMPAT_HUB');
	if (h) return h;
	h = match(readfile(D + '/hub.conf') ?? '', /(^|\n)HUB=(https:\/\/[^\n]+)/)?.[2];
	return h ?? 'https://yrlove520.com';
}
function rnd(n) {
	const A = 'abcdefghijkmnpqrstuvwxyz23456789';
	let r = trim(L.sh('head -c 64 /dev/urandom 2>/dev/null | od -An -tu1 2>/dev/null')), x = map(filter(split(r, /\s+/), (v) => length(v)), (v) => +v);
	return length(x) < n ? null : join('', map(slice(x, 0, n), (v) => substr(A, v % 32, 1)));
}
// 自建版的关联码：第一次用时生成，一直用同一个（官网那边关联一次就行）
function mylk() {
	let s = trim(readfile(LK) ?? '');
	if (match(s, /^[a-z2-9]{24}$/)) return s;
	s = rnd(24);
	if (s) writefile(LK, s);
	return s;
}
const hosted = () => !!match(readfile(D + '/hub.conf') ?? '', /(^|\n)SUB=[a-z0-9]+/);
function myid() {
	let s = trim(readfile(ID) ?? '');
	if (match(s, /^[a-z2-9]{16}$/)) return s;
	const A = 'abcdefghijkmnpqrstuvwxyz23456789';
	let r = trim(L.sh('head -c 64 /dev/urandom 2>/dev/null | od -An -tu1 2>/dev/null')), n = map(filter(split(r, /\s+/), (x) => length(x)), (x) => +x);
	if (length(n) < 16) return null;
	s = join('', map(slice(n, 0, 16), (x) => substr(A, x % 32, 1)));
	writefile(ID, s);
	return s;
}
function ver() {
	let o = {};
	for (let l in split(readfile(D + '/version') ?? '', '\n')) { let m = match(l, /^([A-Z]+)=(.*)$/); if (m) o[m[1]] = m[2]; }
	return o;
}
// 型号、系统、内存、闪存（只读，不改任何东西）
function probe() {
	let rel = {};
	for (let l in split(readfile(getenv('CMCP_COMPAT_REL') || '/etc/openwrt_release') ?? '', '\n')) { let m = match(l, /^([A-Z_]+)='?([^']*)'?$/); if (m) rel[m[1]] = m[2]; }
	let model = trim(L.sh("ubus call system board 2>/dev/null | sed -n 's/.*\"model\": *\"\\([^\"]*\\)\".*/\\1/p' | head -n1")) || trim(readfile('/tmp/sysinfo/model') ?? '');
	let mi = readfile('/proc/meminfo') ?? '', mem = int(+(match(mi, /MemTotal:\s+(\d+)/)?.[1] ?? 0) / 1024);
	let fl = +trim(L.sh("df -k /overlay 2>/dev/null | awk 'NR>1{s=$2} END{print int(s/1024)}'")) || +trim(L.sh("df -k / 2>/dev/null | awk 'NR>1{s=$2} END{print int(s/1024)}'")) || 0;
	return { model: substr(model, 0, 80), sys: substr(rel.DISTRIB_DESCRIPTION ?? '', 0, 80), mem, flash: fl };
}
// 留言里不能带个人信息：网址、邮箱、MAC、IP、像钥匙的长串一律换掉（官网收到后还会再洗一遍）
function scrub(t) {
	t = replace('' + (t ?? ''), /[[:cntrl:]]/g, ' ');
	t = replace(t, /[a-zA-Z][a-zA-Z0-9+.-]*:\/\/[^ "'<>]*/g, '<网址>');
	t = replace(t, /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/g, '<邮箱>');
	t = replace(t, /[0-9a-fA-F]{2}([:-][0-9a-fA-F]{2}){5}/g, '<MAC>');
	t = replace(t, /([0-9a-fA-F]{1,4}:){3,7}[0-9a-fA-F]{1,4}/g, '<IP>');
	t = replace(t, /([0-9a-fA-F]{1,4}:)*[0-9a-fA-F]{0,4}::[0-9a-fA-F:]*/g, '<IP>');
	t = replace(t, /[0-9]{1,3}(\.[0-9]{1,3}){3}/g, '<IP>');
	t = replace(t, /[A-Za-z0-9_+\/=-]{24,}/g, '<…>');
	return t;
}
// 申请人：托管版是专属网址编号和路由器钥匙，自建版是关联码
function who_app() {
	let sub = match(readfile(D + '/hub.conf') ?? '', /(^|\n)SUB=([a-z0-9]+)/)?.[2], rk = match(readfile(D + '/cloud.conf') ?? '', /(^|\n)RKEY=([A-Za-z0-9]+)/)?.[2];
	if (sub) return { sub, rkey: rk ?? '' };
	let lk = mylk();
	return lk ? { lk } : {};
}
// 申请：时间、留言和申请人
function beta_app() {
	let a = null; try { a = json(readfile(BW) ?? 'null'); } catch (e) {}
	if (type(a) != 'object') a = { at: 0 };
	return { at: +a.at || 0, note: substr(scrub(a.note), 0, 200), ...who_app() };
}
function post(path, body) {
	let tmp = '/tmp/cmcp_compat_body.' + (rnd(6) ?? 'x') + '.json';
	writefile(tmp, sprintf('%J', body));
	let out = L.sh(sprintf("curl -s -m 20 -X POST -H 'Content-Type: application/json' --data-binary @%s %s", tmp, L.shq(hub() + path)));
	unlink(tmp);
	let r = null; try { r = json(out); } catch (e) {}
	return type(r) == 'object' ? r : { error: '连不上官网', out: substr(out ?? '', 0, 200) };
}
// 申请框打开时问：邮箱（打码）；自建版没关联时 login=true，面板带着关联码去官网登录
function who() {
	let app = who_app(), r = post('/api/compat/who', { app });
	if (!r.ok) return { error: r.error ?? '连不上官网' };
	return { mail: r.mail ?? '', login: !!r.login, why: r.why ?? '', hosted: hosted(), hub: hub(), ...(app.lk && r.login ? { lk: app.lk } : {}) };
}
function send() {
	let beta = !!stat(BW), id = myid();
	if (!id) return { error: 'no id' };
	let v = ver();
	// 撤回了申请：只说一声「不要了」（只带编号和版本），官网把这台的申请删掉
	let body = beta ? { id, ver: v.VER ?? '', code: v.CODE ?? '', ...probe(), beta: true, app: beta_app() } : { id, ver: v.VER ?? '', beta: false };
	if (!beta && !stat(RES)) return { off: true }; // 从来没申请过：什么都不报
	let r = post('/api/compat', body);
	if (!r.ok) return { error: '没报上去', out: r.out ?? r.error ?? '' };
	if (body.app) { delete body.app.rkey; delete body.app.lk; } // 留给面板看的那份不存钥匙和关联码
	r.at = L.now(); r.sent = body;
	if (beta) L.writej(RES, r); else unlink(RES);
	return r;
}

let cmd = ARGV[0] ?? '';
if (cmd == 'who') { print(sprintf('%J\n', who())); exit(0); }
if (cmd == 'show') { print(sprintf('%J\n', L.readj(RES, {}))); exit(0); }
if (cmd == 'send') {
	if (ARGV[1] != 'now') { let n = (+trim(L.sh('echo $RANDOM')) || 0) % 1800; if (n > 0) L.sh('sleep ' + n); }
	print(sprintf('%J\n', send()));
	exit(0);
}
print('用法：cmcp-compat send [now] | who | show\n');
exit(1);
