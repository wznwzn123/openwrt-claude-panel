	c.token = nt;
	writefile(CONF_PATH + '.tmp', sprintf('%.J\n', c));
	rename(CONF_PATH + '.tmp', CONF_PATH);
	CONF = null;
	let cc = readfile('/etc/claude-mcp/cloud.conf') ?? '';
