#!/usr/bin/ucode
// 节点自动切换（看门狗每分钟调用一次）
// 当前节点连续 3 分钟测不通（谷歌、Cloudflare 两个网址都不通才算） → 按「同地区同类型同倍率 → 同地区同类型 → 同地区 → 其他地区」挑延迟最低的（6.0 第 92 项，认法见 cmcp.lib 的 node_meta）
// → 断开走旧节点的连接 → 通知；原来的节点连续正常 10 分钟后自动换回去（中间手动切过就不换）
// 设置：/etc/claude-mcp/autosw.json {"enabled":true,"group":"选过的策略组"}；没选过、或者选的组没了，自动认主策略组（cmcp.lib 的 main_group）
'use strict';
import * as L from 'cmcp.lib';
import { mkdir, stat, readfile } from 'fs';

const CF = L.D + '/autosw.json', SF = '/tmp/cmcp_autosw.json', HF = L.D + '/autosw_hist.json';
const TEST = 'https://www.gstatic.com/generate_204', TEST2 = 'http://cp.cloudflare.com/generate_204';
const cfg = L.readj(CF, { enabled: true });
const arg = ARGV[0];
if (!cfg.enabled && arg != 'test') exit(0);
// test = 模拟一次（面板上的「模拟」按钮）：不真的切换、不发通知、不受锁影响
const T = arg == 'test';
if (!T && !mkdir('/tmp/cmcp_autosw.lock')) { let s = stat('/tmp/cmcp_autosw.lock'); if (s && L.now() - s.mtime < 120) exit(0); }
const out = (o) => { if (T) print(sprintf('%J\n', o)); };
const done = (code) => { if (!T) L.sh('rmdir /tmp/cmcp_autosw.lock'); exit(code ?? 0); };

let st = L.readj(SF, { last: 0, allfail: false });
const save = () => L.writej(SF, st);
const t = L.now();

// 家里断网时不折腾节点
if (!length(L.sh('ping -c1 -W2 223.5.5.5 >/dev/null && echo y || ping -c1 -W2 119.29.29.29 >/dev/null && echo y'))) { out({ err: '家里宽带现在上不了网，先不动节点' }); done(); }

const GROUPS = ['Selector', 'URLTest', 'Fallback', 'LoadBalance', 'Relay', 'Smart'];
const INFO = /剩余|到期|官网|流量|过期|套餐|更新|客户端|网址|订阅|重置|公告|群/;
// 机场订阅的流量和到期时间（订阅链接返回的 subscription-userinfo），缓存 6 小时
const SUBF = '/tmp/cmcp_subinfo.json';
function subinfo(fresh) {
	let c = L.readj(SUBF, null);
	if (!fresh && c && t - c.at < 6 * 3600) return c;
	let base = replace(replace(L.uci('openclash.config.config_path'), /^.*\//, ''), /\.ya?ml$/, ''), addr = null, ua = null;
	for (let i = 0; i < 20; i++) {
		let n = L.uci('openclash.@config_subscribe[' + i + '].name');
		if (!length(n)) break;
		if (n == base) { addr = L.uci('openclash.@config_subscribe[' + i + '].address'); ua = L.uci('openclash.@config_subscribe[' + i + '].sub_ua'); break; }
	}
	if (!length(addr)) return c;
	let h = lc(L.sh(sprintf('curl -sLI -X GET -m 8 -o /dev/null -D - -H %s %s', L.shq('User-Agent: ' + (length(ua) ? ua : 'clash-verge')), L.shq(addr))));
	let m = match(h, /subscription-userinfo:[ \t]*([^\r\n]+)/);
	if (!m) return c;   // 取不到（比如节点全挂了连不上订阅网站）就用上次的
	let v = (k) => { let x = match(m[1], regexp(k + '=([0-9]+)')); return x ? +x[1] : 0; };
	let r = { at: t, name: base, up: v('upload'), down: v('download'), total: v('total'), expire: v('expire') };
	L.writej(SUBF, r);
	return r;
}
// 流量用光 / 到期了吗
function subbad(i) {
	if (!i) return null;
	if (i.total > 0 && i.up + i.down >= i.total) return 'traffic';
	if (i.expire > 0 && i.expire <= t) return 'expire';
	return null;
}
const GB = (b) => sprintf('%.1f GB', b / 1073741824.0);
const day = (x) => trim(L.sh('date -d @' + x + ' +%Y-%m-%d'));

const px = L.api('GET', '/proxies', null, 8).json?.proxies ?? {};
const GRP = L.main_group(px, cfg.group);
if (!GRP) { out({ err: '找不到手动选择的策略组（OpenClash / Nikki 没在运行）' }); done(); }
const g = L.api('GET', '/proxies/' + L.enc(GRP), null, 6);
if (g.code != 200 || g.json?.type != 'Selector') { out({ err: '找不到手动选择的策略组「' + GRP + '」（OpenClash / Nikki 没在运行，或者组名变了）' }); done(); }
const cur = g.json.now, all = g.json.all ?? [];
const isNode = (n) => px[n] && !(px[n].type in GROUPS) && !(px[n].type in ['Direct', 'Reject', 'RejectDrop', 'Pass', 'Compatible']) && !match(n, INFO);
// 当前选的是另一个策略组（比如「自动选择」）或直连：它自己会处理，不管
if (!isNode(cur) && !T) done();
// 10 分钟内刚手动换过节点（面板或 AI 换的）：先照你的选择来，不自动换走；过了 10 分钟它还连不上才换
const manual = +(readfile(getenv('CMCP_ASW_MANUAL') ?? '/tmp/cmcp_autosw_manual') ?? 0) || 0;
// 自动换过以后你又手动选了别的（或者组里已经不是自动换上的那个）：不再换回原来的
if (!T && st.orig && (cur != st.orig.to || manual > st.orig.at)) { st.orig = null; save(); }
if (!T && t - manual < 600) done();

const delay = (n, tmo, url) => +(L.api('GET', '/proxies/' + L.enc(n) + '/delay?timeout=' + tmo + '&url=' + L.enc(url ?? TEST), null, tmo / 1000 + 3).json?.delay ?? 0);
// 通不通：先测谷歌的，测不通再换 Cloudflare 的测一次，任何一个通就算通（用户 11/25：只测一个网址，它偶尔抽风也会被当成节点挂了）
const alive = (n, tmo) => delay(n, tmo) || delay(n, tmo, TEST2);
// 断开还挂在某个节点上的连接，让它们马上走新节点（面板自己的连接保留）
function cut(from) {
	const hp = split(trim(readfile('/etc/claude-mcp/hostname') ?? ''), '.');
	const host = length(hp) > 2 ? join('.', slice(hp, 1)) : join('.', hp);
	let n = 0;
	for (let c in (L.api('GET', '/connections', null, 8).json?.connections ?? [])) {
		if (!(from in (c.chains ?? []))) continue;
		if (host && index(c.metadata?.host ?? '', host) >= 0) continue;
		L.api('DELETE', '/connections/' + L.enc(c.id), null, 3); n++;
	}
	return n;
}
const hist = (h) => L.writej(HF, slice([h, ...L.readj(HF, [])], 0, 20));
// 原来的节点连续正常 10 分钟：换回去
function back() {
	let o = st.orig;
	if (!o) return;
	if (!(o.from in all) || !isNode(o.from)) { st.orig = null; return; }
	if (alive(o.from, 3000) <= 0) { o.ok = 0; return; }
	if (!o.ok) { o.ok = t; return; }
	if (t - o.ok < 600) return;
	L.api('PUT', '/proxies/' + L.enc(GRP), { name: o.from }, 6);
	let n = cut(cur);
	hist({ t, from: cur, to: o.from, back: true });
	st.orig = null; st.last = t;
	L.notify('ok', 'node', '节点已换回：' + o.from, '「' + o.from + '」已经连续正常 10 分钟，从「' + cur + '」换回来了，断开了 ' + n + ' 条旧连接', 'node');
}
let d1 = alive(cur, 5000);
if (!T) {
	if (d1 > 0) {
		st.fail = 0; st.allfail = false;
		// 节点正常时顺便更新订阅信息（6 小时一次）；续费了就清掉「用光了」的标记
		let si = subinfo(false);
		if (st.subbad && !subbad(si)) { st.subbad = null; L.notify('ok', 'sub', '机场订阅恢复正常', '剩余流量 ' + GB(si.total - si.up - si.down) + (si.expire ? '，' + day(si.expire) + ' 到期' : '') + '。节点自动切换照常工作。', 'sub'); }
		back();
		save(); done();
	}
	L.sh('sleep 3'); if (alive(cur, 5000) > 0) { st.fail = 0; save(); done(); }
	// 连续 3 分钟（看门狗每分钟查一次，连着 3 次）都不通才换（用户 11/25 定）：节点高峰时卡十几秒不算挂；中间通过一次就重新数
	st.fail = t - (+st.failT || 0) < 150 ? (+st.fail || 0) + 1 : 1; st.failT = t;
	if (st.fail < 3) { save(); done(); }
	// 3 分钟内刚换过就先不换，避免来回跳
	if (t - (st.last ?? 0) < 180) done();
	// 订阅流量用光或到期了：换节点也没用，不切换，只提醒一次
	let si = subinfo(true), bad = subbad(si);
	if (bad) {
		if (st.subbad != bad) {
			st.subbad = bad;
			L.notify('err', 'sub', bad == 'traffic' ? '机场订阅流量用光了' : '机场订阅已经到期',
				(bad == 'traffic' ? '订阅「' + si.name + '」已用 ' + GB(si.up + si.down) + '，共 ' + GB(si.total) + '。' : '订阅「' + si.name + '」' + day(si.expire) + ' 到期了。') +
				'节点连不上是因为这个，换节点也没用，所以没有自动切换。续费或重置流量后会自动恢复。', 'sub');
		}
		save(); done();
	}
	st.subbad = null;
}

const res = L.api('GET', '/group/' + L.enc(GRP) + '/delay?timeout=3000&url=' + L.enc(TEST), null, 15).json ?? {};
const cands = map(filter(all, (n) => n != cur && isNode(n)), (n) => ({ n, d: +res[n] || 0 }));
const pick = L.node_pick(cur, cands), meta = L.node_meta(cur);
if (T) { let si = subinfo(true); out({ sub: si, subbad: subbad(si), cur, node: isNode(cur), curDelay: d1, region: meta.reg, kind: meta.kind, mult: meta.mult, pick, same: !!pick && pick.tier < 3, tested: length(cands), ok: length(filter(cands, (x) => x.d > 0)) }); done(); }
if (!pick) {
	if (!st.allfail) { st.allfail = true; L.notify('err', 'node', '所有节点都连不上', '策略组「' + GRP + '」里的节点全部测不通，可能是机场出了问题或订阅过期了', 'node'); }
	save(); done();
}

L.api('PUT', '/proxies/' + L.enc(GRP), { name: pick.n }, 6);
const n = cut(cur);
// 记下原来的节点：它恢复后（连续正常 10 分钟）换回去；连着换了几次，只记最早那个
st.orig = { from: st.orig?.from ?? cur, to: pick.n, at: t, ok: 0 };
if (st.orig.from == pick.n) st.orig = null;  // 换回的正好是最早那个：不用再等着换回
st.last = t; st.fail = 0; st.allfail = false;
// 切换记录存到闪存（很少写，重启也不丢）
hist({ t, from: cur, to: pick.n, d: pick.d, same: pick.tier < 3, tier: pick.tier, why: pick.why });
save();
L.notify('warn', 'node', '节点自动切换：' + cur + ' → ' + pick.n,
	'「' + cur + '」连不上了，已换到' + pick.why + '的「' + pick.n + '」（延迟 ' + pick.d + ' ms），断开了 ' + n + ' 条旧连接。原来的节点恢复 10 分钟后会自动换回去', 'node');
done();
