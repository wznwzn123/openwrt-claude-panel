// 拿手机钥匙换通行证（只有这个方法不用带通行证）。返回整条 JSON-RPC 回答（错误码手机要分开处理）
function pass_new_rpc(id, p) {
	let err = (code, message, data) => { let dd = { need_code: is_hosted(), hub: hub_conf(true)?.HUB ?? null }; for (let k in keys(data ?? {})) dd[k] = data[k]; return { jsonrpc: '2.0', id, error: { code, message, data: dd } }; };
	let r = dev_renew(p?.dev);
	if (r == 'copied') return err(-32010, '这台手机的钥匙可能被复制了，已经让它退出：重新登录就行');
	if (!r) return err(-32010, is_hosted() ? '这台手机还没登录：从官网「我的路由器」点「打开面板」进来' : '这台手机的登录失效了：重新打开登录地址（或在另一台已登录的手机上「添加新手机」扫码）');
	DEV_ID = r.id; DEV = r.d;
	try {
		if (r.d.lk) {
			if (p?.lkp != null) {
				let why = lk_verify(r.id, r.d, p.lkp);
				if (why) return why.revoked ? err(-32010, why.msg) : err(-32014, why.msg, { need_pin: true, bad: true, wait: why.wait ?? 0, salt: r.d.lk.salt, len: r.d.lk.len });
				lkok_set(r.id);
			} else {
				// 手上的通行证还没过期（正在用、快到期续一张）：接着用，不用再输
				let pv = type(p?.prev) == 'string' ? pass_read()[p.prev] : null;
				if (!(type(pv) == 'object' && pv.dev == r.id && pv.exp > time())) {
					// 新开的会话（锁屏后、关掉重开、过期了）：只开了密码的要输密码；开了指纹的（指纹只能在手机上验证）每天至少输一次
					if (!r.d.lk.fp) return err(-32014, '输面板锁密码解锁', { need_pin: true, salt: r.d.lk.salt, len: r.d.lk.len });
					if (!lkok_fresh(r.id)) return err(-32014, '今天第一次解锁，要输一次面板锁密码', { need_pin: true, salt: r.d.lk.salt, len: r.d.lk.len });
				}
			}
		}
		let ps = pass_issue(r.id);
		if (r.cred) ps.dev = r.cred;
		return { jsonrpc: '2.0', id, result: ps };
	} catch (e) { return { jsonrpc: '2.0', id, error: { code: -32000, message: type(e) == 'object' ? e.message : '' + e } }; }
}
// 面板「现在锁上」、退出登录：作废这台手机手上的通行证（之后要指纹或密码才能再领）
P.pass_drop = function() { if (DEV_ID) pass_drop_dev(DEV_ID); return { ok: true }; };
// 设置 / 修改 / 关闭面板锁（只能改自己这台手机的）。已经有锁时要先核对旧密码
P.lock_set = function(a) {
	if (!DEV_ID || !DEV) die('先登录');
	let all = devs_read(), d = all[DEV_ID];
	if (type(d) != 'object') die('这台手机已经退出了');
	if (d.lk) {
		let why = lk_verify(DEV_ID, d, a?.old);
		if (why) die(why.msg);
	}
	if (a?.on) {
		let salt = '' + (a?.salt ?? ''), p = lk_proof(a?.lkp), len = +(a?.len ?? 0);
		if (!match(salt, /^[A-Za-z0-9+\/=]{16,64}$/) || !p || len < 4 || len > 6) die('面板锁密码的格式不对');
		d.lk = { salt, h: hash_str(salt + ':' + p), len, at: time(), fp: !!a?.fp };
	} else delete d.lk;
	all[DEV_ID] = d; devs_write(all);
	if (a?.on) lkok_set(DEV_ID);
	return { ok: true, on: !!a?.on };
};
// 开 / 关指纹解锁（开之前面板已经核对过密码）：路由器据此决定新会话要不要每次都输密码
P.lock_fp = function(a) {
	let all = devs_read(), d = all[DEV_ID ?? ''];
	if (type(d) != 'object' || !d.lk) die('这台手机没开面板锁');
	d.lk.fp = !!a?.fp; all[DEV_ID] = d; devs_write(all);
	return { ok: true, fp: d.lk.fp };
};
// 核对面板锁密码（改密码、开指纹前确认是本人）
P.lock_check = function(a) {
	if (!DEV?.lk) return { ok: true, none: true };
	let why = lk_verify(DEV_ID, DEV, a?.lkp);
	if (why) die(why.msg);
	lkok_set(DEV_ID);
	return { ok: true };
};
P.lock_state = function() { return DEV?.lk ? { on: true, len: DEV.lk.len, salt: DEV.lk.salt } : { on: false }; };
/* ---------- 自建版：用登录地址换手机钥匙（第 6、12 项） ---------- */
function login_pw_on() { return trim(readfile(LOGINPW_F) ?? '') == '1'; }
// 开了「登录要输路由器密码」又没带密码：手机要弹出输密码（错误码 -32015，见 90-rpc）
function die2_need_pw() { ERR_CODE = -32015; die('这台路由器开了「登录要输路由器后台密码」：输一下路由器后台（root）密码'); }
P.pass_login = function(a) {
	if (is_hosted()) die('托管版要从官网「我的路由器」点「打开面板」进来');
	if (login_pw_on()) {
		if (a?.pw == null || a?.pw == '') die2_need_pw();
		rootpw_check(a?.pw, '登录面板时的路由器密码');
	}
	let id = rand_str(8), sec = rand_str(32);
	if (!id || !sec) die('生成手机钥匙失败，再试一次');
	let d = devs_read();
	let ids = sort(keys(d), (x, y) => (d[x].at ?? 0) - (d[y].at ?? 0));
	while (length(ids) >= 30) delete d[shift(ids)];
	let name = substr(replace('' + (a?.name ?? ''), /[[:cntrl:]<>"]/g, ''), 0, 40) || '手机';
	let via = login_pw_on() ? '登录地址 + 路由器密码' : '登录地址';
	d[id] = { s: sec, name, at: time(), rot: time(), via };
	devs_write(d);
	DEV_ID = id;
	// 以前就在用的手机（6.0 以前直接存着登录密钥）换成手机钥匙：不当成新手机推送
	if (!a?.migrate) try { sh(sprintf('/usr/sbin/cmcp-notify info login %s %s login', shq('新手机登录了面板：' + name), shq('用' + via + '登录。不是你自己的话，马上在面板「我的主页 → 敏感信息」让它退出，并换一下登录密钥'))); } catch (e) {}
	return { dev: id + '.' + sec, id, name };
};
// 开关「登录要输路由器后台密码」：只有主账号、确认过本人才能改（敏感信息里）
P.login_pw_set = function(a) {
	if (is_hosted()) die('托管版登录要过官网账号，不用这个');
	need_sudo(a, true);
	if (a?.on) {
		let sh0 = match(readfile(getenv('CMCP_SHADOW') ?? '/etc/shadow') ?? '', /(^|\n)root:([^:\n]*):/);
		if (sh0 && !length(sh0[2])) die('路由器还没设后台密码：先在原版后台「系统 → 管理权」设一个');
		writefile(LOGINPW_F, '1\n');
	} else sh('rm -f ' + shq(LOGINPW_F));
	return { ok: true, on: !!a?.on };
};
// 自建版「添加新手机」：给新手机的登录链接（带登录密钥）只在确认本人以后给
P.login_link = function(a) {
	if (is_hosted()) die('托管版添加新手机用官网');
	need_sudo(a, true);
	return { token: conf().token, pw: login_pw_on() };
};
P.update_check = function(a) {
	let v = ver_info(), cf = '/tmp/cmcp_latest.json', c = null;
	try { c = json(readfile(cf) ?? 'null'); } catch (e) {}
	if (!c || a?.force || time() - (c.at ?? 0) > 3600) {
		let hub = match(readfile('/etc/claude-mcp/hub.conf') ?? '', /(^|\n)HUB=(https:\/\/[^\n]+)/)?.[2] ?? 'https://yrlove520.com';
		let j = null;
		try { j = json(sh(sprintf('curl -s -m 12 %s', shq(hub + '/api/router/version'))).out); } catch (e) {}
		// 自己搭的开通中心如果还是旧版，没有这个地址：退回老地址（curl 去问时回答的是路由器版本）
		if (type(j) != 'object' || !j.version) { try { j = json(sh(sprintf('curl -s -m 12 %s', shq(hub + '/api/app/version'))).out); } catch (e) {} }
		if (type(j) == 'object' && j.version) { c = { at: time(), latest: j.version, notes: j.notes ?? '', force: !!j.force, min: j.min ?? '', rel: j.at ?? '' }; writefile(cf, sprintf('%J', c)); }
		else if (!c) die('查不到最新版本：连不上官网，稍后再试');
	}
	let newer = !length(v.cur) || v.cur == 'dev' ? true : ver_newer(c.latest, v.cur);
	return { cur: v.cur || null, code: v.code || null, latest: c.latest, notes: c.notes, rel: c.rel ?? '', newer, force: newer && (c.force || (length(c.min) > 0 && length(v.cur) > 0 && ver_newer(c.min, v.cur))) };
};
P.update_start = function(a) {
	if (a?.confirm != 'UPDATE') die('需要确认');
	let r = null;
	if (!stat('/usr/sbin/cmcp-update')) die('没能开始更新：路由器上没有 cmcp-update（版本太旧，先用安装命令手动升级一次）');
	// 只看最后一行：前面就算混进别的输出（工具的提示、警告），也不影响判断
	let out = trim(sh('/usr/sbin/cmcp-update start 2>/dev/null').out ?? '');
	let last = out ? split(out, '\n')[-1] : '';
	try { r = json(last); } catch (e) {}
	if (type(r) != 'object') die('没能开始更新：后台更新程序没有正常回应，稍后再试；一直这样就用安装命令手动升级一次');
	if (r.busy) die('已经在更新了，等一会儿');
	return { started: true };
};
P.update_status = function() {
	let s = null;
	try { s = json(readfile('/tmp/cmcp_update.json') ?? 'null'); } catch (e) {}
	if (type(s) != 'object') s = { state: 'idle' };
	// 「准备更新」超过 45 秒还没动，而且后台没在跑：说明没能转到后台，别让面板一直等
	if (s.state == 'queued' && time() - (+s.t || 0) > 45 && !stat('/tmp/cmcp_update.lock'))
		s = { ...s, state: 'failed', msg: '后台没能开始更新，再点一次「一键更新」试试；一直这样就用安装命令手动升级一次' };
	s.cur = ver_info().cur;
	return s;
};

/* ---------- 换一把新的登录密钥：旧的登录地址马上作废（截图泄露、手机丢了时用） ---------- */
P.rotate_key = function(a) {
	if (a?.confirm != 'ROTATE') die('需要确认');
	need_sudo(a, true);
	let nt = trim(sh("tr -dc 'a-z0-9' < /dev/urandom | head -c 40").out);
	if (length(nt) != 40) die('生成新密钥失败，稍后再试');
	let c = json(readfile(CONF_PATH) ?? '{}') ?? {};
	if (length(c.token ?? '') < 16) die('读不到现在的密钥，没有修改');
	c.token = nt;
	writefile(CONF_PATH + '.tmp', sprintf('%.J\n', c));
	rename(CONF_PATH + '.tmp', CONF_PATH);
	CONF = null;
	// 6.0 第 53 项：原版页面的门禁钥匙一起换（旧的马上作废，已登录的手机下次打开原版页面自动拿新的）
	luci_key_new();
	let cc = readfile('/etc/claude-mcp/cloud.conf') ?? '';
	// 自建完整版：云端（Worker）用登录密钥来认面板，要提醒用户把 Worker 的 PANEL_TOKEN 也换掉
	let selfcloud = match(cc, /(^|\n)URL=./) && !match(cc, /(^|\n)PKEY=./);
	try { sh(sprintf('/usr/sbin/cmcp-notify info key %s %s key', shq('登录密钥已更换'), shq('旧的登录地址已经作废，原版页面的门禁钥匙也一起换了。已经登录的手机照常能用；用旧登录地址加的 AI 连接器要换成「AI 连接器地址」。'))); } catch (e) {}
	return { token: nt, host: trim(readfile('/etc/claude-mcp/hostname') ?? ''), selfcloud: !!selfcloud };
};
P.cloud_info = function() {
	let c = {};
	for (let l in split(readfile('/etc/claude-mcp/cloud.conf') ?? '', '\n')) {
		let m = match(l, /^([A-Z]+)=(.*)$/);
		if (m) c[m[1]] = m[2];
	}
	if (!c.URL) return { enabled: false };
	// 托管版：面板读云端用单独的 PKEY（登录密钥不交给托管服务）；自建完整版自己部署的 Worker 认的是登录密钥（PANEL_TOKEN），
	// 6.0 起手机不再存登录密钥，只有自建完整版在这里拿一份给自己的 Worker 用（确认登录过的手机才拿得到）
	// 平板网址带着平板的钥匙：不在这里给，在「我的主页 → 敏感信息」里验证后才给（P.tablet_url）；这里只说有没有
	return { enabled: true, url: c.URL, tablet: !!c.TKEY, pkey: c.PKEY || (c.URL && !hub_conf(true) ? conf().token : null), hosted: !!c.PKEY, hub: hub_conf(true)?.HUB ?? null };
};

P.wd_check = function() {
	sh('/usr/sbin/cmcp-watchdog once');
	return P.wd();
};
P.wd_clear = function() {
	writefile(WD_EV, sprintf('%J\n', { t: time(), lvl: 'info', kind: 'watchdog', msg: '记录已清空', detail: '', from: 0, to: 0 }));
