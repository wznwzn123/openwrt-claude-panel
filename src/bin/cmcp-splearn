#!/usr/bin/ucode
// 6.0 分流的「识别软件」（用户 11/27 加；11/28 改）：cmcp-splearn <设备 MAC> <秒数> <这次识别的编号> [设备现在的 IPv4]
// 老写法 cmcp-splearn <设备 IP> <秒数> <编号> 照样认（只认这一个 IP）。
// 用户 11/28：打开软件总得有网址出来——以前每 2 秒看一次「正在连着的连接」，一闪而过的会漏；手机用 IPv6 连的也不算这台设备。现在：
// 1. 实时日志：OpenClash / Nikki 的 /logs?level=info，每个新连接一行「[TCP] 来源:端口 --> 网址:端口 match …」，后台 curl 一直往临时文件里写，这里每秒读新的
// 2. 连接列表：每 2 秒看一次 /connections（日志读不到时每秒），补上识别开始前就连着的
// 3. 不经过代理的（OpenClash 开着「绕过中国大陆」，直连国内 IP 的）：每 3 秒看一次系统的连接跟踪，记 IP 和次数；
//    用户 11/28 13:1x 改：OpenClash（DNS 经过 dnsmasq 转给它的）也像下面第 4 条一样记这几分钟的 DNS 查询，直连的国内软件也能看到网址（以前只列 IP）。
//    Clash 日志里有的网址照旧按日志算，DNS 只补日志里没有的；查过网址的 IP 不再列进「直连的 IP」
//    走了代理但连接跟踪里看着像直连的（TPROXY、TUN 转过去的真实 IP）：日志、连接列表里出现过的目标 IP 不算
// 4. 没有 Clash（PassWall、PassWall 2、HomeProxy、SSR Plus+，用户 11/28 定）：让 dnsmasq 记这几分钟的 DNS 查询，按设备的地址读它查了哪些网址；
//    开始和结束各重启一次 dnsmasq（家里 DNS 停不到 1 秒）。改的是 dhcp 里的 logqueries / logfacility（新版 OpenWrt 的 dnsmasq 跑在隔离环境里，只有这里设的日志文件进得去），
//    原来的值记在 /etc/claude-mcp/spl_dns.json（放闪存：识别到一半断电重启了，看门狗照样能放回去）；结束、停止、出错都放回原样。cmcp-splearn dnsoff 只做放回这一步
// 设备按 MAC 认：IPv4、IPv6 地址都算（ip neigh + DHCP 记录，每 5 秒更新一次，手机的临时 IPv6 会变）。
// 结果写 /tmp/cmcp_sp_learn.json（只有网址、IP 和次数）；结果文件里的编号变了（又开了一次识别）或者标成停了，就自己停。不上传、不存到闪存。
// 测试用：CMCP_SPL_F（结果文件）、CMCP_SPL_CONNS（假的连接列表）、CMCP_SPL_LOG（日志临时文件）、CMCP_SPL_NOCURL=1（不起 curl，测试自己往日志文件里写）、
//         CMCP_SPL_NEIGH（假的 ip neigh 输出）、CMCP_SPL_LEASES（假的 DHCP 记录）、CMCP_SPL_CT（假的连接跟踪文件）、
//         CMCP_SPL_UCI（uci 命令）、CMCP_SPL_DNSON（记原来设置的文件）、CMCP_SPL_DLOG（DNS 记录文件）、CMCP_SPL_DNSRS（重启 dnsmasq 的命令）、CMCP_SPL_DNSOK（看 dnsmasq 在不在跑的命令）
'use strict';
import * as L from 'cmcp.lib';
import { readfile, writefile, open, unlink, stat } from 'fs';

const F = getenv('CMCP_SPL_F') || '/tmp/cmcp_sp_learn.json', LOG = getenv('CMCP_SPL_LOG') || '/tmp/cmcp_spl_log';
const DNSON = getenv('CMCP_SPL_DNSON') || L.D + '/spl_dns.json', DLOG = getenv('CMCP_SPL_DLOG') || '/tmp/cmcp_spl_dns.log', U = getenv('CMCP_SPL_UCI') || 'uci', DQ = 'dhcp.@dnsmasq[0].';
function dns_rs() { L.sh(getenv('CMCP_SPL_DNSRS') || '/etc/init.d/dnsmasq restart >/dev/null 2>&1'); }
function dns_up() { return length(trim(L.sh(getenv('CMCP_SPL_DNSOK') || 'pidof dnsmasq'))) > 0; }
function ug(k) { return trim(L.sh(U + ' -q get ' + L.shq(DQ + k))); }
// 放回原来的 logqueries / logfacility，重启 dnsmasq
function dns_off() {
	let o = L.readj(DNSON, null);
	if (type(o) != 'object') return;
	let c = map(['logqueries', 'logfacility'], (k) => length(o[k] ?? '') ? U + ' set ' + L.shq(DQ + k + '=' + o[k]) : U + ' -q delete ' + L.shq(DQ + k));
	L.sh(join('; ', c) + '; ' + U + ' commit dhcp');
	unlink(DNSON);
	dns_rs();
	unlink(DLOG);
}
if (ARGV[0] == 'dnsoff') { dns_off(); exit(0); }
const a0 = lc('' + (ARGV[0] ?? '')), secs = +(ARGV[1] ?? 180) || 180, rid = '' + (ARGV[2] ?? '');
const legacy = !!match(a0, /^\d+\.\d+\.\d+\.\d+$/), mac = legacy ? null : a0, ip0 = legacy ? a0 : '' + (ARGV[3] ?? '');
if (!legacy && !match(mac, /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/)) { print('用法：cmcp-splearn <设备 MAC> <秒数> <编号> [设备 IPv4]\n'); exit(1); }
const end = time() + secs;
let seen = {}, hosts = {}, dips = {}, ctseen = {}, viaClash = {}, nohost = 0, err = null, ok = false, logok = false, ips = {}, ipsAt = 0;
const MODE = L.readj(F, null)?.mode, DNS = MODE == 'dns', CDNS = MODE == 'clash+dns';
let dhosts = {}; // Clash 模式下从 DNS 记录补的网址（日志里没有的才算进结果）
const nhost = () => length(keys(hosts));
function add(h) {
	h = lc('' + (h ?? ''));
	if (length(h) && length(h) <= 253 && match(h, /^[a-z0-9_.-]+$/) && !match(h, /^[0-9.]+$/) && index(h, ':') < 0) { if (hosts[h] || nhost() < 2000) hosts[h] = (hosts[h] ?? 0) + 1; return true; }
	nohost++;
	return false;
}
// 这台设备现在的地址：IPv4、IPv6 都算
function refresh_ips() {
	let n = {};
	if (match(ip0, /^\d+\.\d+\.\d+\.\d+$/)) n[ip0] = 1;
	if (mac) {
		let nf = getenv('CMCP_SPL_NEIGH'), out = nf ? (readfile(nf) ?? '') : L.sh('ip neigh show');
		// DNS 查询可能从 fe80 开头的地址发过来（设备把路由器的本地地址当 DNS），记 DNS 时也算
		for (let l in split(out, '\n')) { let m = match(l, /^([0-9a-fA-F.:]+) .*lladdr ([0-9a-fA-F:]{17})/); if (m && lc(m[2]) == mac && (DNS || !match(m[1], /^fe80:/i))) n[lc(m[1])] = 1; }
		for (let l in split(readfile(getenv('CMCP_SPL_LEASES') || '/tmp/dhcp.leases') ?? '', '\n')) { let p = split(l, ' '); if (lc(p[1] ?? '') == mac && match(p[2] ?? '', /^\d+\.\d+\.\d+\.\d+$/)) n[p[2]] = 1; }
	}
	ips = n; ipsAt = time();
}
// 实时日志：后台 curl 一直往临时文件里追加，这里从上次读到的地方接着读
let curlPid = null, off = 0, rest = '';
function log_start() {
	writefile(LOG, '');
	if (getenv('CMCP_SPL_NOCURL')) return;
	let c = L.clash_ctl();
	if (!c) return;
	let p = trim(L.sh(sprintf('curl -sN -m %d -H %s %s >> %s 2>/dev/null & echo $!', secs + 5, L.shq('Authorization: Bearer ' + c.secret), L.shq('http://127.0.0.1:' + c.port + '/logs?level=info'), L.shq(LOG))));
	if (match(p, /^[0-9]+$/)) curlPid = p;
}
function log_stop() { if (curlPid) L.sh('kill ' + curlPid); if (!getenv('CMCP_SPL_NOCURL')) unlink(LOG); }
// 「[TCP] 192.168.1.10:51234(进程) --> www.example.com:443 match … using …」；IPv6 的来源写成 [2408::1]:51234
function log_read() {
	let f = open(LOG, 'r');
	if (!f) return;
	f.seek(off);
	let d = f.read(262144) ?? '';
	f.close();
	if (!length(d)) return;
	off += length(d);
	let ls = split(rest + d, '\n');
	rest = pop(ls);
	for (let l in ls) {
		let j = null;
		try { j = json(l); } catch (e) {}
		let m = match('' + (j?.payload ?? ''), /^\[(TCP|UDP)\] (\[[0-9a-fA-F:.]+\]|[0-9.]+):([0-9]+)(\([^)]*\))? --> (\[[0-9a-fA-F:.]+\]|[^ :]+):[0-9]+/);
		if (!m) continue;
		logok = true;
		let src = lc(replace(replace(m[2], /^\[/, ''), /\]$/, ''));
		if (!ips[src]) continue;
		ok = true;
		// 同一个连接日志里有、连接列表里也有：按「来源地址 + 端口」只算一次
		let k = src + '|' + m[3];
		if (seen[k]) continue;
		seen[k] = 1;
		if (!add(m[5])) viaClash[lc(replace(replace(m[5], /^\[/, ''), /\]$/, ''))] = 1;
	}
	// 读完了就清空（curl 是追加写，清空后接着从头写），免得识别 3 分钟占太多内存盘
	if (off > 524288 && !length(rest)) { writefile(LOG, ''); off = 0; }
}
/* 记 DNS 查询（没有 Clash 时）。dnsmasq 每个查询一行「query[A] www.example.com from 192.168.1.10」，回答一行「reply www.example.com is 1.2.3.4」；
   查过网址的 IP 不再列进「只有 IP」那一组 */
let dlog = null, doff = 0, drest = '', dpid = null, resolved = {}, dnsok = false;
function dns_start() {
	if (type(L.readj(DNSON, null)) == 'object') dns_off(); // 上次没放回去的先放回
	let lq = ug('logqueries'), lf = ug('logfacility'), follow = false;
	L.writej(DNSON, { logqueries: lq, logfacility: lf, at: time() });
	let c = [U + ' set ' + L.shq(DQ + 'logqueries=1')];
	// 原来没设日志文件：记到内存盘的单独文件；设了文件：读那个文件新写的；记到系统日志的：跟着系统日志读
	if (!length(lf)) { writefile(DLOG, ''); push(c, U + ' set ' + L.shq(DQ + 'logfacility=' + DLOG)); dlog = DLOG; }
	else if (match(lf, /^\//)) { dlog = lf; doff = stat(lf)?.size ?? 0; }
	else { dlog = DLOG; writefile(DLOG, ''); follow = true; }
	if (index(L.sh(join(' && ', c) + ' && ' + U + ' commit dhcp && echo ok'), 'ok') < 0) { unlink(DNSON); err = '改不了 dnsmasq 的设置'; return; }
	dns_rs();
	let up = false;
	for (let i = 0; i < 6 && !up; i++) { L.sh('sleep 1'); up = dns_up(); }
	// 起不来就马上放回去，免得家里没有 DNS
	if (!up) { dns_off(); err = '打开 DNS 记录后 dnsmasq 没起来 已经恢复'; return; }
	if (follow) { let p = trim(L.sh(sprintf('logread -f -e dnsmasq >> %s 2>/dev/null & echo $!', L.shq(DLOG)))); if (match(p, /^[0-9]+$/)) dpid = p; }
	dnsok = true;
}
function dns_stop() { if (dpid) L.sh('kill ' + dpid); if (dnsok || type(L.readj(DNSON, null)) == 'object') dns_off(); dnsok = false; }
function dns_read() {
	if (!dlog) return;
	let f = open(dlog, 'r');
	if (!f) return;
	f.seek(doff);
	let d = f.read(262144) ?? '';
	f.close();
	if (!length(d)) return;
	doff += length(d);
	let ls = split(drest + d, '\n');
	drest = pop(ls);
	for (let l in ls) {
		let m = match(l, /query\[(A|AAAA|HTTPS)\] ([^ ]+) from ([0-9a-fA-F.:]+)/);
		if (m) {
			if (DNS) { logok = true; if (ips[lc(m[3])]) { ok = true; add(m[2]); } }
			else if (ips[lc(m[3])]) { let h = lc(m[2]); if (length(h) <= 253 && match(h, /^[a-z0-9_.-]+$/) && !match(h, /^[0-9.]+$/) && (dhosts[h] || length(keys(dhosts)) < 2000)) dhosts[h] = (dhosts[h] ?? 0) + 1; }
			continue;
		}
		m = match(l, /(reply|cached) [^ ]+ is ([0-9a-fA-F.:]+)$/);
		if (m) resolved[lc(m[2])] = 1;
	}
	// 自己的文件读完了就清空（dnsmasq 是追加写），免得占太多内存盘；别人设的日志文件不动
	if (dlog == DLOG && doff > 524288 && !length(drest)) { writefile(DLOG, ''); doff = 0; }
}
function conns() {
	let f = getenv('CMCP_SPL_CONNS');
	if (f) { try { return json(readfile(f) ?? 'null')?.connections ?? []; } catch (e) { return []; } }
	let r = L.api('GET', '/connections', null, 5);
	if (r.code != 200) { err = r.code == 401 ? 'OpenClash / Nikki 的接口密钥不对' : '连不上 OpenClash / Nikki 的接口'; return null; }
	err = null;
	return r.json?.connections ?? [];
}
function conn_read() {
	let l = conns();
	if (l == null) return;
	for (let c in l) {
		let m = c?.metadata;
		if (type(m) != 'object' || !ips[lc('' + (m.sourceIP ?? ''))]) continue;
		// 走了 OpenClash / Nikki 的目标 IP（TPROXY、TUN 转过去的，连接跟踪里看着也像直连）：连接跟踪那边不算
		for (let x in [m.destinationIP, m.remoteDestination]) if (length('' + (x ?? ''))) viaClash[lc('' + x)] = 1;
		ok = true;
		let k = length('' + (m.sourcePort ?? '')) ? lc('' + m.sourceIP) + '|' + m.sourcePort : 'id|' + (c.id ?? ''), h = lc('' + (m.host || m.sniffHost || ''));
		if (seen[k]) continue;
		seen[k] = 1;
		add(h);
	}
}
// 不经过代理的连接：连接跟踪里来源是这台设备、回来的地址就是去的地址（经过代理的，回来的是路由器自己）
function priv(a) {
	return !!(match(a, /^(10|127)\./) || match(a, /^192\.168\./) || match(a, /^172\.(1[6-9]|2[0-9]|3[01])\./) || match(a, /^169\.254\./) || match(a, /^198\.1[89]\./) || match(a, /^(22[4-9]|2[3-5][0-9])\./)
		|| match(a, /^(fe80|fc|fd|ff)/i) || a == '::1' || a == '0.0.0.0');
}
function ct_read() {
	let list = keys(ips);
	if (!length(list)) return;
	let fct = getenv('CMCP_SPL_CT') || '/proc/net/nf_conntrack';
	if (!stat(fct)) return;
	let out = L.sh('grep -F ' + join(' ', map(list, (x) => '-e ' + L.shq('src=' + x + ' '))) + ' ' + L.shq(fct) + ' | head -n 3000');
	for (let l in split(out, '\n')) {
		let s = match(l, /src=([0-9a-fA-F.:]+) dst=([0-9a-fA-F.:]+) sport=([0-9]+) dport=([0-9]+).* src=([0-9a-fA-F.:]+) dst=/), pr = match(l, /^ipv[46] +[0-9]+ +([a-z]+)/);
		if (!s || !ips[lc(s[1])] || lc(s[5]) != lc(s[2]) || priv(s[2]) || s[4] == '53' || s[4] == '123' || viaClash[lc(s[2])] || resolved[lc(s[2])]) continue;
		let k = (pr?.[1] ?? '') + ' ' + s[2] + ' ' + s[3] + ' ' + s[4];
		if (ctseen[k]) continue;
		ctseen[k] = 1;
		ok = true;
		let d = lc(s[2]);
		if (dips[d] || length(keys(dips)) < 500) dips[d] = (dips[d] ?? 0) + 1;
	}
}
function save(run) {
	let o = L.readj(F, null);
	if (type(o) != 'object' || o.rid != rid || (run && o.run === false)) return false; // 又开了一次识别，或者用户点了停止
	// Clash 模式：日志里没有的网址用 DNS 记录补上（同一个网址日志和 DNS 都有的按日志的次数）
	let hs = hosts;
	if (CDNS && length(dhosts)) { hs = { ...hosts }; for (let h in dhosts) if (!hs[h] && length(keys(hs)) < 2000) hs[h] = dhosts[h]; }
	o.hosts = hs; o.dips = dips; o.nohost = nohost; o.run = run; o.err = logok ? null : err; o.seen = ok; o.log = logok;
	// 查过网址的 IP 不算「只有 IP」：先看到连接、后看到回答的，这里补着去掉
	for (let d in keys(dips)) if (resolved[d]) delete dips[d];
	L.writej(F, o);
	return true;
}
refresh_ips();
if (DNS || CDNS) dns_start();
if (!DNS) log_start();
let tick = 0;
while (time() < end) {
	if (time() - ipsAt >= 5) refresh_ips();
	if (DNS || CDNS) dns_read();
	if (!DNS) { log_read(); if (!logok || tick % 2 == 0) conn_read(); }
	if (tick % 3 == 0) ct_read();
	if (!save(true)) { if (DNS || CDNS) dns_stop(); if (!DNS) log_stop(); exit(0); }
	tick++;
	L.sh('sleep 1');
}
if (DNS || CDNS) dns_read();
if (!DNS) { log_read(); conn_read(); }
ct_read();
save(false);
if (DNS || CDNS) dns_stop();
if (!DNS) log_stop();
