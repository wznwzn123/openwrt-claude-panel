		writefile(CHAT_CONF + '.tmp', sprintf('%J', { cid: r.cid, ckey: r.ckey, hub, at: time() }));
		sh('chmod 600 ' + shq(CHAT_CONF + '.tmp'));
		rename(CHAT_CONF + '.tmp', CHAT_CONF);
		id = chat_id();
		if (!id) die('开不了对话，稍后再试');
	}
