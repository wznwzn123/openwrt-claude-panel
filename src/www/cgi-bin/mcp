	if (getenv('CMCP_APPS_RUN')) { writefile(getenv('CMCP_APPS_RUN'), cmd + '\n'); o = { code: +(getenv('CMCP_APPS_RC') ?? 0), out: getenv('CMCP_APPS_OUT') ?? '' }; }
