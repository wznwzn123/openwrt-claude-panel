	let ak = '' + (a?.ack ?? '');
	if (length(ak)) { if (!match(ak, /^[a-z2-9]{10}$/)) die('公告编号不对'); if (index(s.ack, ak) < 0) { push(s.ack, ak); s.ack = slice(s.ack, -50); ch = true; } }
	// 6.0 第 85 项：这个新版本已经弹过（每个版本只弹一次；换手机、清缓存也不再弹）。不算「看了公告」，不上报
