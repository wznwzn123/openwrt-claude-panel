#!/bin/sh
# 面板里打开 Kwrt 原版页面的入口：先确认是面板发来的（cmcp_l 门禁），再自动登录（记住登录，不用输密码）
K=$(cat /etc/claude-mcp/luci_key 2>/dev/null)
ck() { printf '; %s;' "$HTTP_COOKIE" | sed -n "s/.*; *$1=\([^;]*\);.*/\1/p"; }
deny() {
	printf 'Status: 403 Forbidden\r\nContent-Type: text/html; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
	printf '<meta name="viewport" content="width=device-width,initial-scale=1"><p style="font:15px sans-serif;padding:24px;color:#888">请从路由器面板里打开这个页面。</p>'
	exit 0
}
[ -n "$K" ] && [ "$(ck cmcp_l)" = "$K" ] || deny
export HTTPS=on
APP=${0##*/}
[ "$APP" = luci ] || exec "/www/cgi-bin/$APP"
SID=$(ck sysauth_https)
case "$SID" in *[!0-9a-f]*) SID= ;; esac
if [ -n "$SID" ] && ubus call session get "{\"ubus_rpc_session\":\"$SID\"}" 2>/dev/null | grep -q '"token"'; then
	exec /www/cgi-bin/luci
fi
# 没登录或已过期：用面板专用账号自动登录
SID=$(ubus call session login "{\"username\":\"cmcp\",\"password\":\"$(cat /etc/claude-mcp/luci_pass)\",\"timeout\":86400}" 2>/dev/null | jsonfilter -e '@.ubus_rpc_session')
if [ -z "$SID" ]; then
	printf 'Status: 500 Internal Server Error\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n自动登录失败\n'
	exit 0
fi
TOK=$(head -c 16 /dev/urandom | md5sum | cut -c1-32)
ubus call session set "{\"ubus_rpc_session\":\"$SID\",\"values\":{\"token\":\"$TOK\",\"username\":\"root\"}}" >/dev/null 2>&1
CK="sysauth_https=$SID; Max-Age=31536000; path=/cgi-bin/luci/; SameSite=strict; HttpOnly; secure"
if [ "$REQUEST_METHOD" = GET ]; then
	printf 'Status: 302 Found\r\nSet-Cookie: %s\r\nLocation: %s\r\nCache-Control: no-store\r\n\r\n' "$CK" "$REQUEST_URI"
	exit 0
fi
export HTTP_COOKIE="sysauth_https=$SID"
exec /www/cgi-bin/luci
