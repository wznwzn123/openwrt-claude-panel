		if (!sp_kind()) die('分流只支持 OpenClash 和 Nikki');
		let ip = trim('' + (a?.ip ?? ''));
		if (!match(ip, /^\d+\.\d+\.\d+\.\d+$/)) die('这台设备现在没有 IP，等它连上网再识别');
