/* ---------------- 面板：第三批（终端、文件管理、不走代理） ---------------- */

function shell_allowed() { if (conf().allow_shell === false) die('路由器上已关闭命令行功能（claude-mcp shell on 可以重新打开）'); }

P.term = function(a) {
	shell_allowed();
	let cmd = '' + (a.cmd ?? ''), cwd = '' + (a.cwd || '/root');
	if (!length(trim(cmd))) die('命令为空');
	if (!stat(cwd)) cwd = '/';
	let t = +a.timeout || 60;
	if (t > 110) t = 110;
	let mark = '__CMCP_CWD__';
	let script = sprintf('cd %s 2>/dev/null || cd /\n%s\n__rc=$?\necho\necho %s"$(pwd)"\nexit $__rc', shq(cwd), cmd, mark);
	let r = sh(sprintf('timeout %d sh -c %s', t, shq(script)));
	let out = r.out, ncwd = cwd;
	let i = rindex(out, mark);
	if (i >= 0) { ncwd = trim(substr(out, i + length(mark))); out = substr(out, 0, i); }
	out = replace(out, /\n+$/, '');
	if (length(out) > 60000) out = '…（前面的输出太长，已省略）\n' + substr(out, length(out) - 60000);
	return { out, code: r.code == 124 || r.code == 143 ? 'timeout' : r.code, cwd: ncwd };
};

const FS_PROTECT = ['/', '/bin', '/boot', '/dev', '/etc', '/lib', '/overlay', '/proc', '/rom', '/root', '/sbin', '/sys', '/tmp', '/usr', '/var', '/www', '/etc/config', '/etc/init.d', '/usr/bin', '/usr/lib', '/usr/sbin', '/www-claude-mcp', '/www-claude-mcp/cgi-bin', '/etc/claude-mcp', '/etc/openclash'];
function fs_path(p) {
	if (type(p) != 'string' || substr(p, 0, 1) != '/' || index(p, '\0') >= 0) die('路径必须是以 / 开头的绝对路径');
	let parts = [];
	for (let x in split(p, '/')) {
		if (x == '' || x == '.') continue;
		if (x == '..') { pop(parts); continue; }
		push(parts, x);
	}
	return '/' + join('/', parts);
}
function fs_guard_write(p) {
	shell_allowed();
	if (index(FS_PROTECT, p) >= 0) die('这是系统关键目录，不能删除或改名：' + p);
	if (match(p, /^\/(proc|sys|dev|rom)(\/|$)/)) die('这个位置不能修改：' + p);
	if (p == '/www-claude-mcp/cgi-bin/mcp' || p == '/usr/bin/claude-mcp') die('这是面板自身的程序，不能在这里删除或改名');
}

P.fs_list = function(a) {
	let p = fs_path(a.path || '/');
	let st = stat(p);
	if (!st) die('不存在：' + p);
	if (st.type != 'directory') die('不是文件夹：' + p);
	let out = [];
	for (let n in (require('fs').lsdir(p) ?? [])) {
		let f = (p == '/' ? '' : p) + '/' + n, s = stat(f), l = require('fs').lstat(f);
		if (!l) continue;
		push(out, { name: n, dir: s?.type == 'directory', link: l.type == 'link', size: s?.size ?? 0, mtime: (s ?? l).mtime, mode: sprintf('%03o', ((s ?? l).mode ?? 0) & 4095) });
	}
	out = sort(out, (x, y) => (y.dir - x.dir) || (lc(x.name) < lc(y.name) ? -1 : 1));
	// 分区名很长时 BusyBox df 会换行：把数据行拼起来、从后往前数（可用、总共）
	let df = sh(sprintf("df -h %s 2>/dev/null | awk 'NR > 1 { l = l \" \" $0 } END { n = split(l, f, \" \"); if (n >= 6) print f[n - 2] \" 可用 / 共 \" f[n - 4] }'", shq(p))).out;
	return { path: p, items: out, free: trim(df) };
};

P.fs_read = function(a) {
	let p = fs_path(a.path), st = stat(p);
	if (!st) die('文件不存在');
	if (st.type != 'file') die('不是普通文件');
	if (st.size > 2 * 1024 * 1024) return { path: p, size: st.size, mtime: st.mtime, toobig: true };
	let s = readfile(p) ?? '';
	for (let c = 0; c < 9; c++) if (index(s, chr(c)) >= 0) return { path: p, size: st.size, mtime: st.mtime, binary: true };
	return { path: p, size: st.size, mtime: st.mtime, content: s };
};

P.fs_write = function(a) {
	let p = fs_path(a.path);
	shell_allowed();
	if (match(p, /^\/(proc|sys|dev|rom)(\/|$)/)) die('这个位置不能写入');
	let st = stat(p);
	if (st && st.type == 'directory') die('这是文件夹');
	if (st && !a.overwrite && a.create) die('已经有同名文件');
	let dir = replace(p, /\/[^\/]*$/, '') || '/';
	if (!stat(dir)) die('文件夹不存在：' + dir);
	let bak = null;
	if (st && st.size < 2 * 1024 * 1024) {
		mkdir('/etc/claude-mcp/bak');
		bak = sprintf('/etc/claude-mcp/bak/file.%s.%s', replace(p, /\//g, '_'), now_str());
		sh(sprintf('cp -f %s %s; ' + BAK_PRUNE, shq(p), shq(bak)));
	}
	let tmp = p + '.cmcp_tmp';
	if (a.b64 != null) {
		writefile(tmp + '.b64', a.b64);
		let r = sh(sprintf('base64 -d %s > %s; rm -f %s', shq(tmp + '.b64'), shq(tmp), shq(tmp + '.b64')));
		if (r.code != 0) { sh('rm -f ' + shq(tmp)); die('文件解码失败'); }
	} else {
		if (type(a.content) != 'string') die('缺少内容');
		if (writefile(tmp, a.content) == null) die('写入失败（空间不足或没有权限？）');
	}
	if (st) sh(sprintf('chmod --reference=%s %s 2>/dev/null', shq(p), shq(tmp)));
	rename(tmp, p);
	return { ok: true, backup: bak, size: stat(p)?.size };
};

P.fs_mkdir = function(a) {
	let p = fs_path(a.path);
	shell_allowed();
	if (stat(p)) die('已经存在');
	let r = sh('mkdir -p ' + shq(p));
	if (r.code != 0) die(trim(r.out));
	return { ok: true };
};

P.fs_delete = function(a) {
	let p = fs_path(a.path);
	fs_guard_write(p);
	let st = require('fs').lstat(p);
	if (!st) die('不存在');
	if (st.type == 'directory' && !a.recursive) {
		let n = length(require('fs').lsdir(p) ?? []);
		if (n) die('文件夹不是空的（里面有 ' + n + ' 项）');
	}
	let r = sh('rm -rf ' + shq(p));
	if (r.code != 0) die(trim(r.out));
	return { ok: true };
};

P.fs_rename = function(a) {
	let p = fs_path(a.path), q = fs_path(a.to);
	fs_guard_write(p);
	if (stat(q)) die('目标已存在');
	let r = sh(sprintf('mv %s %s', shq(p), shq(q)));
	if (r.code != 0) die(trim(r.out));
	return { ok: true };
};

P.fs_copy = function(a) {
	let p = fs_path(a.path), q = fs_path(a.to);
	shell_allowed();
	if (stat(q)) die('目标已存在');
	let r = sh(sprintf('cp -a %s %s', shq(p), shq(q)));
	if (r.code != 0) die(trim(r.out));
	return { ok: true };
};

P.fs_chmod = function(a) {
	let p = fs_path(a.path);
	fs_guard_write(p);
	if (!match('' + a.mode, /^[0-7]{3,4}$/)) die('权限格式不对，例如 755');
	let r = sh(sprintf('chmod %s %s', a.mode, shq(p)));
	if (r.code != 0) die(trim(r.out));
	return { ok: true };
};

P.fs_download = function(a) {
	let p = fs_path(a.path), st = stat(p);
	if (!st) die('不存在');
	let name = replace(p, /.*\//, '') || 'root';
	let tmp = '/tmp/cmcp_fsdl';
	sh('rm -rf ' + tmp);
	if (st.type == 'directory') {
		let r = sh(sprintf('tar -czf %s -C %s %s', tmp, shq(replace(p, /\/[^\/]*$/, '') || '/'), shq(name)));
		if (r.code != 0 && !stat(tmp)) die('打包失败');
		name += '.tar.gz';
	} else {
		if (st.size > 200 * 1024 * 1024) die('文件太大');
		sh(sprintf('cp -f %s %s', shq(p), tmp));
	}
	return dl_put(tmp, name);
};

/* ---------- 不走代理（以前叫「拉黑名单」）：名单里的设备所有流量直连（只能用大陆网络） ---------- */
const BL_FILE = '/etc/claude-mcp/blacklist.json';
const BL_PROVIDER = 'cmcp_blacklist';
const BL_RULESET = '/etc/openclash/rule_provider/cmcp_blacklist.yaml';
const BL_CUSTOM = '/etc/openclash/custom/openclash_custom_rules.list';
const BL_MARK = '# [cmcp-blacklist]';

function bl_load() { let j = null; try { j = json(readfile(BL_FILE) ?? '[]'); } catch (e) {} return type(j) == 'array' ? j : []; }
function bl_save(l) { writefile(BL_FILE + '.tmp', sprintf('%J', l)); rename(BL_FILE + '.tmp', BL_FILE); }
// 规则集的内容在共用库里生成（cmcp-route 也要用）：不走代理的设备、路由器自己的隧道、面板走直连时的面板域名
function bl_write_ruleset(l) { CL.bl_ruleset_write(); }
function bl_custom_ready() { return index(readfile(BL_CUSTOM) ?? '', BL_MARK) >= 0; }
function bl_live() { try { let r = api('GET', '/providers/rules', null, 4); return !!(r?.providers?.[BL_PROVIDER]); } catch (e) { return false; } }
function bl_mac(m) { m = lc(trim('' + (m ?? ''))); if (!match(m, /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/)) die('MAC 地址不对：' + m); return m; }

/* 给设备固定 IP（已有固定分配就沿用），返回最终 IP */
function bl_pin(mac, ip, name) {
	let c = require('uci').cursor(), found = null;
	c.load('dhcp');
	c.foreach('dhcp', 'host', (s) => {
		let macs = type(s.mac) == 'array' ? s.mac : split(lc(s.mac ?? ''), ' ');
		for (let m in macs) if (lc(m) == mac) found = s;
	});
	if (found) return { ip: found.ip, created: false };
	if (!match(ip ?? '', /^\d+\.\d+\.\d+\.\d+$/)) die('这台设备现在没有 IP，先让它连上网再设置');
	let sid = c.add('dhcp', 'host');
	c.set('dhcp', sid, 'mac', mac);
	c.set('dhcp', sid, 'ip', ip);
	if (name && match(name, /^[A-Za-z0-9._-]+$/)) c.set('dhcp', sid, 'name', name);
	c.set('dhcp', sid, 'cmcp_black', '1');
	c.commit('dhcp');
	sh('/etc/init.d/dnsmasq reload >/dev/null 2>&1');
	return { ip, created: true };
}
function bl_unpin(mac) {
	let c = require('uci').cursor(), del = [];
	c.load('dhcp');
	c.foreach('dhcp', 'host', (s) => { if (s.cmcp_black == '1' && lc(s.mac ?? '') == mac) push(del, s['.name']); });
	for (let s in del) c.delete('dhcp', s);
	if (length(del)) { c.commit('dhcp'); sh('/etc/init.d/dnsmasq reload >/dev/null 2>&1'); }
}
function bl_apply(ip) {
	try { api('PUT', '/providers/rules/' + BL_PROVIDER, null, 10); } catch (e) { return false; }
	if (ip) try {
		for (let cn in (api('GET', '/connections', null, 5)?.connections ?? []))
			if (cn.metadata?.sourceIP == ip) try { api('DELETE', '/connections/' + cn.id, null, 3); } catch (e) {}
	} catch (e) {}
	return true;
}

/* ---------- 看门狗：断线记录 ---------- */
const WD_EV = '/etc/claude-mcp/events.log';
P.wd = function(a) {
	let lines = split(trim(readfile(WD_EV) ?? ''), '\n'), ev = [], lim = +(a?.limit ?? 300);
	for (let i = length(lines) - 1; i >= 0 && length(ev) < lim; i--) {
		if (!length(lines[i])) continue;
		try { push(ev, json(lines[i])); } catch (e) {}
	}
	let st = {};
	for (let l in split(readfile('/tmp/cmcp_wd.state') ?? '', '\n'))
		for (let kv in split(l, ';')) {
			let m = match(trim(kv), /^([A-Z_]+)="?([^"]*)"?$/);
			if (m) st[m[1]] = m[2];
		}
	let run = false;
	try { run = !!json(sh("ubus call service list '{\"name\":\"cmcp-watchdog\"}'").out)?.['cmcp-watchdog']?.instances?.watchdog?.running; } catch (e) {}
	return {
		events: ev, state: st, running: run, now: time(),
		uptime: +split(readfile('/proc/uptime') ?? '0', ' ')[0],
		heartbeat: +(trim(readfile('/etc/claude-mcp/heartbeat') ?? '0') || 0),
	};
};
/* 云端监测：给面板平板（证人）的报告网址 */
/* 切节点前先测一下这个节点通不通（测不通就提醒，免得切过去连面板都打不开） */
P.node_check = function(a) {
	if (!a?.node) die('需要 node');
	try {
		let r = api('GET', '/proxies/' + urlenc(a.node) + '/delay?timeout=3000&url=' + urlenc('https://www.gstatic.com/generate_204'), null, 8);
		return { ok: (+r?.delay || 0) > 0, delay: +r?.delay || 0 };
	} catch (e) { return { ok: false, delay: 0 }; }
};

/* ---------- 节点自动切换 ---------- */
function cmcp_readj(f, def) { try { let s = readfile(f); return s ? json(s) : def; } catch (e) { return def; } }
function cmcp_writej(f, o) { writefile(f + '.tmp', sprintf('%J', o)); sh('mv ' + shq(f + '.tmp') + ' ' + shq(f)); }

P.autosw = function(a) {
	let f = '/etc/claude-mcp/autosw.json', c = cmcp_readj(f, { enabled: true, group: 'Zou' });
	if (a?.set) {
		if (a.enabled != null) c.enabled = !!a.enabled;
		if (a.group) c.group = '' + a.group;
		cmcp_writej(f, c);
	}
	let groups = [], now = null;
	try {
		for (let n, p in api('GET', '/proxies', null, 6)?.proxies ?? {})
			if (p.type == 'Selector' && n != 'GLOBAL') { push(groups, n); if (n == c.group) now = p.now; }
	} catch (e) {}
	let r = { enabled: !!c.enabled, group: c.group, now, groups, hist: cmcp_readj('/etc/claude-mcp/autosw_hist.json', []), sub: cmcp_readj('/tmp/cmcp_subinfo.json', null) };
	// 模拟一次：当前节点要是挂了，会换到哪个
	if (a?.dry) {
		let o = trim(sh('/usr/sbin/cmcp-autosw test').out), j = null;
		try { j = json(o); } catch (e) {}
		if (!j) die('模拟失败：' + (o || '没有输出'));
		r.dry = j;
	}
	return r;
};

/* ---------- 设备暂停上网 ---------- */
function pause_out() {
	let p = cmcp_readj('/etc/claude-mcp/pause.json', {}), st = {}, ps = {}, any = false;
	for (let m in p) if (length(p[m]?.plan?.slots ?? [])) any = true;
	try { st = json(trim(sh(SBIN + '/cmcp-pause status').out)) ?? {}; } catch (e) {}
	// 6.0 第 16 项：上网计划现在怎样（能不能上、几点停 / 几点能上、延长到几点）
	if (any) try { ps = json(trim(sh(SBIN + '/cmcp-pause state').out)) ?? {}; } catch (e) {}
	for (let m in p) { p[m].on = !!st[m]; if (ps[m]) p[m].pn = ps[m]; if (p[m].plan) delete p[m].plan.host; }
	return { devs: p, now: time() };
}
// 本地时间比 UTC 快多少分钟
function tz_off() { let m = match(trim(sh('date +%z').out), /^([+-])(\d\d)(\d\d)$/); return m ? (m[1] == '-' ? -1 : 1) * (+m[2] * 60 + +m[3]) : 480; }
P.pause_list = function() { return pause_out(); };
// 6.0 第 16 项：这台手机开通知时告诉官网「这是哪个账号的手机」，这样计划提醒只推给设计划的家长。
// sig = sha256(路由器推送密钥 + ':push:' + 账号)：官网核对得上才记，别人冒充不了
P.push_id = function() {
	let uid = DEV?.uid ?? null;
	if (!uid || !match(uid, /^[a-z2-9]{12}$/)) return { uid: null };
	let k = match(readfile(ETC + '/cloud.conf') ?? '', /RKEY=([A-Za-z0-9_-]+)/);
	if (!k) return { uid: null };
	let h = match(sh('printf %s ' + shq(k[1] + ':push:' + uid) + ' | sha256sum').out, /^([0-9a-f]{64})/);
	return h ? { uid, sig: h[1] } : { uid: null };
};
P.pause_set = function(a) {
	let mac = lc(a?.mac ?? '');
	if (!match(mac, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/)) die('这台设备读不到 MAC 地址，没法暂停');
	// 6.0 第 45 项：有 iptables 用 iptables，只有 nftables 用 nft；两个都没有就说清楚
	if (!stat('/usr/sbin/iptables') && !stat('/usr/sbin/nft') && !getenv('CMCP_PAUSE_NFT')) compat_die('pause', '这台路由器没有 iptables 也没有 nft，暂停上网用不了');
	let f = '/etc/claude-mcp/pause.json', p = cmcp_readj(f, {}), e = p[mac] ?? {};
	if (a.name) e.name = substr('' + a.name, 0, 40);
	if (a.resume) delete e.until;
	// 6.0 第 17 项：记下是谁设的暂停（设备归某个子账号时，别人设的他改不了）
	if (+a.minutes > 0 || +a.until > time() || type(a.sched) == 'array') e.by = DEV?.uid ?? null;
	if (+a.minutes > 0) e.until = time() + int(+a.minutes * 60);
	if (+a.until > time()) e.until = int(+a.until);
	if (type(a.sched) == 'array') {
		e.sched = [];
		for (let s in a.sched)
			if (match(s?.from ?? '', /^([01]?\d|2[0-3]):[0-5]\d$/) && match(s?.to ?? '', /^([01]?\d|2[0-3]):[0-5]\d$/) && s.from != s.to)
				push(e.sched, { from: s.from, to: s.to });
		e.sched = slice(e.sched, 0, 6);
	}
	// 6.0 第 16 项：上网计划（能上网的时段，按星期）；null = 删掉计划
	if (exists(a, 'plan')) {
		if (a.plan == null) { delete e.plan; delete e.ext; }
		else {
			let sl = CL.plan_norm(a.plan), host = null;
			if (!length(sl)) die('至少要有一个能上网的时段');
			// 记下它现在的设备名：以后有新 MAC 用同一个名字（换地址绕过计划）能认出来
			for (let l in split(readfile('/tmp/dhcp.leases') ?? '', '\n')) { let x = split(l, ' '); if (length(x) >= 4 && lc(x[1]) == mac && x[3] != '*') host = x[3]; }
			e.plan = { slots: sl, by: DEV?.uid ?? null, host: host ?? e.plan?.host ?? null, at: time() };
		}
	}
	// 临时延长：在本来停网的时间（或上次延长到的时间）上加 30 分钟 / 1 小时；已经停网了就从现在算
	if (exists(a, 'ext')) {
		if (!length(e.plan?.slots ?? [])) die('这台设备没有上网计划');
		let m = +a.ext, t = time();
		if (m != 30 && m != 60) die('只能延长 30 分钟或 1 小时');
		let n = CL.plan_now(e.plan.slots, t, tz_off()), base = t;
		if (e.ext > t) base = e.ext; else if (n.ok && n.at) base = n.at;
		if (base + m * 60 > t + 12 * 3600) die('最多延长到 12 小时以后');
		e.ext = base + m * 60;
	}
	if (a.ext_off) delete e.ext;
	if (!e.until && !length(e.sched ?? []) && !length(e.plan?.slots ?? [])) delete p[mac]; else p[mac] = e;
	cmcp_writej(f, p);
	// 生成规则；刚开始暂停的设备，现有连接会被马上断开
	sh(SBIN + '/cmcp-pause apply');
	return pause_out();
};

/* ---------- 流量统计 ---------- */
P.traffic = function() {
	let days = {}, names = {};
	for (let f in split(trim(sh('ls /etc/claude-mcp/traffic/*.json 2>/dev/null').out), '\n')) {
		if (!length(f)) continue;
		let m = cmcp_readj(f, null);
		if (!m) continue;
		for (let d in m.days ?? {}) days[d] = m.days[d];
		for (let k in m.names ?? {}) names[k] = m.names[k];
	}
	let st = cmcp_readj('/tmp/cmcp_traf.json', null);
	if (st?.day) { days[st.day] = st.today; for (let k in st.names ?? {}) names[k] = st.names[k]; }
	// 名字：认识的设备 → 现在的 DHCP 名字 → 静态分配起的名字（后面的优先）
	let kn = cmcp_readj('/etc/claude-mcp/known_devices.json', {});
	for (let m in kn) if (kn[m].name && !names[m]) names[m] = kn[m].name;
	for (let l in split(readfile('/tmp/dhcp.leases') ?? '', '\n')) { let f = split(l, ' '); if (length(f) >= 4 && f[3] != '*') names[lc(f[1])] = f[3]; }
	let cur = null;
	for (let l in split(sh("uci -q show dhcp | grep -E '\\.(mac|name)='").out, '\n')) {
		let m = match(l, /^dhcp\.([^.]+)\.(mac|name)='?([^']*)'?$/);
		if (!m) continue;
		cur ??= {}; cur[m[1]] ??= {}; cur[m[1]][m[2]] = m[3];
	}
	for (let s in cur ?? {}) if (cur[s].mac && cur[s].name) for (let mm in split(lc(cur[s].mac), ' ')) names[mm] = cur[s].name;
	// 解开被转码的名字；面板里改过名字的优先
	for (let k in names) names[k] = CL.name_clean(names[k]) ?? names[k];
	for (let m, x in CL.dev_aliases()) if (type(x) == 'object' && x.name) names[m] = x.name;
	return { days, names, today: st?.day ?? null, at: st?.at ?? null };
};

/* ---------- Kwrt 后台菜单（侧边栏自动加入新装的插件） ---------- */
// 用面板的自动登录账号读一次 LuCI 菜单，翻译成中文；只有装 / 卸软件包以后才重新读
P.luci_menu = function(a) {
	let key = trim(sh('date -r /usr/lib/opkg/status +%s 2>/dev/null; ls /usr/share/luci/menu.d /usr/lib/lua/luci/controller 2>/dev/null | md5sum').out);
	let cf = '/tmp/cmcp_menu_list.json', c = cmcp_readj(cf, null);
	if (c && c.key == key && !a?.force) return { items: c.items };
	let pass = trim(readfile('/etc/claude-mcp/luci_pass') ?? '');
	if (!length(pass)) die('还没启用 LuCI 页面的自动登录');
	let jar = '/tmp/cmcp_menu_jar';
	sh(sprintf("curl -s -m 10 -c %s -o /dev/null --data-urlencode 'luci_username=cmcp' --data-urlencode %s http://127.0.0.1/cgi-bin/luci/", jar, shq('luci_password=' + pass)));
	let r = sh(sprintf('curl -s -m 20 -b %s http://127.0.0.1/cgi-bin/luci/admin/menu; rm -f %s', jar, jar)), m = null;
	try { m = json(r.out); } catch (e) {}
	let adm = m?.children?.admin?.children;
	if (!adm) die('读不到 LuCI 的菜单');
	let C = null;
	try { C = require('luci.core'); C.load_catalog('zh-cn', '/usr/lib/lua/luci/i18n'); C.change_catalog('zh-cn'); } catch (e) { C = null; }
	const tr = (s) => (C ? C.translate(s) : null) ?? s;
	const ok = (n) => n && n.title && n.satisfied !== false;
	const kids = (base, n) => {
		let o = [];
		for (let k in n.children ?? {}) if (ok(n.children[k])) push(o, [base + '/' + k, tr(n.children[k].title), +n.children[k].order || 0]);
		return map(sort(o, (x, y) => x[2] - y[2]), (x) => [x[0], x[1]]);
	};
	let items = [];
	for (let cat in adm) {
		let c = adm[cat];
		if (!ok(c) || cat in ['logout', 'menu', 'translations', 'ubus', 'uci']) continue;
		let ch = filter(keys(c.children ?? {}), (k) => ok(c.children[k]));
		// 没有下一级的一级菜单本身就是一个页面
		if (!length(ch)) { push(items, { p: 'admin/' + cat, t: tr(c.title), g: tr(c.title), o: +c.order || 0, kids: [] }); continue; }
		for (let it in ch) {
			let n = c.children[it], p = 'admin/' + cat + '/' + it;
			if (p == 'admin/services/cmcp') continue; // 6.0 第 82 项：原版后台里的「路由器面板」入口，面板里不显示（免得面板里套面板）
			push(items, { p, t: tr(n.title), g: tr(c.title), o: +n.order || 0, kids: kids(p, n) });
		}
	}
	cmcp_writej(cf, { key, items });
	return { items };
};

// 延迟：同一连接连发 3 次请求，取「发出请求 → 收到第一个字节」最短的一次（不受 fake-ip 本地握手影响）
function cmcp_rtt(px, url) {
	let o = sh('curl -s -m 6 ' + px + ' -o /dev/null -o /dev/null -o /dev/null -w ' + shq('%{time_starttransfer} %{time_pretransfer}\n') + ' ' + shq(url) + ' ' + shq(url) + ' ' + shq(url)).out, best = null;
	for (let l in split(trim(o), '\n')) { let x = split(l, ' '), v = (+x[0] - +x[1]) * 1000; if (+x[0] > 0 && (best == null || v < best)) best = v; }
	return best == null ? null : int(best + 0.5);
}
P.speedtest = function(a) {
	let d = '/tmp/cmcp_st', r = { kind: a.kind == 'direct' ? 'direct' : 'proxy' };
	// 同一时间只测一个，避免互相抢带宽（超过 2 分钟的旧锁当作残留）
	if (sh('[ -d ' + d + ' ] && [ $(( $(date +%s) - $(date -r ' + d + ' +%s) )) -lt 120 ]').code == 0) die('正在测速，请稍等');
	sh('rm -rf ' + d + '; mkdir -p ' + d);
	let f = (n) => split(trim(readfile(d + '/' + n) ?? ''), ' ');
	if (r.kind == 'direct') {
		r.ping = cmcp_rtt('', 'https://www.baidu.com/favicon.ico');
		sh(sprintf("curl -sL -o /dev/null -m 8 -w '%%{size_download} %%{time_total}' %s > %s/a & curl -sL -o /dev/null -m 8 -w '%%{size_download} %%{time_total}' %s > %s/b & wait",
			shq('https://mirrors.aliyun.com/ubuntu/ls-lR.gz'), d, shq('https://mirrors.cloud.tencent.com/ubuntu/ls-lR.gz'), d));
		let x = f('a'), y = f('b'), bytes = (+x[0] || 0) + (+y[0] || 0), tt = max(+x[1] || 0, +y[1] || 0);
		r.down = tt > 0 ? (bytes * 8 / tt / 1e6) : 0;
		r.bytes = bytes;
		r.via = '宽带直连（阿里云、腾讯云镜像）';
	} else {
		let user = uci_get('openclash.@authentication[0].username'), pass = uci_get('openclash.@authentication[0].password'), port = uci_get('openclash.config.mixed_port') || '7893';
		let px = '-x ' + shq('http://' + (user && uci_get('openclash.@authentication[0].enabled') == '1' ? user + ':' + pass + '@' : '') + '127.0.0.1:' + port);
		r.ping = cmcp_rtt(px, 'https://speed.cloudflare.com/__down?bytes=0');
		sh(sprintf("curl -s -o /dev/null -m 6 %s -w '%%{size_download} %%{time_total}' 'https://speed.cloudflare.com/__down?bytes=50000000' > %s/a 2>/dev/null </dev/null & curl -s -o /dev/null -m 6 %s -w '%%{size_download} %%{time_total}' 'https://speed.cloudflare.com/__down?bytes=50000000' > %s/b 2>/dev/null </dev/null & sleep 2; true", px, d, px, d));
		// 看看测速走的是哪个节点
		try {
			for (let c in api('GET', '/connections', null, 4)?.connections ?? [])
				if (index(c.metadata?.host ?? '', 'speed.cloudflare.com') >= 0) { r.via = join(' → ', reverse(c.chains ?? [])); break; }
		} catch (e) {}
		sh('i=0; while [ $i -lt 10 ] && [ ! -s ' + d + '/a -o ! -s ' + d + '/b ]; do sleep 1; i=$((i+1)); done');
		let x = f('a'), y = f('b'), bytes = (+x[0] || 0) + (+y[0] || 0), tt = max(+x[1] || 0, +y[1] || 0);
		r.down = tt > 0 ? (bytes * 8 / tt / 1e6) : 0;
		// 上传：从 /dev/zero 边读边传，不占内存
		let u = split(trim(sh("head -c 60000000 /dev/zero | curl -s -o /dev/null -m 5 " + px + " -X POST -T - -H 'Content-Type: application/octet-stream' -w '%{size_upload} %{time_total}' 'https://speed.cloudflare.com/__up'").out), ' ');
		r.up = +u[1] > 0 ? (+u[0] * 8 / +u[1] / 1e6) : 0;
		r.bytes = bytes + (+u[0] || 0);
	}
	sh('rm -rf ' + d);
	r.down = int(r.down * 10 + 0.5) / 10.0; if (r.up != null) r.up = int(r.up * 10 + 0.5) / 10.0;
	r.t = time();
	writefile('/tmp/cmcp_speed_' + r.kind + '.json', sprintf('%J', r));
	return r;
};
P.speed_last = function() {
	return { proxy: cmcp_readj('/tmp/cmcp_speed_proxy.json', null), direct: cmcp_readj('/tmp/cmcp_speed_direct.json', null) };
};


/* ---------- 云端备份（存在 Cloudflare，经路由器转发，面板拿不到云端密钥） ---------- */
// 6.0 第 9 项：一律加密。加密、下载解密、还原都由 cmcp-backup 在后台做（自带加密在慢的路由器上要一两分钟，
// 经 Cloudflare 的请求等不了那么久），进度在 /tmp/cmcp_bkjob.json，面板隔几秒看一次 bk_list
const BK_JOB = '/tmp/cmcp_bkjob.json';
function bk_cloud() {
	let c = {};
	for (let l in split(readfile(ETC + '/cloud.conf') ?? '', '\n')) { let m = match(l, /^([A-Z]+)=(.*)$/); if (m) c[m[1]] = m[2]; }
	if (!c.URL || !c.RKEY) die('还没有设置云端（云端备份是完整版功能）');
	return c;
}
function bk_id(a) { let id = '' + (a.id ?? ''); if (!match(id, /^[a-z0-9]{4,16}$/)) die('备份编号不对'); return id; }
// 现在的后台任务：超过 30 分钟还没做完的当作卡住了（比如中途断电），不再挡着
function bk_job() {
	let j = cmcp_readj(BK_JOB, null);
	if (type(j) != 'object') return null;
	if ((j.state == 'running' || j.state == 'restoring') && time() - (j.at ?? 0) > 1800) j.state = 'stale';
	return j;
}
function bk_start(op, id, extra) {
	let j = bk_job();
	if (j && (j.state == 'running' || j.state == 'restoring')) die(j.op == 'restore' ? '正在还原，等它做完' : j.op == 'now' ? '正在备份，等它做完' : '正在准备下载，等它做完');
	writefile(BK_JOB, sprintf('%J\n', { op, id: id ?? '', state: 'running', msg: '', at: time() }));
	sh(sprintf('( %s/cmcp-backup job %s %s %s ) >/dev/null 2>&1 </dev/null &', SBIN, op, id ?? '""', extra ?? ''));
	return { ok: true, running: true };
}
P.bk_list = function() {
	let c = bk_cloud(), r = sh(sprintf('curl -s -m 20 %s', shq(c.URL + '/bk/' + c.RKEY))), j = null;
	try { j = json(r.out); } catch (e) {}
	if (!j?.ok) die('连不上云端备份' + (j?.error ? '：' + j.error : ''));
	let cron = sh("grep -q cmcp-backup /etc/crontabs/root 2>/dev/null").code == 0;
	// 用哪种方式加密：有 openssl 用它（快），没有就用面板自带的（慢一些，不用装东西）
	let ssl = sh('command -v openssl >/dev/null 2>&1').code == 0;
	return { list: j.list, max: j.max, auto: cron, running: !!stat('/tmp/cmcp_bk.lock'), crypt: ssl ? 'openssl' : 'builtin', job: bk_job() };
};
P.bk_now = function() {
	bk_cloud();
	return bk_start('now');
};
P.bk_del = function(a) {
	let c = bk_cloud(), id = bk_id(a);
	let r = sh(sprintf('curl -s -m 20 -X DELETE %s', shq(c.URL + '/bk/' + c.RKEY + '/' + id))), j = null;
	try { j = json(r.out); } catch (e) {}
	if (!j?.ok) die('删除失败');
	return { ok: true };
};
// 下载：先在后台下载并解密（running），做完了面板再调一次拿下载链接
P.bk_dl = function(a) {
	let id = bk_id(a), j = bk_job(), f = '/tmp/cmcp_bkdl.' + id + '.tgz';
	if (j && j.op == 'dl' && j.id == id && j.state == 'done' && stat(f)) {
		writefile(BK_JOB, sprintf('%J\n', { ...j, state: 'taken' }));
		return dl_put(f, (match('' + (a.name ?? ''), /^[A-Za-z0-9_.-]{1,60}$/) ? a.name : 'router-backup-' + id) + '.tar.gz');
	}
	bk_cloud();
	return bk_start('dl', id);
};
// 还原：在后台先下载并检查、再把现在的设置备份一份，都成功了才还原（sysupgrade -r，和 LuCI「恢复备份」一样），然后重启。
// 钥匙类文件（登录密钥、登录着的手机、门禁钥匙等）保持现在的，见 cmcp-backup 的 KEEP
P.bk_restore = function(a) {
	let id = bk_id(a);
	bk_cloud();
	return bk_start('restore', id, a.force ? 'force' : '');
};

/* ---------- 每日体检：读最近一次结果；run=1 现在体检一次（只更新面板，不推送） ---------- */
P.daily = function(a) {
	if (a?.run) {
		let r = sh('/usr/sbin/cmcp-daily local 2>&1');
		if (r.code != 0) die('体检失败：' + substr(trim(r.out), 0, 200));
	}
	return cmcp_readj('/etc/claude-mcp/daily.json', null) ?? { none: true };
};

/* ---------- 托管版：绑定到官网账号（配对码）、看/移除绑定了这台路由器的账号 ---------- */
function hub_conf(quiet) {
	let c = {};
	for (let f in [ETC + '/hub.conf', ETC + '/cloud.conf'])
		for (let l in split(readfile(f) ?? '', '\n')) { let m = match(l, /^([A-Z]+)=(.*)$/); if (m) c[m[1]] = m[2]; }
	if (!c.HUB || !c.SUB || !c.RKEY) { if (quiet) return null; die('这台路由器没有用托管服务'); }
	return c;
}
function hub_call(path, extra, tmo) {
	let c = hub_conf();
	let b = { sub: c.SUB, rkey: c.RKEY };
	for (let k in extra ?? {}) b[k] = extra[k];
	// 内容先写进临时文件再发（带截图时很大，放在命令行里会超长）
	let tf = trim(sh('mktemp /tmp/cmcp_hub.XXXXXX').out);
	if (!match(tf, /^\/tmp\/cmcp_hub\.[A-Za-z0-9]+$/)) die('路由器上建不了临时文件');
	writefile(tf, sprintf('%J', b));
	let r = sh(sprintf("curl -s -m %d -X POST -H 'Content-Type: application/json' --data-binary @%s %s; rm -f %s", tmo ?? 20, tf, shq(c.HUB + path), tf));
	let o = null;
	try { o = json(r.out); } catch (e) {}
	if (type(o) != 'object') die('连不上托管服务，稍后再试');
	if (o.error) die(o.error);
	return o;
}
P.hub_pair = function() {
	let o = hub_call('/api/pair/start');
	return { code: o.code, exp: o.exp, url: hub_conf().HUB + '/app?pair=' + o.code };
};
/* 托管服务的到期时间（试用 / 续期）：问官网，缓存 1 小时 */
P.svc_info = function(a) {
	let c = hub_conf(true);
	if (!c) return { hosted: false };
	let cf = '/tmp/cmcp_svc.json', o = cmcp_readj(cf, null);
	if (!o || a?.force || time() - (o.at ?? 0) > 3600) {
		let r = null;
		try { r = hub_call('/api/dev/info'); } catch (e) {}
		if (r) { o = { at: time(), exp: r.exp ?? 0, off: !!r.off, why: r.off ? (r.offWhy == 'exp' ? 'exp' : 'admin') : null, files: !!r.files }; writefile(cf, sprintf('%J', o)); }
	}
	return { hosted: true, hub: c.HUB, exp: o?.exp ?? null, off: !!o?.off, why: o?.why ?? null, files: !!o?.files, ed: stat(ETC + '/local') ? 'local' : conf().ai === false ? 'noai' : 'ai' };
};
P.svc_renew = function(a) {
	let code = uc(replace('' + (a?.code ?? ''), /[^A-Za-z0-9]/g, ''));
	if (length(code) < 6) die('续期码不对');
	let r = hub_call('/api/dev/renew', { code });
	sh('rm -f /tmp/cmcp_svc.json');
	return { exp: r.exp, days: r.days };
};
P.hub_accounts = function() { return hub_call('/api/dev/accounts').list ?? []; };
P.hub_unbind = function(a) {
	let uid = '' + (a.uid ?? '');
	if (!match(uid, /^[a-z2-9]{12}$/)) die('账号编号不对');
	hub_call('/api/dev/unbind', { uid });
	return { ok: true };
