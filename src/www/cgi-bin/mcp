		let k = 'network.cmcp_wgp_' + id;
		wg_uci([U + ' set ' + shq(k + '=wireguard_cmcp_wg'), U + ' set ' + shq(k + '.description=' + name), U + ' set ' + shq(k + '.public_key=' + pub),
			U + ' set ' + shq(k + '.preshared_key=' + psk), U + ' add_list ' + shq(k + '.allowed_ips=' + net + '.' + n + '/32'), U + ' set ' + shq(k + '.route_allowed_ips=0')], ['network']);
		if (wg_on()) wg_apply();
		let host = wg_host(o, r);
		res.conf = sprintf('[Interface]\nPrivateKey = %s\nAddress = %s.%d/32\n\n[Peer]\nPublicKey = %s\nPresharedKey = %s\nEndpoint = %s:%d\nAllowedIPs = %s\nPersistentKeepalive = 25\n',
			priv, net, n, spub, psk, host, wg_port(), join(', ', wg_allowed(net)));
		res.name = name; res.file = 'home-' + id + '.conf';
		res.msg = '已添加「' + name + '」';
	} else if (a?.del != null) {
		let id = '' + a.del;
		if (!match(id, /^[0-9]+$/) || uci_get('network.cmcp_wgp_' + id) == null) die('没有这台手机');
		let nm = uci_get('network.cmcp_wgp_' + id + '.description') ?? '手机';
		wg_uci([U + ' delete ' + shq('network.cmcp_wgp_' + id)], ['network']);
		if (wg_on()) wg_apply();
		res.msg = '已删除「' + nm + '」';
	} else die('不知道要改什么');
	cmcp_writej(WG_F, o);
	return { ...P.wg_get({ cands: true }), ...res };
};
// 看门狗每 5 分钟：家里 IP 变了更新官网的地址；只通指定设备的，设备 IP 变了更新防火墙
P.wg_check = function() {
	if (!wg_on()) return { ok: true };
	let o = wg_read(), r = wg_reach(), ch = false;
	if (is_hosted() && r.ok && (r.v4 ?? r.pub4 ?? '') + '|' + (r.v6 ?? '') != o.dip) { wg_dns(o, r); ch = true; }
	if (type(o.only) == 'array') {
		let ip = sp_ipmap(), cur = {}, stale = false;
		for (let s in (uci_load('firewall') ?? [])) if (match(s['.name'] ?? '', /^cmcp_wg_d[0-9]+$/)) cur[s.dest_ip] = true;
		for (let d in o.only) { let a = (d.mac && ip[d.mac]) || d.ip; if (a && !cur[a]) stale = true; }
		if (stale) { wg_uci(wg_only_cmds(o), ['firewall']); sh(getenv('CMCP_WG_APPLY') ?? '/etc/init.d/firewall reload >/dev/null 2>&1'); }
	}
	if (ch) cmcp_writej(WG_F, o);
	return { ok: true, dns: ch };
};
/* ---------------- 6.0 第 38 项：安卓桌面小组件（网速、在线设备数） ----------------
 * 用户 11/26 定：小组件用一把只能看网速和在线设备数的钥匙，能在「登录着的设备」里撤销。
 * 在 App 里打开面板 →「系统操作 → 桌面小组件」→ 路由器发一把小组件钥匙（编号.密钥，存 widget.json）→ App 存起来。
 * 小组件只走 /cgi-bin/mcp/widget，只能调 panel/widget，只回网速、在线设备数和路由器名字。
 * 列在「登录着的设备」里（编号前面加 w:），移除就失效；子账号只看得到、只能移除自己加的。 */
const WD_F = ETC + '/widget.json';
function wd_read() { let o = cmcp_readj(WD_F, {}); return type(o) == 'object' ? o : {}; }
function wd_name() { return trim(readfile('/proc/sys/kernel/hostname') ?? '') || '路由器'; }
P.widget_new = function(a) {
	let d = wd_read(), mine = 0;
	for (let k in d) if ((d[k].uid ?? '') == (DEV?.uid ?? '')) mine++;
	if (mine >= 5) die('最多加 5 个小组件：先在「登录着的设备」里移除不用的');
	let id = rand_str(8), s = rand_str(32);
	if (!id || !s) die('生成钥匙失败，再试一次');
	d[id] = { s, name: substr(DEV?.name ?? '手机', 0, 40), at: time(), uid: DEV?.uid ?? '', dev: DEV_ID ?? '' };
	cmcp_writej(WD_F, d);
	return { k: id + '.' + s, name: wd_name() };
};
// 小组件来取数据（只在 /widget 地址上能调）
P.widget = function(a) {
	let m = match('' + (a?.k ?? ''), /^([a-z0-9]{8})\.([a-z0-9]{32})$/), d = m ? wd_read()[m[1]] : null;
	if (!d || d.s != m[2]) die('小组件失效了：在 App 里重新添加');
	// 隔 1 秒采两次，算现在的网速（小组件很久才来一次，不能用上一次的采样）
	let l = P.live();
	if (l.rx == null) { sh('F=/tmp/cmcp_wd.$$; mkfifo $F && { read -t 1 x <> $F; rm -f $F; }'); l = P.live(); }
	let n = null; try { n = P.home_stats()?.devices?.online; } catch (e) {}
	let sn = seen_read(), t = time();
	if (t - (sn['w:' + m[1]] ?? 0) > 60) { sn['w:' + m[1]] = t; writefile(SEEN_PATH, sprintf('%J', sn)); }
	return { rx: l.rx, tx: l.tx, n, name: wd_name(), t };
};
// 「登录着的设备」：小组件也列出来，能移除
const WD_LIST0 = P.device_list, WD_RM0 = P.device_remove;
P.device_list = function(a) {
	let r = WD_LIST0(a), d = wd_read(), sn = seen_read();
	for (let id in d) if (ROLE != 'sub' || (DEV?.uid && d[id].uid == DEV.uid)) push(r.list, { id: 'w:' + id, name: '桌面小组件（' + d[id].name + '）', at: d[id].at, seen: sn['w:' + id] ?? null, kind: 'widget' });
	return r;
};
P.device_remove = function(a) {
	let id = '' + (a?.id ?? '');
	if (match(id, /^w:[a-z0-9]{8}$/)) {
		need_sudo(a);
		let d = wd_read(), k = substr(id, 2);
		if (!d[k] || (ROLE == 'sub' && d[k].uid != DEV?.uid)) die('没有这个小组件');
		delete d[k];
		cmcp_writej(WD_F, d);
		return { ok: true };
	}
	let r = WD_RM0(a);
	// 「让其他手机都退出」：小组件一起失效（子账号只清自己的）
	if (a?.all_others) {
		let d = wd_read();
		for (let k in keys(d)) if (ROLE != 'sub' || d[k].uid == DEV?.uid) delete d[k];
		cmcp_writej(WD_F, d);
	}
	return r;
};
function rpc_result(id, result) { return { jsonrpc: '2.0', id, result }; }
function rpc_error(id, code, message) { return { jsonrpc: '2.0', id, error: { code, message } }; }

function handle(msg) {
	if (type(msg) != 'object' || msg.jsonrpc != '2.0' || type(msg.method) != 'string')
		return rpc_error(msg?.id ?? null, -32600, 'Invalid Request');

	let id = msg.id, p = msg.params ?? {};
	let is_notification = !exists(msg, 'id');

	// 连接器地址：只给 AI 用，不能调面板接口
	if (MODE == 'ai' && substr(msg.method, 0, 6) == 'panel/')
		return is_notification ? null : rpc_error(id, -32001, '这是 AI 连接器地址，不能用来打开面板');
	// 官网「打开面板」的入口：只能拿票换手机钥匙
	if (MODE == 'open') {
		// 6.0：手机不再存登录密钥，输登录码（官网的或应急的）也从这里进；登录码 8 位、10 分钟最多错 10 次
		if (msg.method != 'panel/open_login' && msg.method != 'panel/device_approve') return is_notification ? null : rpc_error(id, -32601, 'not found');
		try { return rpc_result(id, msg.method == 'panel/open_login' ? P.open_login(p) : P.device_approve(p)); }
		catch (e) { return rpc_error(id, -32000, type(e) == 'object' ? e.message : '' + e); }
	}
	// 6.0 第 82 项：家里局域网（:906）登录：只能用原版后台给的票，或者输路由器后台密码换手机钥匙（只认局域网来的请求）
	if (MODE == 'lan') {
		// 第 25 项：改了路由器地址，在新地址上点「保留」（凭改的时候发的编号）
		if (msg.method != 'panel/lan_open' && msg.method != 'panel/lan_pw' && msg.method != 'panel/lan_keep') return is_notification ? null : rpc_error(id, -32601, 'not found');
		try { return rpc_result(id, msg.method == 'panel/lan_open' ? P.lan_open(p) : msg.method == 'panel/lan_keep' ? P.lan_keep(p) : P.lan_pw(p)); }
		catch (e) { return rpc_error(id, -32000, type(e) == 'object' ? e.message : '' + e); }
	}
	// 6.0 第 38 项：桌面小组件的地址：只能拿网速和在线设备数（凭小组件钥匙）
	if (MODE == 'widget') {
		if (msg.method != 'panel/widget') return is_notification ? null : rpc_error(id, -32601, 'not found');
		try { return rpc_result(id, P.widget(p)); }
		catch (e) { return rpc_error(id, -32000, type(e) == 'object' ? e.message : '' + e); }
	}
	// 6.0 第 6 项：通行证地址。只有「拿手机钥匙换通行证」不用带通行证；别的请求都要带，并且只给手机面板用
	if (MODE == 'pass') {
		if (msg.method == 'panel/pass_new') return is_notification ? null : pass_new_rpc(id, p);
		if (!pass_ok(msg.pass)) return is_notification ? null : { jsonrpc: '2.0', id, error: { code: -32013, message: '通行证过期了' } };
		if (msg.client != 'panel') return is_notification ? null : rpc_error(id, -32001, '这个地址只给手机面板用');
	}
	// 自建版开了「登录要输路由器密码」（第 12 项）：登录地址只能用来换手机钥匙，不能直接操作路由器
	// （路由器自己的小工具带 local. 钥匙照常；AI 用单独的连接器地址，不受影响）
	if (MODE == 'token' && !NEED_DEV && login_pw_on() && msg.method != 'panel/pass_login' && !(type(msg.dev) == 'string' && dev_ok(msg.dev)))
		return is_notification ? null : { jsonrpc: '2.0', id, error: { code: -32015, message: msg.client == 'panel' ? '这台路由器开了「登录要输路由器后台密码」：输一下路由器后台（root）密码' : '这台路由器开了「登录要输路由器后台密码」，登录地址不能直接用。AI 请用「我的主页 → 敏感信息」里的 AI 连接器地址' } };
	// 托管版的登录密钥地址：每个请求都要带上这台手机的钥匙（从官网打开面板时拿到的）
	if (MODE == 'token' && NEED_DEV && msg.method != 'panel/device_approve' && !dev_ok(msg.dev)) {
		if (is_notification) return null;
		let h = hub_conf(true)?.HUB ?? null;
		return { jsonrpc: '2.0', id, error: { code: -32010,
			message: msg.client == 'panel'
				? '这台手机还没登录：从官网「我的路由器」点「打开面板」进来'
				: '托管版的 AI 连接器要用单独的「AI 连接器地址」：在手机面板「我的主页 → 敏感信息」（验证后）的「AI 连接器地址」里复制，然后在 AI 应用里把这个连接器删掉，用新地址重新添加',
			data: { need_code: true, hub: h } } };
	}
	// 主账号 / 子账号：按这台手机属于哪个账号检查权限
	if (NEED_DEV && DEV) { // 托管版：登录密钥地址（旧手机）和通行证地址都按账号查权限
		let why = fam_check();
		if (why) {
			if (is_notification) return null;
			return { jsonrpc: '2.0', id, error: { code: DEV ? -32011 : -32010, message: why, data: { need_code: !DEV, hub: hub_conf(true)?.HUB ?? null } } };
		}
		let m = msg.method == 'tools/call' ? 'tools:' + (p.name ?? '') : substr(msg.method, 0, 6) == 'panel/' ? substr(msg.method, 6) : null;
		if (m && !fam_allowed(m, p)) return is_notification ? null : rpc_error(id, -32012, fam_deny_msg(m, p));
	}
	// 6.0 第 94 项：托管服务到期 / 停用：只留看状态、输续期码
	{ let why = svc_gate(msg, p); if (why) return is_notification ? null : { jsonrpc: '2.0', id, error: { code: -32016, message: why, data: { svc_off: true } } }; }
	// 纯面板版（config.json 里 "ai": false）：只接受手机面板的请求，AI 客户端连不上
	if (conf().ai === false && msg.client != 'panel')
		return is_notification ? null : rpc_error(id, -32001, '这台路由器装的是纯面板版，没有开启 AI 连接器');

	if (substr(msg.method, 0, 6) == 'panel/') {
		let fn = P[substr(msg.method, 6)];
		if (type(fn) != 'function') return rpc_error(id, -32601, '面板接口不存在：' + msg.method);
		ERR_CODE = null;
		try { return rpc_result(id, fn(p)); }
