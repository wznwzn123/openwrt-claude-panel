	sh('rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache 2>/dev/null; logger -t claude-mcp ' + shq('面板里卸载了 ' + n));
	let f1 = match(sh('df -k /overlay 2>/dev/null | awk \'NR==2 { print $4 }\'').out, /(\d+)/);
