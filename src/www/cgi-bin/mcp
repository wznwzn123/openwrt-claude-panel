	let m = match(t, /Server:[ \t]*([^ \t\n]+)/);
	if (m) r.server = m[1];
	let ans = false;
	for (let l in split(t, '\n')) {
		if (match(l, /^Name:/)) { ans = true; continue; }
		let c = match(l, /canonical name = ([^ \t]+)$/);
		if (c) { let cn = replace(c[1], /\.$/, ''); if (index(r.cname, cn) < 0) push(r.cname, cn); continue; }
		let a = match(l, /^Address( [0-9]+)?:[ \t]*([0-9A-Fa-f.:]+)/);
		if (a && ans) { let ip = replace(a[2], /#.*$/, ''); if (index(r.ips, ip) < 0) push(r.ips, ip); }
	}
	if (!length(r.ips)) {
		if (match(t, /NXDOMAIN|can't find|can't resolve|not found/i)) die('找不到「' + addr + '」：这个域名不存在');
		die('查不到「' + addr + '」：' + (length(trim(t)) ? substr(trim(t), -200) : '路由器的 DNS 没有回应'));
	}
	r.fake = length(filter(r.ips, (ip) => match(ip, ND_FAKE))) > 0;
	return r;
}
P.netdiag = function(a) {
	let addr = nd_addr(a?.addr), t = a?.tool;
	if (t == 'ping') return nd_ping(addr);
	if (t == 'trace') return nd_trace(addr);
	if (t == 'dns') return nd_dns(addr);
	die('不支持的诊断');
};
P.netdiag_caps = function() {
	return { ping: nd_has('ping'), trace: nd_has('traceroute'), dns: nd_has('nslookup') };
};

/* ---------------- 6.0 第 18 项：端口转发 ----------------
 * 手机上增删改端口转发（防火墙的 redirect，fw3 / fw4 都是同一份 uci 配置）。
 * 安全：不让把路由器自己的管理端口（网页后台、SSH、面板局域网入口）转出去，也不让转到路由器自己；
 * 目标只能是家里局域网里的设备；改完走「90 秒确认」（cmcp-netguard），不点「保留」自动改回去，并推送。
 * 面板新建的规则名字叫 cmcp_pf_xxxxxx；原来就有的规则也列出来，能开关、删除，简单的也能改。 */
const PF_OPTS = { name: 1, src: 1, dest: 1, target: 1, proto: 1, src_dport: 1, dest_ip: 1, dest_port: 1, enabled: 1, family: 1, reflection: 1 };
function pf_lan() {
	let v = uci_get('network.lan.ipaddr') ?? '', ip = trim(split(split(v, ' ')[0], '/')[0]), m = match(v, /\/([0-9]+)/);
	let pl = m ? +m[1] : mask_len(uci_get('network.lan.netmask') ?? '255.255.255.0');
	return v4int(ip) == null ? null : { ip, pl };
}
// 路由器自己在用的端口：网页后台（uhttpd 的 http / https）、SSH（dropbear）、面板局域网入口
function pf_reserved() {
	let r = {};
	for (let k in ['listen_http', 'listen_https']) for (let a in as_list(uci_get('uhttpd.main.' + k))) { let m = match(a, /:([0-9]+)$/); if (m) r[+m[1]] = '路由器网页后台'; }
	if (!length(keys(r))) { r[80] = '路由器网页后台'; r[443] = '路由器网页后台'; }
	let ssh = false;
	for (let s in (uci_load('dropbear') ?? [])) if (s['.type'] == 'dropbear') { r[+(s.Port ?? s.port ?? 22) || 22] = 'SSH'; ssh = true; }
	if (!ssh) r[22] = 'SSH';
	r[+trim(readfile(ETC + '/lan_port') ?? '') || 906] = '面板';
	return r;
}
function pf_range(s) {
	let m = match(trim('' + (s ?? '')), /^([0-9]{1,5})(-([0-9]{1,5}))?$/);
	if (!m) return null;
	let a = +m[1], b = m[3] ? +m[3] : a;
	return a >= 1 && b <= 65535 && a <= b ? [a, b] : null;
}
function pf_protos(p) {
	let l = as_list(p ?? 'tcp udp');
	return length(l) && index(l, 'all') < 0 ? l : ['tcp', 'udp'];
}
function pf_rules() {
	let L = [];
	for (let s in (uci_load('firewall') ?? [])) {
		if (s['.type'] != 'redirect' || (s.target ?? 'DNAT') != 'DNAT' || (s.src ?? '') != 'wan') continue;
		let x = { id: s['.name'], name: s.name ?? '', proto: join(' ', pf_protos(s.proto)), ext: s.src_dport ?? '', ip: s.dest_ip ?? '', port: s.dest_port ?? '', on: (s.enabled ?? '1') != '0', mine: !!match(s['.name'], /^cmcp_pf_/) };
		x.edit = !!pf_range(x.ext) && v4int(x.ip) != null;
		for (let k in keys(s)) if (substr(k, 0, 1) != '.' && !PF_OPTS[k]) x.edit = false;
		push(L, x);
	}
	return L;
}
function pf_wan() {
	let w = null;
	try { w = json(sh('ubus call network.interface.wan status 2>/dev/null').out); } catch (e) {}
	let ip = w?.['ipv4-address']?.[0]?.address ?? null;
	// 运营商给的是内网地址（大内网 / 光猫拨号）：从外面连不进来
	let inner = ip ? !!(match(ip, /^10\./) || match(ip, /^192\.168\./) || match(ip, /^172\.(1[6-9]|2[0-9]|3[01])\./) || match(ip, /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./)) : false;
	return { ip, inner };
}
P.pf_list = function() {
	let res = pf_reserved(), lan = pf_lan();
	return { list: pf_rules(), wan: pf_wan(), lan: lan ? lan.ip + '/' + lan.pl : null, reserved: map(sort(keys(res), (a, b) => +a - +b), (k) => ({ port: +k, what: res[k] })), pending: ng_pending() };
};
// a: { op: add | edit | del | on | off, id, name, proto: tcp|udp|both, ext, ip, port }
P.pf_set = function(a) {
	let op = a?.op;
	if (index(['add', 'edit', 'del', 'on', 'off'], op) < 0) die('不支持的操作');
	ng_busy();
	let L = pf_rules(), cur = null;
	if (op != 'add') { for (let x in L) if (x.id == a?.id) cur = x; if (!cur) die('没有这条端口转发'); }
	let U = conf().uci, cmds = [], set = (sid, k, v) => push(cmds, U + ' set ' + shq('firewall.' + sid + (k ? '.' + k : '') + '=' + v)), sum = '';
	if (op == 'add' || op == 'edit') {
		if (op == 'edit' && !cur.edit) die('这条规则有面板不认识的设置，在原版后台里改');
		let ext = pf_range(a?.ext);
		if (!ext) die('外部端口填 1–65535 的数字，或者一段，比如 8000-8010');
		let port = length(trim('' + (a?.port ?? ''))) ? pf_range(a.port) : ext;
		if (!port) die('内部端口填 1–65535 的数字');
		if (port[1] - port[0] != ext[1] - ext[0]) die('外部和内部端口的个数要一样');
		let res = pf_reserved();
		for (let k in keys(res)) if (+k >= ext[0] && +k <= ext[1]) die('不能转发 ' + k + ' 端口：' + res[k] + (match(res[k], /[A-Za-z]$/) ? ' ' : '') + '要用');
		let ip = trim('' + (a?.ip ?? '')), lan = pf_lan();
		if (v4int(ip) == null) die('设备地址不对，比如 192.168.1.100');
		if (!lan || !cidr_has(lan.ip, lan.pl, ip)) die('只能转到家里局域网的设备' + (lan ? '（' + lan.ip + '/' + lan.pl + '）' : ''));
		if (ip == lan.ip) die('不能转到路由器自己');
		let size = pow2(32 - lan.pl), off = v4int(ip) % size;
		if (lan.pl <= 30 && (off == 0 || off == size - 1)) die('设备地址不对，比如 ' + replace(lan.ip, /[0-9]+$/, '100'));
		let pr = a?.proto == 'tcp' ? 'tcp' : a?.proto == 'udp' ? 'udp' : 'tcp udp';
		// 跟别的开着的规则撞端口（同一个协议）
		for (let x in L) {
			if (!x.on || (cur && x.id == cur.id)) continue;
			let r = pf_range(x.ext);
			if (!r || r[1] < ext[0] || r[0] > ext[1]) continue;
			for (let p in split(pr, ' ')) if (index(split(x.proto, ' '), p) >= 0) die('外部端口 ' + x.ext + ' 已经转给' + (length(x.name) ? '「' + x.name + '」' : ' ' + x.ip) + '了');
		}
		let nm = trim('' + (a?.name ?? ''));
		if (match(nm, /[[:cntrl:]]/) || length(nm) > 60) die('名字太长或有不能用的字符');
		if (!length(nm)) nm = ip + ' ' + (ext[0] == ext[1] ? ext[0] : ext[0] + '-' + ext[1]);
		let sid = cur ? cur.id : null;
		if (!sid) { let r = rand_str(6); if (!r) die('路由器生成不了随机数，稍后再试'); sid = 'cmcp_pf_' + r; set(sid, null, 'redirect'); }
		let es = ext[0] == ext[1] ? '' + ext[0] : ext[0] + '-' + ext[1], ps = port[0] == port[1] ? '' + port[0] : port[0] + '-' + port[1];
		set(sid, 'name', nm); set(sid, 'target', 'DNAT'); set(sid, 'src', 'wan'); set(sid, 'dest', 'lan'); set(sid, 'proto', pr);
		set(sid, 'src_dport', es); set(sid, 'dest_ip', ip); set(sid, 'dest_port', ps);
		if (op == 'add') set(sid, 'enabled', '1');
		sum = '外部端口 ' + es + ' → ' + ip + ':' + ps;
	} else if (op == 'del') {
		push(cmds, U + ' delete ' + shq('firewall.' + cur.id));
		sum = '删掉了「' + (cur.name || cur.ext) + '」';
	} else {
		if (op == 'on') { let r = pf_range(cur.ext); for (let x in L) { let q = pf_range(x.ext); if (x.on && x.id != cur.id && r && q && !(q[1] < r[0] || q[0] > r[1])) die('外部端口 ' + x.ext + ' 已经转给' + (length(x.name) ? '「' + x.name + '」' : ' ' + x.ip) + '了，先关掉它'); } }
		set(cur.id, 'enabled', op == 'on' ? '1' : '0');
		sum = (op == 'on' ? '打开了「' : '关掉了「') + (cur.name || cur.ext) + '」';
	}
	let tok = rand_str(16);
	if (!tok) die('路由器生成不了随机数，稍后再试');
	sh('rm -rf ' + shq(NG) + ' && mkdir -p ' + shq(NG + '/files') + ' && cp -f ' + shq(ucdir() + '/firewall') + ' ' + shq(NG + '/files/firewall'));
	if (!stat(NG + '/files/firewall')) die('备份原来的设置失败，没有改');
	writefile(NG + '/what', '端口转发');
	writefile(NG + '/reload', '/etc/init.d/firewall reload\n');
	writefile(NG + '/until', '' + (time() + NG_WAIT + 15));
	writefile(NG + '/token', tok);
	let r = sh(join(' && ', cmds) + ' && ' + U + ' commit firewall');
	if (r.code != 0) {
		sh(U + ' revert firewall; cp -f ' + shq(NG + '/files/firewall') + ' ' + shq(ucdir() + '/firewall') + '; rm -rf ' + shq(NG));
		die('保存失败，没有改：' + trim_nl(r.out));
	}
	bg(sprintf('CMCP_NG=%s CMCP_UCI_DIR=%s CMCP_SBIN=%s %s/cmcp-netguard run %s', shq(NG), shq(ucdir()), shq(SBIN), SBIN, tok));
	try { sh(sprintf('%s/cmcp-notify info net %s %s net >/dev/null 2>&1', SBIN, shq('端口转发改了：' + sum), shq('90 秒内没点「保留」会自动改回去。'))); } catch (e) {}
	return { changed: true, token: tok, wait: NG_WAIT };
};
function rpc_result(id, result) { return { jsonrpc: '2.0', id, result }; }
function rpc_error(id, code, message) { return { jsonrpc: '2.0', id, error: { code, message } }; }

function handle(msg) {
	if (type(msg) != 'object' || msg.jsonrpc != '2.0' || type(msg.method) != 'string')
		return rpc_error(msg?.id ?? null, -32600, 'Invalid Request');

	let id = msg.id, p = msg.params ?? {};
	let is_notification = !exists(msg, 'id');

	// 连接器地址：只给 AI 用，不能调面板接口
	if (MODE == 'ai' && substr(msg.method, 0, 6) == 'panel/')
		return is_notification ? null : rpc_error(id, -32001, '这是 AI 连接器地址，不能用来打开面板');
	// 官网「打开面板」的入口：只能拿票换手机钥匙
	if (MODE == 'open') {
		// 6.0：手机不再存登录密钥，输登录码（官网的或应急的）也从这里进；登录码 8 位、10 分钟最多错 10 次
		if (msg.method != 'panel/open_login' && msg.method != 'panel/device_approve') return is_notification ? null : rpc_error(id, -32601, 'not found');
		try { return rpc_result(id, msg.method == 'panel/open_login' ? P.open_login(p) : P.device_approve(p)); }
		catch (e) { return rpc_error(id, -32000, type(e) == 'object' ? e.message : '' + e); }
	}
	// 6.0 第 82 项：家里局域网（:906）登录：只能用原版后台给的票，或者输路由器后台密码换手机钥匙（只认局域网来的请求）
	if (MODE == 'lan') {
		if (msg.method != 'panel/lan_open' && msg.method != 'panel/lan_pw') return is_notification ? null : rpc_error(id, -32601, 'not found');
		try { return rpc_result(id, msg.method == 'panel/lan_open' ? P.lan_open(p) : P.lan_pw(p)); }
		catch (e) { return rpc_error(id, -32000, type(e) == 'object' ? e.message : '' + e); }
	}
	// 6.0 第 6 项：通行证地址。只有「拿手机钥匙换通行证」不用带通行证；别的请求都要带，并且只给手机面板用
	if (MODE == 'pass') {
		if (msg.method == 'panel/pass_new') return is_notification ? null : pass_new_rpc(id, p);
		if (!pass_ok(msg.pass)) return is_notification ? null : { jsonrpc: '2.0', id, error: { code: -32013, message: '通行证过期了' } };
		if (msg.client != 'panel') return is_notification ? null : rpc_error(id, -32001, '这个地址只给手机面板用');
	}
	// 自建版开了「登录要输路由器密码」（第 12 项）：登录地址只能用来换手机钥匙，不能直接操作路由器
	// （路由器自己的小工具带 local. 钥匙照常；AI 用单独的连接器地址，不受影响）
	if (MODE == 'token' && !NEED_DEV && login_pw_on() && msg.method != 'panel/pass_login' && !(type(msg.dev) == 'string' && dev_ok(msg.dev)))
		return is_notification ? null : { jsonrpc: '2.0', id, error: { code: -32015, message: msg.client == 'panel' ? '这台路由器开了「登录要输路由器后台密码」：输一下路由器后台（root）密码' : '这台路由器开了「登录要输路由器后台密码」，登录地址不能直接用。AI 请用「我的主页 → 敏感信息」里的 AI 连接器地址' } };
	// 托管版的登录密钥地址：每个请求都要带上这台手机的钥匙（从官网打开面板时拿到的）
	if (MODE == 'token' && NEED_DEV && msg.method != 'panel/device_approve' && !dev_ok(msg.dev)) {
		if (is_notification) return null;
		let h = hub_conf(true)?.HUB ?? null;
		return { jsonrpc: '2.0', id, error: { code: -32010,
			message: msg.client == 'panel'
				? '这台手机还没登录：从官网「我的路由器」点「打开面板」进来'
				: '托管版的 AI 连接器要用单独的「AI 连接器地址」：在手机面板「我的主页 → 敏感信息」（验证后）的「AI 连接器地址」里复制，然后在 AI 应用里把这个连接器删掉，用新地址重新添加',
			data: { need_code: true, hub: h } } };
	}
	// 主账号 / 子账号：按这台手机属于哪个账号检查权限
	if (NEED_DEV && DEV) { // 托管版：登录密钥地址（旧手机）和通行证地址都按账号查权限
		let why = fam_check();
		if (why) {
			if (is_notification) return null;
			return { jsonrpc: '2.0', id, error: { code: DEV ? -32011 : -32010, message: why, data: { need_code: !DEV, hub: hub_conf(true)?.HUB ?? null } } };
		}
		let m = msg.method == 'tools/call' ? 'tools:' + (p.name ?? '') : substr(msg.method, 0, 6) == 'panel/' ? substr(msg.method, 6) : null;
		if (m && !fam_allowed(m, p)) return is_notification ? null : rpc_error(id, -32012, fam_deny_msg(m, p));
	}
	// 6.0 第 94 项：托管服务到期 / 停用：只留看状态、输续期码
	{ let why = svc_gate(msg, p); if (why) return is_notification ? null : { jsonrpc: '2.0', id, error: { code: -32016, message: why, data: { svc_off: true } } }; }
	// 纯面板版（config.json 里 "ai": false）：只接受手机面板的请求，AI 客户端连不上
	if (conf().ai === false && msg.client != 'panel')
		return is_notification ? null : rpc_error(id, -32001, '这台路由器装的是纯面板版，没有开启 AI 连接器');

	if (substr(msg.method, 0, 6) == 'panel/') {
		let fn = P[substr(msg.method, 6)];
		if (type(fn) != 'function') return rpc_error(id, -32601, '面板接口不存在：' + msg.method);
		ERR_CODE = null;
		try { return rpc_result(id, fn(p)); }
		catch (e) { return rpc_error(id, ERR_CODE ?? -32000, type(e) == 'object' ? e.message : '' + e); }
	}

	switch (msg.method) {
	case 'initialize':
		return rpc_result(id, {
			protocolVersion: index(PROTOCOLS, p.protocolVersion) >= 0 ? p.protocolVersion : PROTOCOLS[1],
			capabilities: { tools: { listChanged: false } },
			serverInfo: { name: 'openwrt-router', title: '我的路由器', version: VERSION },
			instructions: '这是用户家里 OpenWrt 路由器（可能装有 OpenClash、OAF 应用过滤等插件，先用工具查看实际情况）的完整管理工具，可查看状态、设备、网速，控制服务，读写任意 uci 配置，执行命令。断网类操作（改 network/firewall、重启路由器或网络、停止服务）一旦出错，用户会失去网络、你也会失去连接，执行前必须说明影响并得到用户确认。修改规则前先 get_custom_rules 读取原文件并在其基础上修改；节点名必须用 list_proxy_groups 返回的准确名称（含国旗和空格）。set_custom_rules / restart_openclash 会让网络中断 10–30 秒，执行前告诉用户。' +
				(MODE == 'ai' || msg.client != 'panel' ? (ai_mode() == 'ro' ? '\n现在是「只读」：只能查看，不能修改；命令行只能跑只看的命令（cat、ls、logread、uci show 等，不能用 ; & $ > <）。' : ai_mode() == 'ask' ? '\n重启、改设置、装卸软件、改规则、执行会改东西的命令，要用户先在手机上点「允许」：工具会推送到手机并等 30 秒，等不到会告诉你，等用户确认后原样再调用一次。只看的命令（cat、ls、logread、uci show 等）直接执行。' : '') : '')
		});
	case 'ping':
		return rpc_result(id, {});
	case 'tools/list':
	{
		// 6.0 第 11 项：AI「只读」时只列出查看类的工具（命令行留着，只能跑只看的命令）
		let ro = MODE == 'ai' || msg.client != 'panel' ? ai_mode() == 'ro' : false;
		return rpc_result(id, { tools: filter(TOOLS, (t) => !(t.name == 'run_command' && conf().allow_shell === false) && (!ro || t.name == 'run_command' || AI_READ[t.name] || t.name == 'packages' || t.name == 'uci_backups')) });
	}
	case 'tools/call': {
		let fn = T[p.name];
		if (!fn)
			return rpc_error(id, -32602, '未知工具：' + p.name);
		AI_STOP = false;
		try {
			// 6.0 第 11 项：AI 连接器（和不是手机面板的客户端）做危险操作要先在手机上确认
			if (MODE == 'ai' || msg.client != 'panel') ai_gate(p.name, p.arguments ?? {});
			let text = fn(p.arguments ?? {});
			return rpc_result(id, { content: [{ type: 'text', text: '' + text }] });
		} catch (e) {
			let m = type(e) == 'object' ? e.message : '' + e;
			return rpc_result(id, { content: [{ type: 'text', text: (AI_STOP ? '' : '出错：') + m }], isError: true });
		}
	}
	default:
		if (is_notification || match(msg.method, /^notifications\//))
			return null;
		return rpc_error(id, -32601, 'Method not found: ' + msg.method);
	}
}

function reply(status, body, extra) {
	print('Status: ' + status + '\r\n');
	print('Cache-Control: no-store\r\n');
	if (extra) print(extra);
	if (body != null) {
		print('Content-Type: application/json\r\n\r\n');
		print(sprintf('%J', body));
	} else
		print('Content-Length: 0\r\n\r\n');
}

/* 记录每个请求在路由器上花了多久（排查「面板慢」用），只留最近的 */
function reqlog(msg, t0, r) {
	try {
		let t1 = clock(true), ms = ((t1[0] - t0[0]) * 1000000000 + (t1[1] - t0[1])) / 1000000;
		let m = msg?.method ?? '?';
		if (m == 'tools/call') m += ':' + (msg.params?.name ?? '');
		let lf = '/tmp/cmcp_req.log', st = stat(lf);
		if (st && st.size > 65536) rename(lf, lf + '.1');  // 请求记录在内存里：最多两份各 64 KB
		let h = fs_open(lf, 'a');
		if (h) { h.write(sprintf('%d %s %d %s\n', time(), m, ms, r?.error ? 'ERR' : 'ok')); h.close(); }
	} catch (e) {}
}


function main() {
	let c = conf();
	let token = c.token ?? '', ckey = c.ckey ?? '';
	let path = getenv('PATH_INFO') ?? '';

	if (c.ai !== false && length(ckey) >= 16 && path == '/' + ckey)
		MODE = 'ai';
	else if (path == '/open' && is_hosted())
		MODE = 'open';
	else if (path == '/pass')
		MODE = 'pass';
	else if (path == '/lan')
		MODE = 'lan';
	else if (length(token) < 16 || path != '/' + token) {
		reply('404 Not Found', { error: 'not found' });
		return;
	}
	NEED_DEV = (MODE == 'token' || MODE == 'pass') && is_hosted();

	let method = getenv('REQUEST_METHOD') ?? 'GET';
	if (method == 'GET' || method == 'HEAD') {
		reply('405 Method Not Allowed', null, 'Allow: POST, DELETE\r\n');
		return;
	}
	if (method == 'DELETE') {
		reply('200 OK', null);
		return;
	}
	if (method != 'POST') {
		reply('405 Method Not Allowed', null, 'Allow: POST\r\n');
		return;
	}

	let len = +(getenv('CONTENT_LENGTH') ?? 0);
	if (len <= 0 || len > 4 * 1024 * 1024) {
		reply('400 Bad Request', rpc_error(null, -32700, 'Empty or oversized body'));
		return;
	}
	let body = '';
	while (length(body) < len) {
		let chunk = stdin.read(len - length(body));
		if (chunk == null || !length(chunk)) break;
		body += chunk;
	}

	let msg = null;
	try { msg = json(body); } catch (e) {
		reply('400 Bad Request', rpc_error(null, -32700, 'Parse error'));
		return;
	}

	if (type(msg) == 'array') {
		let res = [];
		for (let m in msg) {
			let r = handle(m);
			if (r != null) push(res, r);
		}
		if (length(res)) reply('200 OK', res); else reply('202 Accepted', null);
		return;
	}

	let t0 = clock(true);
	let r = handle(msg);
	if (r == null)
		reply('202 Accepted', null);
	else
		reply('200 OK', r);
	reqlog(msg, t0, r);
}

main();
