	}
	if (a?.ftp) {
		let k = ftp_kind();
		if (!k) die('没装 FTP');
		if (a.ftp.on) { ss_do(k, 'enable'); ss_do(k, 'restart'); }
		else { ss_do(k, 'stop'); ss_do(k, 'disable'); }
	}
