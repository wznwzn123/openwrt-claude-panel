	if (ROLE != 'sub' || !DEV?.uid || !DEV_ID) return;
	let ip = own_lan_ip();
	if (!ip) {
		let st = cmcp_readj(OWN_AUTO, {});
		if (type(st) != 'object') st = {};
		if (time() - (st[DEV_ID] ?? 0) < 600) return;
