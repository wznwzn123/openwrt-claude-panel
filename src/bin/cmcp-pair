#!/bin/sh
# 托管版：拿一个配对码，把这台路由器绑定到官网账号（换手机时好找）
# 用法：cmcp-pair            在终端随时运行，配对码 10 分钟内有效
#       cmcp-pair --install  安装脚本最后自动调用（措辞略有不同）
D=/etc/claude-mcp
HUB=$(sed -n 's/^HUB=//p' $D/hub.conf 2>/dev/null)
SUB=$(sed -n 's/^SUB=//p' $D/hub.conf 2>/dev/null)
RKEY=$(sed -n 's/^RKEY=//p' $D/cloud.conf 2>/dev/null)
if [ -z "$HUB" ] || [ -z "$SUB" ] || [ -z "$RKEY" ]; then
	echo "这台路由器不是托管版，不能绑定到官网账号（自建版不需要绑定）。" >&2
	exit 1
fi
R=$(curl -s -m 20 -X POST -H 'Content-Type: application/json' -d "{\"sub\":\"$SUB\",\"rkey\":\"$RKEY\"}" "$HUB/api/pair/start" 2>/dev/null)
CODE=$(jsonfilter -s "$R" -e '@.code' 2>/dev/null)
if [ -z "$CODE" ]; then
	E=$(jsonfilter -s "$R" -e '@.error' 2>/dev/null)
	echo "拿配对码失败：${E:-连不上托管服务 $HUB}。稍后运行 cmcp-pair 再试，或者在面板「系统操作 → 绑定到账号」里拿。" >&2
	exit 1
fi
C1=$(echo "$CODE" | cut -c1-4); C2=$(echo "$CODE" | cut -c5-8)
echo
echo "==================== 配对码 ===================="
echo
echo "                    $C1  $C2"
echo
echo "================================================"
echo
if [ "$1" = "--install" ]; then
	echo "托管版为了安全，每台手机第一次打开面板要输一次「登录码」，登录码在官网账号里拿。"
	echo "所以先把路由器绑定到官网账号（10 分钟内做完）："
	echo
	echo "  ① 手机打开上面的「自动登录链接」，面板会提示输入登录码，先放着别关"
	echo "  ② 手机打开这个绑定链接，登录或注册官网账号，自动绑定："
	echo "       $HUB/app?pair=$CODE"
	echo "     （或者在 $HUB/app 的「添加路由器」里输入上面的配对码）"
	echo "  ③ 绑定好会自动显示登录码，点「打开面板」就自动填好了"
	echo
	echo "以前已经绑定过这台路由器的账号：不用再绑，直接在官网账号页这台路由器下面点「获取登录码」。"
	echo "配对码过期了：在这个终端运行 cmcp-pair 再拿一个。"
	echo "官网打不开、急着用：在这个终端运行 cmcp-logincode，拿一个应急登录码。"
else
	echo "手机打开这个链接，登录或注册官网账号，自动绑定："
	echo "  $HUB/app?pair=$CODE"
	echo "或者在 $HUB/app 的「添加路由器」里输入上面的配对码。10 分钟内有效。"
fi
