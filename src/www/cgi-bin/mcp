		if (ch || fresh) cmcp_writej(APP_SEEN, seen);
	}
	// 谁要用它（装着的包里，Depends 写了它的）
	let need = {};
	for (let x in L) for (let d in x.deps) { need[d] ??= []; push(need[d], x.name); }
	for (let x in L) { x.users = need[x.name] ?? []; delete x.deps; }
