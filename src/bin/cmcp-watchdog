#!/bin/sh
# 路由器看门狗：每 30 秒检查一次 宽带 / 外网 / DNS / 隧道 / 面板服务 / OpenClash，
# 出问题时自动修复，并把原因记到 /etc/claude-mcp/events.log（在闪存上，断电重启也不会丢）。
# 用法：cmcp-watchdog run | once | shutdown
# 测试用环境变量：FAKE_WAN/FAKE_GW/FAKE_NET/FAKE_DNS/FAKE_TPID/FAKE_READY/FAKE_PANEL/FAKE_CLASH/FAKE_TGONE，DRYRUN=1 不真的重启

D=${WD_DIR:-/etc/claude-mcp}
EV=$D/events.log
HB=$D/heartbeat
CS=$D/clean_shutdown
ST=${WD_STATE:-/tmp/cmcp_wd.state}
TL=/tmp/claude-mcp-tunnel.log
MAXL=400
INTERVAL=30
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH

now() { date +%s; }
# JSON 字符串转义（多行保留为 \n）
esc() { printf '%s' "$1" | tr '\t\r' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'BEGIN{ORS=""} {if (NR>1) print "\\n"; print}'; }
# ev 等级 类别 说明 [详情] [开始时间] [结束时间]
ev() {
	printf '{"t":%s,"lvl":"%s","kind":"%s","msg":"%s","detail":"%s","from":%s,"to":%s}\n' \
		"$(now)" "$1" "$2" "$(esc "$3")" "$(esc "$4")" "${5:-0}" "${6:-0}" >> "$EV"
	local n; n=$(wc -l < "$EV")
	[ "$n" -gt $((MAXL + 50)) ] && tail -n $MAXL "$EV" > "$EV.tmp" && mv "$EV.tmp" "$EV"
	logger -t cmcp-watchdog "[$2] $3"
	# 这几类问题路由器自己推送到手机（断网、隧道、断电由云端判断后推送）
	case "$2" in dns|clash|mem|kernel|panel|watchdog) [ "$1" != info ] && cloud_push "$1" "$2" "$3" "$4" ;; esac
}
# 死机前的线索：内存快用完、程序被系统杀掉、内核报错时，把当时的内存情况和最近的内核日志存到闪存
# （系统日志只在内存里，死机重启就没了）；开机后在「意外重启」那条记录里写出来。10 分钟最多存一次
CLUE=$D/crashclue.txt
clue() {
	[ "$DRYRUN" = 1 ] && return
	local t; t=$(now)
	[ $(( t - ${CLUE_T:-0} )) -lt 600 ] && return
	CLUE_T=$t
	{
		echo "$t $1"
		awk '/^MemAvailable/{a=$2}/^SUnreclaim/{u=$2}/^SwapTotal/{st=$2}/^SwapFree/{sf=$2}END{printf "当时的内存：可用 %dMB，内核占用 %dMB，交换区已用 %dMB\n", a/1024, u/1024, (st-sf)/1024}' /proc/meminfo
		echo "-- 内存占用最多的程序"
		top -bn1 2>/dev/null | sed -n '5,10p' | cut -c1-110
		echo "-- 最近的内核日志"
		dmesg 2>/dev/null | tail -n 30 | cut -c1-200
	} > "$CLUE.tmp" 2>/dev/null && mv -f "$CLUE.tmp" "$CLUE"
}
# 内核里这些字样说明出问题了（死机前常见的征兆）：驱动出错、要不到内存、卡住
KERR_RE='Oops|BUG:|WARNING:|Call trace|page allocation failure|Unable to handle|hung_task|blocked for more than|soft lockup|rcu.*stall|ath11k.*(crash|firmware crashed|failed to|timed out|timeout)|nss.*(fail|crash|timeout)'
# 推送到手机（后台发，不耽误检查）
cloud_push() {
	[ -f "$D/cloud.conf" ] && [ "$DRYRUN" != 1 ] || return 0
	local URL RKEY TKEY j
	. "$D/cloud.conf"
	j=$(printf '{"lvl":"%s","kind":"%s","title":"%s","body":"%s","tag":"%s"}' "$1" "$2" "$(esc "$3")" "$(esc "$4" | cut -c1-600)" "$2")
	( curl -s -m 20 -X POST -H 'Content-Type: application/json' -d "$j" "$URL/n/$RKEY" >/dev/null 2>&1 & )
}
fmt() { date -d "@$1" '+%m-%d %H:%M:%S' 2>/dev/null || echo "$1"; }
mins() { local s=$(( $2 - $1 )); [ $s -lt 60 ] && echo "${s} 秒" || echo "$(( (s + 30) / 60 )) 分钟"; }

# ---------- 探测 ----------
wan_json() { ubus call network.interface.wan status 2>/dev/null; }
p_wan() { [ -n "$FAKE_WAN" ] && { [ "$FAKE_WAN" = 1 ]; return; }; [ "$(wan_json | jsonfilter -e '@.up')" = "true" ]; }
gw() { wan_json | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop' 2>/dev/null | head -n1; }
p_gw() { [ -n "$FAKE_GW" ] && { [ "$FAKE_GW" = 1 ]; return; }; local g; g=$(gw); [ -z "$g" ] && return 0; ping -c1 -W2 "$g" >/dev/null 2>&1 || ping -c1 -W2 "$g" >/dev/null 2>&1; }
p_net() { [ -n "$FAKE_NET" ] && { [ "$FAKE_NET" = 1 ]; return; }; for h in 223.5.5.5 119.29.29.29 1.1.1.1; do ping -c1 -W2 $h >/dev/null 2>&1 && return 0; done; return 1; }
p_dns() { [ -n "$FAKE_DNS" ] && { [ "$FAKE_DNS" = 1 ]; return; }; timeout 6 nslookup www.baidu.com 127.0.0.1 2>/dev/null | grep -q '^Name:' || timeout 6 nslookup www.qq.com 127.0.0.1 2>/dev/null | grep -q '^Name:'; }
tpid() { [ -n "$FAKE_TPID" ] && { [ "$FAKE_TPID" = 0 ] || echo "$FAKE_TPID"; return; }; pidof cloudflared | awk '{print $1}'; }
ready() {
	[ -n "$FAKE_READY" ] && { echo "$FAKE_READY"; return; }
	local p r
	for p in 20241 20242 20243 20244 20245; do
		r=$(curl -s -m 2 "http://127.0.0.1:$p/ready" 2>/dev/null | jsonfilter -e '@.readyConnections' 2>/dev/null)
		[ -n "$r" ] && { echo "$r"; return; }
	done
	echo 0
}
p_panel() { [ -n "$FAKE_PANEL" ] && { [ "$FAKE_PANEL" = 1 ]; return; }; [ "$(curl -s -m 6 -o /dev/null -w '%{http_code}' http://127.0.0.1:18765/panel/manifest.json)" = 200 ]; }
cpid() { [ -n "$FAKE_CLASH" ] && { [ "$FAKE_CLASH" = 0 ] || echo "$FAKE_CLASH"; return; }; pidof clash mihomo 2>/dev/null | awk '{print $1}'; }
# 正在用的代理插件（OpenClash、Nikki、PassWall、PassWall2、HomeProxy、SSR Plus+ 都认）：
# PXID（编号）、PXNAME（名字）、PXEN（开着）、PXRUN（在跑）。在跑的优先，其次开着的
PXCMD=${PXCMD:-/usr/sbin/cmcp-proxy}
px_now() {
	PXID=; PXNAME=; PXEN=0; PXRUN=0
	local l id en run nm pick=
	l=$(sh "$PXCMD" list 2>/dev/null)
	[ -n "$l" ] || return 0
	pick=$(echo "$l" | awk '$3 == 1 { print; exit }'); [ -n "$pick" ] || pick=$(echo "$l" | awk '$2 == 1 { print; exit }'); [ -n "$pick" ] || pick=$(echo "$l" | head -n1)
	set -- $pick; PXID=$1; PXEN=$2; PXRUN=$3; shift 3; PXNAME="$*"
}
# 代理内核的进程号（OpenClash 是 clash，Nikki 是 mihomo）；别的插件没有单独的内核，在跑就记成 run
px_pid() {
	[ "$PXRUN" = 1 ] || return 0
	case "$PXID" in openclash|nikki) cpid ;; *) echo run ;; esac
}
pxlog() { [ "$PXID" = openclash ] && oclog "$1" || logread 2>/dev/null | grep -i "$PXID" | grep -v -E 'luci|uhttpd' | tail -n "${1:-6}" | cut -c1-200; }

# 隧道在 Cloudflare 上已经不存在了（被删除）/ 钥匙作废：重启隧道也没用。只看这次启动以后的日志，免得被以前的旧记录误判
tun_gone() {
	[ -n "$FAKE_TGONE" ] && { [ "$FAKE_TGONE" = 1 ]; return; }
	[ -f "$TL" ] || return 1
	tail -n 300 "$TL" | awk '/Starting tunnel|Starting metrics server/{buf=""} {buf=buf $0 "\n"} END{printf "%s", buf}' | grep -q -E 'Unauthorized: (Tunnel not found|Invalid tunnel secret)|Invalid tunnel token|tunnel credentials (file )?(doesn.t exist|are invalid)'
}
tunlog() {
	local l
	[ -f "$TL" ] && l=$(grep -v precheck "$TL" | grep -i -E '"level":"(error|warn)"|unregist|terminat|retry|fail' | grep -v -E 'ping_group|ICMP proxy|Group ID|config.yml was empty|fetch features|context canceled|ended abruptly' | tail -n 6 | cut -c1-300)
	[ -n "$l" ] && echo "隧道日志：
$l" || echo "隧道日志里没有错误记录"
}
wanlog() { logread 2>/dev/null | grep -E "netifd: .*(wan|Interface|link)|udhcpc|pppd|odhcp6c" | grep -v -i -E 'wifi|radio|phy[0-9]' | tail -n 6 | cut -c1-200; }
oclog() { grep -v '^time=' /tmp/openclash.log 2>/dev/null | tail -n "${1:-6}" | cut -c1-200; }
memavail() { [ -n "$FAKE_MEM" ] && { echo "$FAKE_MEM"; return; }; awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo; }
# 内存保护：可用内存连续两次低于 MEM_LOW（默认 30MB）时，先清缓存；清完还不够、OpenClash 在跑，就平稳重启 OpenClash
# 释放内存（会断网十几秒，比内存耗尽死机重启好得多）。重启 OpenClash 至少隔 30 分钟、一天最多 6 次。
# 不想要自动重启 OpenClash：touch /etc/claude-mcp/memguard.off（还会清缓存和提醒）
MEM_LOW=${MEM_LOW:-30}
drop_caches() { [ "$DRYRUN" = 1 ] && return; sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null; echo 1 > /proc/sys/vm/compact_memory 2>/dev/null; }
tb_on() { [ -n "$FAKE_TB" ] && { [ "$FAKE_TB" = 1 ]; return; }; [ -x /usr/sbin/cmcp-tunbypass ] && [ "$(/usr/sbin/cmcp-tunbypass status)" = 已开启 ]; }
tb_off() { [ -n "$FAKE_TB" ] && { FAKE_TB=0; return; }; [ "$DRYRUN" = 1 ] || /usr/sbin/cmcp-tunbypass off "自动：直连连不上" >/dev/null 2>&1; }
memtop() { top -bn1 2>/dev/null | sed -n '5,10p' | cut -c1-110; }
mem_guard() {
	local m=$1 t=$2 m2 day
	if [ "${m:-999}" -ge "$MEM_LOW" ]; then MLOW=0; return; fi
	MLOW=$((MLOW + 1))
	[ "$MLOW" -lt 2 ] && return
	# 清缓存：5 分钟最多一次
	[ $(( t - MD_T )) -lt 300 ] && return
	MD_T=$t
	# 自动处理里关掉了「内存快满时清理缓存」：不清缓存，直接看要不要重启代理插件
	if [ -f "$D/off.cacheclean" ]; then m2=$m; else drop_caches; m2=${FAKE_MEM2:-$(memavail)}; fi
	if [ "${m2:-0}" -ge "$MEM_LOW" ]; then
		# 清缓存就够了：半小时最多记一条，不推送
		[ $(( t - MDL_T )) -ge 1800 ] && { MDL_T=$t; ev info mem "内存只剩 ${m}MB，已自动清理缓存，现在可用 ${m2}MB" ""; }
		MLOW=0; return
	fi
	day=$(( (t + 28800) / 86400 )); [ "$MG_D" != "$day" ] && { MG_D=$day; MGN=0; }
	[ -n "$PXID" ] || px_now
	if [ -f "$D/memguard.off" ] || [ -z "$PXID" ] || [ "$PXEN" != 1 ] || [ "$PXRUN" != 1 ] || [ $(( t - MG_T )) -lt 1800 ] || [ "$MGN" -ge 6 ]; then return; fi
	MG_T=$t; MGN=$((MGN + 1)); clue "内存只剩 ${m2}MB，自动重启 $PXNAME 释放内存"
	if [ "$DRYRUN" = 1 ]; then ev warn mem "内存只剩 ${m2}MB（清理缓存后还是不够），已自动重启 $PXNAME 释放内存（测试模式，没有真的重启）" "$(memtop)"
	else
		ev warn mem "内存只剩 ${m2}MB（清理缓存后还是不够），已自动重启 $PXNAME 释放内存，会断网十几秒" "避免内存耗尽导致路由器死机重启。今天第 ${MGN} 次。
当时占内存最多的程序：
$(memtop)"
		( sh "$PXCMD" restart "$PXID" >/dev/null 2>&1 & )
	fi
	# 这次重启是自己做的，下一轮不再当成「代理插件重启了」另记一条
	CLASH_PID=; MLOW=0
}

# ---------- 状态 ----------
load() {
	WAN=ok; NET=ok; DNS=ok; TUN=ok; PANEL=ok; CLASH=ok; CLASH_PID=; TFAIL=0; PFAIL=0; DFAIL=0; CFAIL=0
	WAN_T=0; NET_T=0; DNS_T=0; TUN_T=0; CLASH_T=0; LAST_RS=0; RS_LIST=; RSN=0; TGONE=0; HB_T=0; BOOT_DONE=0; MEMW=0; TCAUSE=; BT0=; BEAT_T=0; OOMN=; ASW_T=0; KERRN=; CLUE_T=0; MLOW=0; MD_T=0; MDL_T=0; MG_T=0; MG_D=; MGN=0; TB_T=0
	[ -f "$ST" ] && . "$ST"
}
save() {
	cat > "$ST.tmp" <<EOF
WAN=$WAN; NET=$NET; DNS=$DNS; TUN=$TUN; PANEL=$PANEL; CLASH=$CLASH; CLASH_PID=$CLASH_PID
TFAIL=$TFAIL; PFAIL=$PFAIL; DFAIL=$DFAIL; CFAIL=$CFAIL
WAN_T=$WAN_T; NET_T=$NET_T; DNS_T=$DNS_T; TUN_T=$TUN_T; CLASH_T=$CLASH_T; LAST_RS=$LAST_RS; RSN=$RSN; TGONE=$TGONE; HB_T=$HB_T; BOOT_DONE=$BOOT_DONE; MEMW=$MEMW
TCAUSE="$TCAUSE"; BT0=$BT0; BEAT_T=$BEAT_T; OOMN=$OOMN; ASW_T=$ASW_T; KERRN=$KERRN; CLUE_T=$CLUE_T
MLOW=$MLOW; MD_T=$MD_T; MDL_T=$MDL_T; MG_T=$MG_T; MG_D=$MG_D; MGN=$MGN; TB_T=$TB_T
CHECK_T=$(now); READY=$RDY; TPID=$TP
EOF
	mv "$ST.tmp" "$ST"
}

# ---------- 开机：判断上次是怎么断的 ----------
boot_check() {
	[ "$BOOT_DONE" = 1 ] && return
	local up; up=${FAKE_UP:-$(cut -d. -f1 /proc/uptime)}
	if [ "$up" -gt 900 ]; then BOOT_DONE=1; return; fi
	# 路由器没有电池时钟：刚开机时系统时间停在断电前最后写文件的那一刻，联网对时后才跳到正确时间。
	# 所以要等对时成功（ntpd 通知，或发现系统时间被调过）再记，不然开机时间和断了多久都是错的
	local t bt last reason lvl detail note= ibt
	t=$(now); ibt=$(( t - up ))
	[ -z "$BT0" ] && BT0=$ibt
	if [ ! -f "${WD_NTP:-/tmp/cmcp_ntp_synced}" ] && [ $(( ibt - BT0 )) -lt 30 ] && [ $(( BT0 - ibt )) -lt 30 ]; then
		[ "$up" -lt 600 ] && return
		note="
（路由器一直没对上时间，以上时间可能不准）"
	fi
	[ "$NET" = ok ] || [ "$up" -gt 600 ] || return
	bt=$ibt; last=$(cut -d' ' -f1 "$HB" 2>/dev/null); local mem; mem=$(cut -s -d' ' -f2- "$HB" 2>/dev/null)
	if [ -f "$CS" ]; then
		reason="路由器重启了（正常重启：执行了重启命令或在网页上点了重启）"; lvl=info; last=$(cat "$CS"); rm -f "$CS"
	else
		reason="路由器意外重启：断电、拔了电源或系统死机（重启前没有正常关机）"; lvl=err
	fi
	[ -n "$last" ] && [ "$last" -lt "$bt" ] 2>/dev/null || last=$bt
	detail="开机时间 $(fmt $bt)"
	[ "$lvl" = err ] && detail="$detail
断电前最后一次正常运行记录 $(fmt $last)（每 5 分钟记一次，实际断电在这之后 5 分钟内）
从最后记录到开机共 $(mins $last $bt)"
	# 每 5 分钟那次记录里顺便记了内存：死机前内存很紧张的话，多半就是内存不够
	if [ "$lvl" = err ] && [ -n "$mem" ]; then
		set -- $mem
		detail="$detail
断电前最后一次记录的内存：可用 ${1}MB，内核占用 ${2}MB，交换区已用 ${3}MB"
		[ "${1:-999}" -lt 45 ] 2>/dev/null && detail="$detail（内存很紧张，很可能是内存不够导致死机）"
	fi
	detail="$detail$note"
	# 死机前存下来的线索（断电前 30 分钟以内的才算）
	if [ "$lvl" = err ] && [ -s "$CLUE" ]; then
		local ct cr; ct=$(head -n 1 "$CLUE" | cut -d' ' -f1); cr=$(head -n 1 "$CLUE" | cut -d' ' -f2-)
		if [ -n "$ct" ] && [ "$ct" -le "$bt" ] 2>/dev/null && [ $(( last - ct )) -lt 1800 ] 2>/dev/null; then
			detail="$detail
死机前 $(mins $ct $bt) 发现：$cr
$(grep -E "^当时的内存" "$CLUE")
$(grep -E "$KERR_RE|killed process|Out of memory" "$CLUE" | tail -n 8 | cut -c1-180)"
		fi
		mv -f "$CLUE" "$CLUE.prev"
	fi
	if ls /sys/fs/pstore/* >/dev/null 2>&1; then
		detail="$detail
发现内核崩溃日志：
$(cat /sys/fs/pstore/* 2>/dev/null | tail -n 12 | cut -c1-200)"
		reason="路由器死机后自动重启（内核崩溃）"
	fi
	ev "$lvl" boot "$reason" "$detail" "$last" "$bt"
	BOOT_DONE=1
}

restart_tunnel() {
	local t; t=$(now)
	# 隧道已经被删除（钥匙作废）：重启没用，只提醒一次怎么恢复
	if tun_gone; then
		if [ "$TGONE" != 1 ]; then
			TGONE=1
			if [ -s "$D/hub.conf" ]; then
				ev err watchdog "托管网址已被删除：Cloudflare 上找不到这台路由器的隧道，重启隧道也没用" "家里上网和路由器上的设置都不受影响。恢复方法：
① 联系提供服务的人：如果是 30 天内删的，他可以在管理页一键恢复，恢复后什么都不用做；
② 已经彻底删除了：找他要一个新的邀请码，手机连家里 Wi-Fi，打开路由器后台「服务 → 终端」，把安装命令再运行一次，加上 --invite 新邀请码（网址会换成新的，设置都保留）。
$(tunlog)"
			else
				ev err watchdog "隧道已被删除：Cloudflare 上找不到这条隧道（或者隧道 token 作废了），重启隧道也没用" "到 Cloudflare Zero Trust 重新建一条隧道，把新的 token 用安装脚本重新填一次。
$(tunlog)"
			fi
		fi
		return
	fi
	# 连续重启逐渐拉长间隔：第一次马上重启，之后隔 3、10、10、30、30 分钟，再往后每小时一次（不再每 3 分钟一直重启）
	local gap; case "$RSN" in 0|1) gap=180 ;; 2|3) gap=600 ;; 4|5) gap=1800 ;; *) gap=3600 ;; esac
	[ $(( t - LAST_RS )) -lt $gap ] && return
	RSN=$((RSN + 1)); LAST_RS=$t
	# 前 3 次每次记一笔；第 4 次说明「之后改成慢慢重试」；再往后不记（隧道恢复时会记总共断了多久）
	if [ "$RSN" -le 3 ]; then ev warn watchdog "已自动重启隧道（连续第 $RSN 次）$([ "$DRYRUN" = 1 ] && echo '，测试模式，没有真的重启')" ""
	elif [ "$RSN" -eq 4 ]; then ev err watchdog "隧道重启了 3 次还是连不上，之后改成每 30 分钟、每小时再试一次" "$(tunlog)"
	fi
	if [ "$DRYRUN" != 1 ] && [ -n "$TP" ]; then
		# 卡死的进程可能不理普通 kill，5 秒后还在就强制结束；procd 会自动重新拉起
		kill "$TP" 2>/dev/null
		local i=0; while [ $i -lt 5 ] && kill -0 "$TP" 2>/dev/null; do sleep 1; i=$((i + 1)); done
		kill -0 "$TP" 2>/dev/null && kill -9 "$TP" 2>/dev/null
	fi
}

# 公告即时送达（用户 11/27：后台发出、修改都要所有路由器马上收到）：
# 托管版每分钟的心跳回复里带着公告版本号；自建版（没有心跳）每 5 分钟问一下官网的版本号。跟上次不一样就马上取一次公告
# 测试用：WD_ANNV（记版本号的文件）、WD_ANNB（心跳上次带版本号的时间）、WD_ANN（取公告的程序）、WD_ANNURL（问版本号的地址）、WD_ANNTEST=1（DRYRUN 时也跑）
ANNV=${WD_ANNV:-/tmp/cmcp_ann.v}; ANNB=${WD_ANNB:-/tmp/cmcp_annv_beat}
ann_sync() {
	local v=$1 l=${WD_ANNV:-/tmp/cmcp_ann.v}.lock
	case "$v" in ''|*[!0-9.]*) return ;; esac
	[ "$v" = "$(cat "$ANNV" 2>/dev/null)" ] && return
	mkdir "$l" 2>/dev/null || { [ $(( $(date +%s) - $(stat -c %Y "$l" 2>/dev/null || echo 0) )) -lt 120 ] && return; }
	${WD_ANN:-/usr/sbin/cmcp-ann} now >/dev/null 2>&1 && echo "$v" > "$ANNV"
	rmdir "$l" 2>/dev/null
}
ann_poll() {
	[ "$DRYRUN" = 1 ] && [ "${WD_ANNTEST:-}" != 1 ] && return
	local b; b=$(cat "$ANNB" 2>/dev/null); case "$b" in ''|*[!0-9]*) b=0 ;; esac
	# 托管版刚启动、心跳还没带过版本号：先等心跳（5 分钟内没带，说明官网还是老的，再自己问）
	[ "$b" = 0 ] && [ -f "$D/cloud.conf" ] && { ANNB0=${ANNB0:-$t}; b=$ANNB0; }
	[ $(( t - b )) -lt 300 ] && return   # 心跳 5 分钟内带过版本号：不用自己问
	[ $(( t - ${ANNP_T:-0} )) -ge 300 ] || return
	ANNP_T=$t
	local h; h=$(sed -n 's/^HUB=//p' "$D/hub.conf" 2>/dev/null); h=${h:-https://yrlove520.com}
	( ann_sync "$(curl -s -m 10 "${WD_ANNURL:-$h/api/notices/v}" 2>/dev/null | jsonfilter -e '@.v' 2>/dev/null)" ) >/dev/null 2>&1 &
}

# 云端心跳：每分钟把状态报告给 Cloudflare（路由器断线时，面板还能从云端看到实时情况）
cloud_beat() {
	[ -f "$D/cloud.conf" ] || return
	[ $(( t - BEAT_T )) -ge 55 ] || return
	BEAT_T=$t
	local URL RKEY TKEY j
	. "$D/cloud.conf"
	# 6.0 第 94 项：ed = 托管版的哪个版本（ai / local / noai），lan = 家里局域网的面板地址（只有本地版报，官网「打开面板」要用）
	local ed="" lan="" lp lip
	if [ -s "$D/hub.conf" ]; then
		if [ -f "$D/local" ]; then ed=local; elif grep -q '"ai": *false' "$D/config.json" 2>/dev/null; then ed=noai; else ed=ai; fi
	fi
	lp=$(cat "$D/lan_port" 2>/dev/null); case "$lp" in ''|*[!0-9]*) lp=906 ;; esac
	lip=$(uci -q get network.lan.ipaddr 2>/dev/null); lip=${lip%% *}; lip=${lip%%/*}
	# 只有本地版报（官网「打开面板」要跳过去）；AI 版、自建版不报
	[ "$ed" = local ] && [ -n "$lip" ] && [ ! -f "$D/lan_off" ] && lan="$lip:$lp"
	# po = 最后有人用手机面板的时间（后台「打开面板 x 前」，用户 11/28）；hot = 装到第几个修复补丁（后台显示 V 编号）
	local po hot
	po=$(cat "${WD_POPEN:-/tmp/cmcp_popen}" 2>/dev/null | tr -dc '0-9'); hot=$(sed -n 's/^HOT=//p' $D/version 2>/dev/null | tr -dc '0-9')
	j=$(printf '{"wan":"%s","net":"%s","dns":"%s","tun":"%s","panel":"%s","clash":"%s","ready":%s,"up":%s,"mem":%s,"slab":%s,"tcause":"%s","ver":"%s","ed":"%s","lan":"%s","po":%s,"hot":%s}' \
		"$WAN" "$NET" "$DNS" "$TUN" "$PANEL" "$CLASH" "${RDY:-0}" "$(cut -d. -f1 /proc/uptime)" "$(memavail)" "$(awk '/SUnreclaim/{print int($2/1024)}' /proc/meminfo)" "$(esc "$TCAUSE")" "$(sed -n 's/^VER=//p' $D/version 2>/dev/null | tr -dc '0-9a-z.')" "$ed" "$lan" "${po:-0}" "${hot:-0}")
	# 官网让路由器换版本（主账号在官网「我的路由器」里点的）：心跳的回复里带着指令
	( r=$(curl -s -m 25 -X POST -H 'Content-Type: application/json' -d "$j" "$URL/beat/r/$RKEY" 2>/dev/null)
	  v=$(printf '%s' "$r" | jsonfilter -e '@.annv' 2>/dev/null); [ -n "$v" ] && { date +%s > "$ANNB"; ann_sync "$v"; }
	  case "$r" in *'"cmd"'*)
		id=$(printf '%s' "$r" | jsonfilter -e '@.cmd.id' 2>/dev/null | tr -cd 'a-z0-9'); to=$(printf '%s' "$r" | jsonfilter -e '@.cmd.to' 2>/dev/null)
		[ -n "$id" ] && [ -x /usr/sbin/cmcp-edition ] && /usr/sbin/cmcp-edition remote "$id" "$to" ;;
	  esac
	  # 后台把这台固定在某个补丁（按台退回，用户 11/28）：马上问一次
	  case "$r" in *'"hotc"'*) [ -x "${WD_HOT:-/usr/sbin/cmcp-hot}" ] && "${WD_HOT:-/usr/sbin/cmcp-hot}" check ;; esac ) >/dev/null 2>&1 &
}

# 一键更新正在装（15 分钟内的更新锁）：装的时候会重启面板服务和隧道，看门狗这时不去「修」，免得两边一起重启
updating() { local l=${WD_UPDLOCK:-/tmp/cmcp_update.lock}; [ -d "$l" ] && [ $(( $(date +%s) - $(stat -c %Y "$l" 2>/dev/null || echo 0) )) -lt 900 ]; }

# 面板刚改了网络设置、正在等你确认（90 秒，最多 3 分钟）：这段时间不去「修」网络，免得跟改动打架（风险 9）
netchg() { local f=${CMCP_NG:-/tmp/cmcp_netguard}/token; [ -f "$f" ] && [ -n "$(find "$f" -mmin -3 2>/dev/null)" ]; }

check() {
	mkdir /tmp/cmcp_wd.lock 2>/dev/null || return
	if netchg; then rmdir /tmp/cmcp_wd.lock; return; fi
	load
	local t; t=$(now)

	# 宽带 / 上级网络 / 外网 / DNS
	if p_wan; then
		if [ "$WAN" != ok ]; then ev ok wan "宽带恢复连接（断了 $(mins $WAN_T $t)）" "" "$WAN_T" "$t"; WAN=ok; fi
		if p_net; then
			if [ "$NET" != ok ]; then ev ok net "外网恢复（断了 $(mins $NET_T $t)）" "" "$NET_T" "$t"; NET=ok; fi
		else
			if [ "$NET" = ok ]; then
				NET=down; NET_T=$t
				if p_gw; then ev err net "宽带连着，但上不了外网（上级路由器或运营商没网）" "网关 $(gw) 能连上，但 223.5.5.5 / 119.29.29.29 / 1.1.1.1 都 ping 不通"
				else ev err net "连不上上级路由器 / 光猫（网关 $(gw) 没反应）" "$(wanlog)"; fi
			fi
		fi
	else
		NET=down
		if [ "$WAN" = ok ]; then WAN=down; WAN_T=$t; NET_T=$t; ev err wan "宽带断开（WAN 口没有连接）" "$(wanlog)"; fi
	fi
	if [ "$NET" = ok ]; then
		if p_dns; then
			if [ "$DNS" != ok ]; then ev ok dns "DNS 恢复正常（坏了 $(mins $DNS_T $t)）" "" "$DNS_T" "$t"; DNS=ok; fi; DFAIL=0
		else
			DFAIL=$((DFAIL + 1))
			if [ "$DNS" = ok ] && [ "$DFAIL" -ge 2 ]; then DNS=down; DNS_T=$t; ev err dns "DNS 解析失败：外网是通的，但域名解析不出来（代理插件或 dnsmasq 出了问题）" "$(logread 2>/dev/null | grep -E 'dnsmasq|openclash' | grep -v -E 'luci|dispatcher|uhttpd' | tail -n 5 | cut -c1-200)"; fi
		fi
	fi

	# 隧道（6.0 第 94 项：本地版没有隧道，不查）
	if [ -f "$D/local" ]; then TUN=ok; TFAIL=0; RDY=0
	else
		TP=$(tpid); RDY=$(ready)
		if [ -n "$TP" ] && [ "${RDY:-0}" -gt 0 ] 2>/dev/null; then
			if [ "$TUN" != ok ]; then ev ok tunnel "隧道恢复，面板和 AI 可以连上了（断了 $(mins $TUN_T $t)）" "原因：$TCAUSE$([ "$RSN" -gt 0 ] && echo "，期间自动重启了 $RSN 次隧道")" "$TUN_T" "$t"; TUN=ok; fi
			TFAIL=0; TCAUSE=; RSN=0; TGONE=0
		else
			TFAIL=$((TFAIL + 1))
			local cause det
			if [ "$WAN" != ok ]; then cause="宽带断开"
			elif [ "$NET" != ok ]; then cause="外网不通"
			elif [ -z "$TP" ] && [ -f /tmp/cmcp-cfd/fetching ]; then cause="正在把隧道程序下载到内存（小闪存模式，开机后要先下载）"
			elif [ -z "$TP" ]; then cause="隧道程序没在运行"
			else cause="隧道程序在运行，但连不上 Cloudflare"
			fi
			# 第 2 次检查还不行才算断（避免一瞬间的抖动）
			if [ "$TUN" = ok ] && [ "$TFAIL" -ge 2 ]; then
				TUN=down; TUN_T=$((t - INTERVAL)); TCAUSE=$cause
				case "$cause" in 宽带断开|外网不通) det="跟着$cause一起断的，网络恢复后隧道会自己连回来" ;; *) det=$(tunlog) ;; esac
				ev err tunnel "隧道断开：$cause（这段时间面板和 AI 都连不上路由器）" "$det"
			fi
			[ "$TUN" != ok ] && [ "$NET" = ok ] && [ "$TCAUSE" != "$cause" ] && TCAUSE="$TCAUSE → $cause"
			# 直连 Cloudflare 断了 15 分钟还连不上（外网是通的、隧道也没被删）：可能直连被挡了，改回走 OpenClash 代理
			if [ "$TUN" != ok ] && [ "$NET" = ok ] && [ "$TGONE" != 1 ] && [ $(( t - TUN_T )) -ge 900 ] && tb_on; then
				tb_off
				ev warn tunnel "隧道直连 Cloudflare 一直连不上，已改回走 OpenClash 代理" "直连断了 $(mins $TUN_T $t)，可能是网络屏蔽了直连。一天后会自动再试一次直连；想一直走代理：cmcp-tunbypass off
	$(tunlog)"
				LAST_RS=0; RSN=0
			fi
			# 外网是通的才重启隧道，断网时重启没用
			# 自动处理里关掉了「隧道断了自动重启」：只记录，不重启
			[ "$TFAIL" -ge 2 ] && [ "$NET" = ok ] && [ ! -f "$D/off.tunrestart" ] && ! updating && restart_tunnel
		fi

	fi

	# 面板服务
	if p_panel; then
		[ "$PANEL" != ok ] && ev ok panel "面板服务恢复" ""
		PANEL=ok; PFAIL=0
	else
		PFAIL=$((PFAIL + 1))
		if [ "$PFAIL" -ge 2 ] && [ "$PANEL" = ok ]; then
			PANEL=down
			if updating; then ev info panel "面板服务没响应：正在一键更新，等更新装完" ""
			elif [ -f "$D/off.panelrestart" ]; then ev err panel "面板服务没响应（自动重启已关掉，没有重启）" ""
			elif [ "$DRYRUN" = 1 ]; then ev err panel "面板服务没响应，已自动重启（测试模式，没有真的重启）" ""
			else /etc/init.d/claude-mcp restart >/dev/null 2>&1; ev err panel "面板服务没响应，已自动重启" ""; fi
		fi
	fi

	# 代理插件（OpenClash、Nikki、PassWall……正在用的那个）：开着却没在跑就记下来；内核进程号变了说明重启过
	px_now
	if [ -n "$PXID" ] && [ "$PXEN" = 1 ]; then
		local cp; cp=$(px_pid)
		if [ -n "$cp" ]; then
			if [ "$CLASH" != ok ]; then ev ok clash "$PXNAME 恢复运行（停了 $(mins $CLASH_T $t)）" "" "$CLASH_T" "$t"; CLASH=ok
			elif [ -n "$CLASH_PID" ] && [ "${CLASH_PID%%:*}" = "$PXID" ] && [ "$cp" != run ] && [ "$PXID:$cp" != "$CLASH_PID" ]; then ev info clash "$PXNAME 重启了（期间会断网十几秒）" "$(pxlog 6)"; fi
			CLASH_PID=$PXID:$cp; CFAIL=0
		else
			CFAIL=$((CFAIL + 1))
			if [ "$CLASH" = ok ] && [ "$CFAIL" -ge 3 ]; then CLASH=down; CLASH_T=$((t - 2 * INTERVAL)); ev err clash "$PXNAME 开着，但没在运行（要走代理的网站会打不开）" "$(pxlog 8)"; fi
		fi
	else
		CLASH=ok; CLASH_PID=
	fi

	# 内存
	local m; m=$(memavail)
	if [ "${m:-999}" -lt 25 ] && [ "$MEMW" = 0 ]; then MEMW=1; ev warn mem "内存快用完了（只剩 ${m}MB），可能导致程序被系统杀掉" "$(top -bn1 2>/dev/null | head -n 12 | cut -c1-120)"; clue "内存快用完了（只剩 ${m}MB）"; fi
	[ "${m:-999}" -gt 50 ] && MEMW=0
	mem_guard "$m" "$t"
	# 内存耗尽时内核会强行结束程序（OOM），记下来是谁被杀了
	local oom; oom=${FAKE_OOM:-$(dmesg 2>/dev/null | grep -c -i -E 'out of memory|oom-kill')}
	if [ -n "$OOMN" ] && [ "${oom:-0}" -gt "$OOMN" ]; then
		ev err mem "内存耗尽，系统强行结束了程序" "$(dmesg 2>/dev/null | grep -i -E 'killed process|out of memory' | tail -n 3 | cut -c1-200)"
		clue "内存耗尽，系统强行结束了程序"
	fi
	OOMN=${oom:-0}
	# 内核报错：记一条、推送到手机、存一份线索（开机时内核自己打出来的不算：第一次只记下有几条）
	local kc; kc=${FAKE_KERR:-$(dmesg 2>/dev/null | grep -c -E "$KERR_RE")}
	if [ -n "$KERRN" ] && [ "${kc:-0}" -gt "$KERRN" ]; then
		ev warn kernel "内核报错了（驱动出错或要不到内存，死机前常见的征兆）" "$(dmesg 2>/dev/null | grep -E "$KERR_RE" | tail -n 4 | cut -c1-200)"
		clue "内核报错"
	fi
	KERRN=${kc:-0}

	boot_check
	cloud_beat
	ann_poll
	# 每分钟：当前节点连不上就自动换；统计流量（后台跑，不耽误检查；家里断网或 OpenClash 没跑时不动）
	if [ $(( t - ASW_T )) -ge 55 ] && [ "$DRYRUN" != 1 ]; then
		ASW_T=$t
		[ "$NET" = ok ] && [ "$CLASH" = ok ] && [ -x /usr/sbin/cmcp-autosw ] && ( /usr/sbin/cmcp-autosw >/dev/null 2>&1 & )
		# 每台设备的流量统计 + 新设备连上时提醒：代理插件停了也跑（流量那部分问不到连接自己跳过；原来插件一停新设备提醒也停了，11/27 全面检查第 20 条）
		[ -x /usr/sbin/cmcp-traffic ] && ( /usr/sbin/cmcp-traffic >/dev/null 2>&1 & )
		# 安全和状态提醒、自动拉黑（6.0 第 3、4 项）：跟代理插件无关，一直跑
		[ -x /usr/sbin/cmcp-guard ] && ( /usr/sbin/cmcp-guard >/dev/null 2>&1 & )
		# 访客 Wi-Fi 到点自动关（6.0 第 15 项）
		[ -f /etc/claude-mcp/guest_until ] && [ -x /usr/sbin/cmcp-guest ] && ( /usr/sbin/cmcp-guest tick >/dev/null 2>&1 & )
	fi
	# 隧道直连 Cloudflare（不经过 OpenClash）：路由器重启后 /tmp 里的设置没了就补回来；自动关掉的过一天再试
	if [ $(( t - TB_T )) -ge 300 ] && [ "$DRYRUN" != 1 ] && [ -x /usr/sbin/cmcp-tunbypass ] && [ ! -f "$D/local" ]; then
		TB_T=$t
		case "$(/usr/sbin/cmcp-tunbypass check 2>/dev/null)" in *retry*) ev info tunnel "重新试一次隧道直连 Cloudflare（不经过 OpenClash）" "" ;; esac
	fi
	# 暂停上网：规则被防火墙重载冲掉了就补回来、到期自动恢复、每天定时断网开始时断开现有连接（用过这个功能才检查）
	[ "$DRYRUN" != 1 ] && [ -f "$D/pause.json" ] && [ -x /usr/sbin/cmcp-pause ] && /usr/sbin/cmcp-pause check >/dev/null 2>&1
	# 6.0 第 20 项：限速跟着设备的 IP 走；防火墙重载冲掉了就补上
	[ "$DRYRUN" != 1 ] && [ -f "$D/ratelimit.json" ] && [ -x /usr/sbin/cmcp-ratelimit ] && /usr/sbin/cmcp-ratelimit check >/dev/null 2>&1
	# 下面两项要问面板接口：登录密钥在 config.json（11/27：原来读的 token 文件新装的没有，换过登录密钥的是旧的）
	SPC=; { [ -f "$D/split.grp" ] || grep -qE '"(mac|ip)"' "$D/blacklist.json" 2>/dev/null; } && SPC=1
	TOK=; { [ -n "$SPC" ] || [ -f "$D/wg.json" ]; } && TOK=$(jsonfilter -i "$D/config.json" -e '@.token' 2>/dev/null)
	# 6.0 第 69 项：分流里选的策略组，订阅更新后没了就改走主策略组；自定义规则被整份改掉了，「不走代理」「分流」那几行补回去
	# （设了分流或者有「不走代理」的设备才查：11/27 全面检查第 13 条）
	if [ "$DRYRUN" != 1 ] && [ -n "$SPC" ] && [ -n "$TOK" ] && [ -s "$D/local.key" ] && [ $(( t - ${SP_T:-0} )) -ge 60 ]; then
		SP_T=$t
		curl -s -m 30 -H 'Content-Type: application/json' -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"panel/split_check\",\"params\":{},\"client\":\"panel\",\"dev\":\"local.$(cat "$D/local.key")\"}" "http://127.0.0.1:18765/cgi-bin/mcp/$TOK" >/dev/null 2>&1
	fi
	# 6.0 第 55 项：加密通道——家里 IP 变了更新官网给的地址；只通指定设备的，设备 IP 变了更新防火墙（每 5 分钟，用过才查）
	if [ "$DRYRUN" != 1 ] && [ -f "$D/wg.json" ] && [ -n "$TOK" ] && [ -s "$D/local.key" ] && [ $(( t - ${WG_T:-0} )) -ge 300 ]; then
		WG_T=$t
		curl -s -m 30 -H 'Content-Type: application/json' -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"panel/wg_check\",\"params\":{},\"client\":\"panel\",\"dev\":\"local.$(cat "$D/local.key")\"}" "http://127.0.0.1:18765/cgi-bin/mcp/$TOK" >/dev/null 2>&1
	fi
	# 心跳：每 5 分钟写一次闪存，用来判断断电时间（开机记录写完之前不能写，否则会盖掉断电前的最后记录）
	# 每 5 分钟记一次「还在正常运行」，顺便记下内存（可用、内核占用、交换区已用，单位 MB），意外重启后用来判断原因
	if [ "$BOOT_DONE" = 1 ] && [ $(( t - HB_T )) -ge 300 ]; then echo "$t $(awk '/^MemAvailable/{a=$2}/^SUnreclaim/{u=$2}/^SwapTotal/{st=$2}/^SwapFree/{sf=$2}END{printf "%d %d %d", a/1024, u/1024, (st-sf)/1024}' ${WD_MEMINFO:-/proc/meminfo} 2>/dev/null)" > "$HB"; HB_T=$t; fi
	save
	rmdir /tmp/cmcp_wd.lock
}

case "$1" in
	run)
		rmdir /tmp/cmcp_wd.lock 2>/dev/null
		load; [ -f "$EV" ] || ev info watchdog "看门狗已启动，开始记录断线原因" ""
		while true; do check; sleep $INTERVAL; done ;;
	once) check ;;
	shutdown)
		echo "$(now)" > "$CS"; now > "$HB"
		ev info reboot "路由器正在关机或重启（正常操作）" "" ;;
	*) echo "用法：$0 run | once | shutdown"; exit 1 ;;
esac
