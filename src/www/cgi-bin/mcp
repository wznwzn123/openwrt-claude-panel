P.ban_del = function(a) {
	let ip = '' + (a?.ip ?? '');
	if (!match(ip, /^[0-9a-fA-F.:]{3,39}$/)) die('地址不对');
	let r = sh(sprintf('%s/cmcp-guard unban %s', SBIN, shq(ip)));
	if (trim(r.out) != 'ok') die('解封失败：' + trim(r.out));
	return { ok: true };
};
P.luci_key = function() {
