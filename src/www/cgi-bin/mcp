		push(out, { id: s['.name'], mac, ip: s.ip ?? '', name: al[mac] ?? s.name ?? '', edit: length(macs) == 1 && v4int(s.ip ?? '') != null && !s.tag && !s.duid, black: s.cmcp_black == '1' });
	}
