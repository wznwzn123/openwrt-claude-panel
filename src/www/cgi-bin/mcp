		die('「' + name + '」是系统或面板自己要用的进程，结束它会断网或让面板失联，已拦下');
	let r = sh('kill ' + (a.force ? '-9 ' : '') + pid);
	if (r.code != 0) die(trim(r.out) || '结束失败');
	return { ok: true, name };
};

