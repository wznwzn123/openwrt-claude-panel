	if (!match(s, /^\[?[0-9A-Fa-f:]+\]?$/)) s = replace(s, /[\/:].*$/, ''); // 网址：只留主机名；IPv6 原样
	s = replace(s, /^\[(.*)\]$/, '$1');
	if (!match(s, /^[A-Za-z0-9][A-Za-z0-9.:-]{0,252}$/)) die('请输入域名或 IP，例如 www.baidu.com');
