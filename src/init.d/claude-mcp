#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance web
	procd_set_param command /usr/sbin/uhttpd -f -D -p 127.0.0.1:18765 -h /www-claude-mcp -x /cgi-bin -t 120 -T 120 -n 4
	procd_set_param respawn
	procd_close_instance

	rm -f /tmp/claude-mcp-tunnel.log
	procd_open_instance tunnel
	if [ -s /etc/claude-mcp/tunnel_token ]; then
		procd_set_param command /usr/bin/cloudflared tunnel --no-autoupdate --protocol http2 --logfile /tmp/claude-mcp-tunnel.log run --token "$(cat /etc/claude-mcp/tunnel_token)"
	else
		procd_set_param command /usr/bin/cloudflared tunnel --no-autoupdate --protocol http2 --logfile /tmp/claude-mcp-tunnel.log --url http://127.0.0.1:18765
	fi
	procd_set_param respawn 3600 10 0
	procd_close_instance
}
