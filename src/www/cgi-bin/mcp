P.dashboard = function(a) {
	const NAMES = { Dashboard: 1, Yacd: 1, Metacubexd: 1, Zashboard: 1 };
	if (!NAMES[a.name]) die('未知面板：' + a.name);
	let c = ucur();
	if (a.op == 'default') {
